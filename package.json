{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "rg-adguard-links",
  "title": "RG Adguard Links",
  "version": "1.0.0",
  "description": "Generate direct download links from store.rg-adguard.net for Microsoft Store apps.",
  "icon": "extension-icon.png",
  "author": "Gunk",
  "license": "MIT",
  "categories": [
    "Developer Tools"
  ],
  "commands": [
    {
      "name": "lookup",
      "title": "Get Download Links",
      "description": "Generate download links for Microsoft Store apps using RG Adguard.",
      "mode": "view",
      "icon": "command-icon.png",
      "path": "src/lookup.tsx"
    }
  ],
  "scripts": {
    "dev": "ray develop",
    "build": "ray build -e dist --skip-types",
    "lint": "ray lint"
  },
  "dependencies": {
    "@raycast/api": "^1.82.0",
    "@types/cheerio": "^0.22.35",
    "cheerio": "^1.1.2"
  },
  "devDependencies": {
    "@raycast/utils": "^1.10.0",
    "@types/node": "20.8.10",
    "@types/react": "18.0.9",
    "typescript": "^5.2.2"
  }
}
