{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "bilingual-formatter",
  "title": "Bilingual Formatter",
  "description": "自动纠正中英混合排版的文字（包含 Markdown 代码）",
  "version": "1.0.0",
  "license": "MIT",
  "author": "hanjian_wu",
  "categories": [
    "Productivity",
    "Developer Tools"
  ],
  "icon": "icon.png",
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish",
    "test": "vitest run"
  },
  "dependencies": {
    "@raycast/api": "^1.76.1"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.10",
    "@types/node": "20.12.12",
    "@types/react": "^19.2.7",
    "eslint": "^8.57.1",
    "pureimage": "^0.4.18",
    "sharp": "^0.34.5",
    "typescript": "^5.4.5",
    "vitest": "^4.0.16"
  },
  "commands": [
    {
      "name": "format-clipboard",
      "title": "Format Clipboard",
      "description": "格式化剪贴板内容并复制回剪贴板",
      "mode": "no-view",
      "filename": "src/format-clipboard.ts"
    },
    {
      "name": "format-and-paste",
      "title": "Format and Paste",
      "description": "格式化剪贴板内容并粘贴到当前应用",
      "mode": "no-view",
      "filename": "src/format-and-paste.ts"
    },
    {
      "name": "format-text",
      "title": "Format Text",
      "description": "输入文本并自动进行中英文排版格式化",
      "mode": "view",
      "filename": "src/format-text.tsx"
    }
  ]
}
