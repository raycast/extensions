{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "farrago",
  "title": "Farrago",
  "description": "",
  "icon": "extension-icon.png",
  "author": "boris_adaev",
  "license": "MIT",
  "commands": [],
  "preferences": [
    {
      "name": "farragoDataDir",
      "type": "textfield",
      "title": "Farrago Data Directory",
      "default": "~/Library/Application Support/Farrago 2",
      "placeholder": "~/Library/Application Support/Farrago 2",
      "description": "Path to Farrago's data directory",
      "required": false
    },
    {
      "name": "oscHost",
      "type": "textfield",
      "title": "OSC Host",
      "default": "localhost",
      "placeholder": "localhost",
      "description": "OSC host set up in Farrago",
      "required": true
    },
    {
      "name": "oscPort",
      "type": "textfield",
      "title": "Farrago Port",
      "default": "8090",
      "placeholder": "53000",
      "description": "Farrago's OSC port",
      "required": true
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.102.7",
    "@raycast/utils": "^1.17.0",
    "node-osc": "^11.0.0",
    "plist": "^3.1.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.4",
    "@types/node": "22.13.10",
    "@types/node-osc": "^9.1.0",
    "@types/plist": "^3.0.5",
    "@types/react": "19.0.10",
    "@types/xml2js": "^0.4.14",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "prepublishOnly": "echo \"\\n\\nIt seems like you are trying to publish the Raycast extension to npm.\\n\\nIf you did intend to publish it to npm, remove the \\`prepublishOnly\\` script and rerun \\`npm publish\\` again.\\nIf you wanted to publish it to the Raycast Store instead, use \\`npm run publish\\` instead.\\n\\n\" && exit 1",
    "publish": "npx @raycast/api@latest publish"
  }
}
