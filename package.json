{
  "name": "string-formatter",
  "title": "String Formatter",
  "description": "Format strings with custom separators and decorators",
  "icon": "command-icon.png",
  "author": "matrixwei",
  "categories": [
    "Developer Tools"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "format-string",
      "title": "Format String",
      "description": "Format strings with custom separators and decorators",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "language",
      "type": "dropdown",
      "title": "Language / 语言",
      "description": "Choose your preferred language / 选择您的首选语言",
      "required": false,
      "default": "zh",
      "data": [
        {
          "title": "中文 (Chinese)",
          "value": "zh"
        },
        {
          "title": "English",
          "value": "en"
        }
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.62.0",
    "@raycast/utils": "^1.10.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "1.0.6",
    "@types/node": "18.8.3",
    "@types/react": "18.0.9",
    "eslint": "^8.51.0",
    "prettier": "^3.0.0",
    "typescript": "^5.2.2"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}