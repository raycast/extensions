{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "control-brightness",
  "title": "Control Brightness",
  "description": "Control macOS display brightness with simple commands",
  "icon": "icon.png",
  "author": "pavzagor",
  "categories": [
    "System"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "set-brightness",
      "title": "Set Brightness",
      "description": "Set display brightness (shows current value)",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.86.2",
    "@raycast/utils": "^1.17.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.11",
    "@types/node": "^20.8.10",
    "@types/react": "^19.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "ray publish"
  },
  "platforms": ["macOS"]
}
