{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "mouse-jiggle",
  "title": "Mouse Jiggle",
  "description": "Move the mouse cursor randomly to prevent sleep or keep status active",
  "icon": "icon.png",
  "categories": [
    "System"
  ],
  "version": "1.0.0",
  "author": "stevefrost",
  "license": "MIT",
  "platforms": [
    "macOS"
  ],
  "commands": [
    {
      "name": "jiggle",
      "title": "Jiggle Mouse",
      "description": "Move the mouse cursor randomly to prevent sleep",
      "mode": "no-view",
      "arguments": [
        {
          "name": "intensity",
          "placeholder": "Intensity (5-20, default 10)",
          "type": "text",
          "required": false
        }
      ]
    }
  ],
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "lint": "ray lint",
    "fix-lint": "ray lint --fix",
    "publish": "npx @raycast/api@latest publish"
  },
  "dependencies": {
    "@raycast/api": "^1.91.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.1.1",
    "@types/node": "^22.0.0",
    "eslint": "^9.22.0",
    "prettier": "^3.8.3",
    "typescript": "^5.8.2"
  }
}
