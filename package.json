{
  "$schema": "https://www.raycast.com/schemas/extension",
  "name": "site-blocker",
  "title": "SiteBlocker",
  "description": "Block distracting websites quickly and easily",
  "icon": "assets/icon.png",
  "author": "ahmadbulbul",
  "categories": [
    "Productivity"
  ],
  "license": "MIT",
  "version": "1.0.0",
  "scripts": {
    "build": "npx tsc",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "publish": "npx @raycast/api@latest publish"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/test"
    ],
    "testMatch": [
      "**/__tests__/**/*.ts",
      "**/?(*.)+(spec|test).ts"
    ]
  },
  "dependencies": {
    "@raycast/api": "^1.103.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.6.2",
    "@types/react": "^19.2.0",
    "eslint": "^9.37.0",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.4",
    "typescript": "^5.9.3"
  }
}
