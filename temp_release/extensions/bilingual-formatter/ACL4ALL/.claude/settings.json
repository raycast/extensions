{
  "permissions": {
    "defaultMode": "default",

    "allow": [
      "Bash(git status)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(node scripts/list2yaml.js)",
      "Read(**)",
      "Grep",
      "Glob"
    ],

    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Edit(**)",
      "Write",
      "WebFetch",
      "WebSearch"
    ],

    "deny": [
      "Bash(rm -rf:*)",
      "Bash(curl:*)",
      "Read(.env)",
      "Read(.env.*)"
    ]
  }
}
