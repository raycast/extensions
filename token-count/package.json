{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "token-count",
  "title": "TokenCount: AI Context & Rules",
  "description": "Semantic code dehydration and .cursorrules generator.",
  "icon": "icon.png",
  "author": "justinxai",
  "categories": [
    "Developer Tools",
    "Productivity"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "index",
      "title": "Dehydrate for AI",
      "subtitle": "TokenCount",
      "description": "Slashing tokens by 90%",
      "icon": "icon.png",
      "mode": "view"
    },
    {
      "name": "generate-rules",
      "title": "Generate Cursor Rules",
      "subtitle": "TokenCount",
      "description": "Create .cursorrules from code",
      "icon": "icon.png",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.75.0"
  },
  "devDependencies": {
    "@raycast/utils": "^1.14.0",
    "@types/node": "20.8.10",
    "@types/react": "18.2.27",
    "typescript": "^5.2.2"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}
