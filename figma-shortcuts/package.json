{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "figma-shortcuts",
  "title": "Figma Shortcuts",
  "description": "Search and copy Figma keyboard shortcuts for macOS, Windows, or Linux",
  "icon": "command-icon.png",
  "author": "arturdz",
  "platforms": ["macOS"],
  "categories": ["Design Tools", "Productivity"],
  "license": "MIT",
  "commands": [
    {
      "name": "search-shortcuts",
      "title": "Search Figma Shortcuts",
      "description": "Search Figma keyboard shortcuts and copy them to the clipboard",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "platform",
      "type": "dropdown",
      "title": "Platform",
      "description": "Which OS shortcut format to display and copy",
      "data": [
        { "value": "mac", "title": "macOS" },
        { "value": "windows", "title": "Windows" },
        { "value": "linux", "title": "Linux" }
      ],
      "default": "mac",
      "required": false
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.83.1"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.11",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}
