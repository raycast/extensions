{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "hubstaff",
  "title": "Hubstaff",
  "description": "Toggle Hubstaff timer and switch between projects",
  "icon": "icon.png",
  "author": "stefan2142",
  "categories": [
    "Productivity"
  ],
  "license": "MIT",
  "preferences": [
    {
      "name": "cliPath",
      "title": "Hubstaff CLI Path",
      "description": "Path to the HubstaffCLI executable",
      "type": "textfield",
      "default": "/Applications/Hubstaff.app/Contents/MacOS/HubstaffCLI",
      "required": false
    }
  ],
  "commands": [
    {
      "name": "toggle-hubstaff",
      "title": "Toggle Hubstaff",
      "description": "Quick start or stop Hubstaff timer",
      "mode": "no-view"
    },
    {
      "name": "manage-hubstaff",
      "title": "Hubstaff Projects",
      "description": "Pick a project and start tracking time",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.87.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.1.1",
    "@types/node": "22.13.4",
    "eslint": "^9.17.0",
    "prettier": "^3.8.1",
    "typescript": "^5.7.3"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "prepublishOnly": "echo \"Error: no publish\" && exit 1",
    "publish": "npx @raycast/api@latest publish"
  }
}
