{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "gif-markdown",
  "title": "GIF Markdown",
  "description": "Search Giphy and paste GIF markdown into any text input",
  "icon": "extension-icon.png",
  "author": "agustinfranchetti",
  "categories": [
    "Developer Tools",
    "Productivity"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "search-gif",
      "title": "Search Giphy",
      "description": "Search Giphy and paste GIF markdown syntax into the active input",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "giphyApiKey",
      "title": "Giphy API Key",
      "description": "Your Giphy API key. Get one free at developers.giphy.com",
      "type": "password",
      "required": true
    },
    {
      "name": "markdownStyle",
      "title": "Markdown Style",
      "description": "How to insert the GIF",
      "type": "dropdown",
      "required": false,
      "default": "image",
      "data": [
        {
          "title": "Image ![alt](url)",
          "value": "image"
        },
        {
          "title": "HTML <img> tag (with width)",
          "value": "html"
        },
        {
          "title": "URL only",
          "value": "url"
        }
      ]
    },
    {
      "name": "htmlWidth",
      "title": "HTML Image Width",
      "description": "Width for <img> tags (e.g. 400). Only used when Markdown Style is HTML.",
      "type": "textfield",
      "required": false,
      "default": "400"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.8",
    "@raycast/utils": "^2.2.3"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.8",
    "@types/node": "20.8.10",
    "@types/react": "^19.2.14",
    "eslint": "^8.51.0",
    "prettier": "^3.0.3",
    "typescript": "^5.2.2"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}
