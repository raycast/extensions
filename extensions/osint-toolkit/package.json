{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "osint-toolkit",
  "title": "OSINT Toolkit",
  "description": "Comprehensive OSINT toolkit for security analysts to research IOCs (IPs, domains, URLs, hashes) across multiple threat intelligence platforms",
  "icon": "icon.png",
  "author": "jergensturdley",
  "license": "MIT",
  "platforms": [
    "macOS",
    "Windows"
  ],
  "commands": [
    {
      "name": "search-ioc",
      "title": "Search IOC",
      "subtitle": "OSINT Toolkit",
      "description": "Auto-detect and search any IOC (IP, domain, URL, hash) across OSINT platforms",
      "mode": "view",
      "arguments": [
        {
          "name": "ioc",
          "placeholder": "Enter IP, domain, URL, or hash",
          "type": "text",
          "required": false
        }
      ]
    }
  ],
  "preferences": [
    {
      "name": "enable_virustotal",
      "title": "Enable VirusTotal",
      "description": "Show VirusTotal in search results",
      "type": "checkbox",
      "default": true,
      "required": false,
      "label": "Enabled"
    },
    {
      "name": "enable_alienvault",
      "title": "Enable AlienVault OTX",
      "description": "Show AlienVault OTX in search results",
      "type": "checkbox",
      "default": true,
      "required": false,
      "label": "Enabled"
    },
    {
      "name": "enable_pulsedive",
      "title": "Enable Pulsedive",
      "description": "Show Pulsedive in search results",
      "type": "checkbox",
      "default": true,
      "required": false,
      "label": "Enabled"
    },
    {
      "name": "enable_opentip",
      "title": "Enable Kaspersky OpenTIP",
      "description": "Show Kaspersky OpenTIP in search results",
      "type": "checkbox",
      "default": true,
      "required": false,
      "label": "Enabled"
    },
    {
      "name": "enable_abuseipdb",
      "title": "Enable AbuseIPDB",
      "description": "Show AbuseIPDB in search results",
      "type": "checkbox",
      "default": true,
      "required": false,
      "label": "Enabled"
    },
    {
      "name": "enable_shodan",
