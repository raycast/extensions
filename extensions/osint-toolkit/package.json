  "dependencies": {
    "@raycast/api": "^1.69.0",
    "@raycast/utils": "^2.2.2"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.6",
    "@types/node": "20.8.10",
    "@types/react": "^19.0.1",
    "eslint": "^8.51.0",
    "prettier": "^3.0.3",
    "typescript": "^5.2.2"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  },
  "categories": [
    "Security",
    "Developer Tools"
  ],
  "keywords": [
    "osint",
    "security",
    "threat intelligence",
    "ioc",
    "virustotal",
    "shodan",
    "malware analysis",
    "cybersecurity",
    "ip lookup",
    "domain lookup",
    "hash lookup"
  ]
}
