{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "nterm-calculator",
  "title": "N-Term Grade Calculator",
  "description": "Calculate Dutch exam grades with the official N-term (CvTE) formula.",
  "icon": "extension-icon.png",
  "author": "maarten_boelens",
  "categories": [
    "Productivity"
  ],
  "license": "MIT",
  "platforms": [
    "macOS",
    "Windows"
  ],
  "keywords": [
    "n-term",
    "exam",
    "grade",
    "cvte",
    "dutch"
  ],
  "commands": [
    {
      "name": "nterm-calculator",
      "title": "N-Term Grade Calculator",
      "description": "Calculate Dutch exam grades with the official N-term (CvTE) formula.",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.19"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "^22.19.17",
    "@types/react": "^19.2.17",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "typescript": "^5.8.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  },
  "type": "module"
}
