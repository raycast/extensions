    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.19"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@raycast/utils": "^1.19.1",
    "@types/node": "^22.19.17",
    "@types/react": "^19.2.17",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "typescript": "^5.8.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  },
  "type": "module"
}
