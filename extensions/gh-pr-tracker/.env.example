# Copy to `.env` and fill in. Used ONLY by `npm run generate` to introspect the GitHub
# GraphQL schema at build time — it is never bundled into the extension or shipped to users.
#
# Needs a classic PAT (or fine-grained token) with `repo` read access.
# Create one at https://github.com/settings/tokens
#
# `.env` is gitignored. Never commit a real token.
GITHUB_TOKEN=ghp_your_token_here
