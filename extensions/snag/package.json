{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "snag",
  "title": "Snag",
  "description": "Search 7TV emotes and paste them straight into the frontmost app.",
  "icon": "icon.png",
  "author": "nakama",
  "categories": [
    "Communication",
    "Fun"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "snag",
      "title": "Snag Emote",
      "subtitle": "7TV",
      "description": "Search 7TV emotes and paste one into the frontmost app.",
      "mode": "view"
    }
  ],
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "lint": "ray lint",
    "fix-lint": "ray lint --fix",
    "test": "node --test src/*.test.ts",
    "publish": "npx @raycast/api@latest publish"
  },
  "dependencies": {
    "@raycast/api": "^2.1.3",
    "@raycast/utils": "^2.3.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
