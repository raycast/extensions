node_modules/
dist/
raycast-env.d.ts
.DS_Store

# e2e fixture vault: keep only the fixture, not Obsidian's state or plugin code
e2e-vault/.obsidian/*
!e2e-vault/.obsidian/community-plugins.json
!e2e-vault/.obsidian/plugins/
e2e-vault/.obsidian/plugins/*
!e2e-vault/.obsidian/plugins/quickadd/
e2e-vault/.obsidian/plugins/quickadd/*
!e2e-vault/.obsidian/plugins/quickadd/data.json

# demo vault (for screenshots): same rules as the e2e vault
demo-vault/.obsidian/*
!demo-vault/.obsidian/community-plugins.json
!demo-vault/.obsidian/plugins/
demo-vault/.obsidian/plugins/*
!demo-vault/.obsidian/plugins/quickadd/
demo-vault/.obsidian/plugins/quickadd/*
!demo-vault/.obsidian/plugins/quickadd/data.json
