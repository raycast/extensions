{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "port-manager",
  "title": "Port Manager",
  "description": "Find open ports and close them",
  "categories": [
    "Developer Tools",
    "Productivity",
    "System"
  ],
  "icon": "command-icon.png",
  "author": "lucaschultz",
  "contributors": [
    "Sheraff",
    "ridemountainpig",
    "pernielsentikaer",
    "0xdhrv"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "kill-listening-process",
      "title": "Kill Process Listening on",
      "description": "Kill the process listening on a given port",
      "mode": "no-view",
      "arguments": [
        {
          "name": "port",
          "placeholder": "Port",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "name": "named-ports",
      "title": "Named Ports",
      "description": "Name ports to make them easier to find in the open port list",
      "mode": "view"
    },
    {
      "name": "open-ports",
      "title": "Open Ports",
      "description": "Show and Close Opened Ports",
      "mode": "view",
      "preferences": [
        {
          "name": "primaryPortAction",
          "type": "dropdown",
          "default": "kill",
          "required": false,
          "data": [
            {
              "title": "Kill",
              "value": "kill"
            },
            {
              "title": "Kill All",
              "value": "killAll"
            },
            {
              "title": "Kill Parent",
              "value": "killParent"
            },
            {
              "title": "Show Details",
              "value": "showDetails"
            },
            {
              "title": "Show in Finder",
              "value": "showInFinder"
            },
            {
              "title": "Copy Info",
              "value": "copyInfo"
            },
            {
              "title": "Copy Commands",
              "value": "copyCommands"
            },
            {
              "title": "Reload",
              "value": "reload"
            }
          ],
          "title": "Primary Port Action",
          "description": "Choose which action to perform when selecting an port."
        }
      ]
    },
    {
      "name": "open-ports-menu-bar",
      "title": "Open Ports in Menu Bar",
      "description": "List open ports in menu bar",
      "mode": "menu-bar",
      "icon": "command-icon.png",
      "interval": "1m"
    }
  ],
  "preferences": [
    {
      "name": "killSignal",
      "description": "The signal used to kill the process on macOS. Windows always terminates with taskkill.",
      "type": "dropdown",
      "required": false,
      "default": "ask",
      "title": "Kill Signal",
      "data": [
        {
          "title": "Ask before each kill",
          "value": "ask"
        },
        {
          "title": "Always use SIGTERM",
          "value": "15"
        },
        {
          "title": "Always use SIGKILL",
          "value": "9"
        }
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.24",
    "@raycast/utils": "^2.3.0",
    "nanoid": "^6.0.1"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "typescript": "^5.8.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  },
  "platforms": [
    "macOS",
    "Windows"
  ]
}
