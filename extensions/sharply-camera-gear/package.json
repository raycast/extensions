{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "sharply-camera-gear",
  "title": "Sharply Gear Search",
  "description": "Find photography gear and open its Sharply page.",
  "icon": "extension-icon.png",
  "author": "flohhhhh",
  "license": "MIT",
  "keywords": [
    "camera",
    "lens",
    "photography",
    "gear",
    "used prices"
  ],
  "categories": [
    "Productivity",
    "Web"
  ],
  "commands": [
    {
      "name": "search-gear",
      "title": "Search Gear",
      "subtitle": "Sharply",
      "description": "Search cameras and lenses on Sharply and open their pages.",
      "mode": "view"
    }
  ],
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "lint": "ray lint",
    "fix-lint": "ray lint --fix",
    "typecheck": "tsc --noEmit",
    "publish": "npx @raycast/api@latest publish"
  },
  "dependencies": {
    "@raycast/api": "^2.9.0",
    "@raycast/utils": "^2.3.3"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.8.0"
  },
  "platforms": [
    "macOS"
  ],
  "preferences": [
    {
      "name": "priceMarket",
      "title": "Price Market",
      "description": "Choose US (USD), UK (GBP), or EU (EUR). Only estimates from the selected market are shown.",
      "type": "dropdown",
      "required": false,
      "default": "US",
      "data": [
        {
          "title": "US (USD)",
          "value": "US"
        },
        {
          "title": "UK (GBP)",
          "value": "UK"
        },
        {
          "title": "EU (EUR)",
          "value": "EU"
        }
      ]
    }
  ]
}
