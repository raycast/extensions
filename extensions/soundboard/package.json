{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "soundboard",
  "title": "Soundboard",
  "description": "Use Raycast as a soundboard and bind sounds to hotkeys",
  "icon": "command-icon.png",
  "author": "pernielsentikaer",
  "contributors": [
    "andreaselia",
    "anh_nguyen",
    "jor",
    "n0kovo",
    "muhammadrizo"
  ],
  "categories": [
    "Fun"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "index",
      "title": "Sounds",
      "subtitle": "Soundboard",
      "description": "Use Raycast as a soundboard",
      "mode": "view"
    },
    {
      "name": "favorite1",
      "title": "Play Favourite 1",
      "description": "Plays favourite 1",
      "mode": "no-view",
      "subtitle": "Soundboard"
    },
    {
      "name": "favorite2",
      "title": "Play Favourite 2",
      "description": "Plays favourite 2",
      "mode": "no-view",
      "subtitle": "Soundboard"
    },
    {
      "name": "favorite3",
      "title": "Play Favourite 3",
      "description": "Plays favourite 3",
      "mode": "no-view",
      "subtitle": "Soundboard"
    },
    {
      "name": "favorite4",
      "title": "Play Favourite 4",
      "description": "Plays favourite 4",
      "mode": "no-view",
      "subtitle": "Soundboard"
    },
    {
      "name": "favorite5",
      "title": "Play Favourite 5",
      "description": "Plays favourite 5",
      "mode": "no-view",
      "subtitle": "Soundboard"
    },
    {
      "name": "favorite6",
      "title": "Play Favourite 6",
      "description": "Plays favourite 6",
      "mode": "no-view",
      "subtitle": "Soundboard"
    },
    {
      "name": "favorite7",
      "title": "Play Favourite 7",
      "description": "Plays favourite 7",
      "mode": "no-view",
      "subtitle": "Soundboard"
    },
    {
      "name": "favorite8",
      "title": "Play Favourite 8",
      "description": "Plays favourite 8",
      "mode": "no-view",
      "subtitle": "Soundboard"
    },
    {
      "name": "favorite9",
      "title": "Play Favourite 9",
      "description": "Plays favourite 9",
      "mode": "no-view",
      "subtitle": "Soundboard"
    },
    {
      "name": "favorite10",
      "title": "Play Favourite 10",
      "description": "Plays favourite 10",
      "mode": "no-view",
      "subtitle": "Soundboard"
    }
  ],
  "preferences": [
    {
      "name": "closeOnTrigger",
      "title": "Close On Trigger",
      "description": "Close the Raycast window after triggering a sound",
      "type": "checkbox",
      "label": "Close window after sound is triggered",
      "required": false,
      "default": false
    },
    {
      "type": "dropdown",
      "name": "layout",
      "label": "Layout",
      "title": "Layout",
      "description": "The layout for displaying the sounds",
      "required": false,
      "default": "list",
      "data": [
        {
          "title": "List",
          "value": "list"
        },
        {
          "title": "Grid",
          "value": "grid"
        }
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.24",
    "@raycast/utils": "^2.3.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^6.0.0"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "prepublishOnly": "echo \"\\n\\nIt seems like you are trying to publish the Raycast extension to npm.\\n\\nIf you did intend to publish it to npm, remove the \\`prepublishOnly\\` script and rerun \\`npm publish\\` again.\\nIf you wanted to publish it to the Raycast Store instead, use \\`npm run publish\\` instead.\\n\\n\" && exit 1",
    "publish": "ray publish"
  },
  "platforms": [
    "macOS",
    "Windows"
  ],
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}
