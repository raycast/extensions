{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "binge-clock",
  "title": "Binge Clock",
  "description": "Find out how long it takes to watch every episode in a TV series or every movie in a marathon.",
  "icon": "command-icon.png",
  "author": "Aayush9029",
  "contributors": [
    "muhammadrizo"
  ],
  "platforms": [
    "macOS",
    "Windows"
  ],
  "categories": [
    "Other"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "calculate-time",
      "title": "Total Binge Time",
      "subtitle": "Binge Clock",
      "description": "Given a movie / tv series name find the total cumulative run time.",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^2.8.0",
    "@raycast/utils": "^2.3.2"
  },
  "devDependencies": {
    "@raycast/eslint-config": "2.2.0",
    "@types/node": "26.6.5",
    "@types/react": "^19.3.0",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  },
  "allowScripts": {
    "esbuild": true
  }
}
