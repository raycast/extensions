              "value": "bn"
            },
            {
              "title": "Chinese",
              "value": "zh"
            },
            {
              "title": "French",
              "value": "fr"
            },
            {
              "title": "German",
              "value": "de"
            },
            {
              "title": "Hindi",
              "value": "hi"
            },
            {
              "title": "Indonesian",
              "value": "id"
            },
            {
              "title": "Italian",
              "value": "it"
            },
            {
              "title": "Japanese",
              "value": "ja"
            },
            {
              "title": "Korean",
              "value": "ko"
            },
            {
              "title": "Portuguese (Brazil)",
              "value": "pt-BR"
            },
            {
              "title": "Portuguese (Portugal)",
              "value": "pt-PT"
            },
            {
              "title": "Russian",
              "value": "ru"
            },
            {
              "title": "Spanish (Mexico)",
              "value": "es-MX"
            },
            {
              "title": "Spanish (Spain)",
              "value": "es-ES"
            },
            {
              "title": "Turkish",
              "value": "tr"
            },
            {
              "title": "Vietnamese",
              "value": "vi"
            }
          ]
        }
      ]
    },
    {
      "name": "generate-image",
      "title": "Generate Image",
      "subtitle": "Grokcast",
      "description": "Describe an image and Grok makes it with your subscription. Copy, paste, or save the result.",
      "mode": "view"
    },
    {
      "name": "edit-image",
      "title": "Edit Image",
      "subtitle": "Grokcast",
      "description": "Change up to three images with a prompt. Uses the images selected in Finder when there are any.",
      "mode": "view"
    },
    {
      "name": "image-history",
      "title": "Image History",
      "subtitle": "Grokcast",
      "description": "Browse, copy, paste, or edit the images Grok made for you.",
      "mode": "view"
    },
    {
      "name": "generate-video",
      "title": "Generate Video",
      "subtitle": "Grokcast",
      "description": "Make a video with Grok from a prompt or a picture, or edit or extend an MP4. Uses your Grok or X subscription.",
      "mode": "view"
    },
    {
      "name": "chat",
      "title": "Grok Chat",
      "subtitle": "Grokcast",
      "description": "Ask Grok anything and keep the conversation going. Grok can search the web and X for current answers. Uses your Grok or X subscription.",
      "mode": "view",
      "preferences": [
        {
          "name": "chatModel",
          "title": "Model",
          "description": "Leave empty to use grok-4.7. Enter another model ID from Grok Models to use that model instead.",
          "type": "textfield",
          "required": false,
          "placeholder": "grok-4.7"
        },
        {
          "name": "reasoningEffort",
          "title": "Reasoning",
          "description": "How hard Grok thinks before it answers. Lower is faster. Not every model accepts a setting.",
          "type": "dropdown",
          "required": false,
          "default": "default",
          "data": [
            {
              "title": "xAI Default",
              "value": "default"
            },
            {
              "title": "Low",
              "value": "low"
            },
            {
              "title": "Medium",
              "value": "medium"
            },
            {
              "title": "High",
              "value": "high"
            }
          ]
        },
        {
          "name": "webSearch",
          "title": "Grok Tools",
          "label": "Search the web",
          "description": "Let Grok search the web for current information and cite its sources.",
          "type": "checkbox",
          "required": false,
          "default": true
        },
        {
          "name": "xSearch",
          "title": "",
          "label": "Search X",
          "description": "Let Grok search posts on X.",
          "type": "checkbox",
          "required": false,
          "default": true
        },
        {
          "name": "codeExecution",
          "title": "",
          "label": "Run code",
          "description": "Let Grok write and run Python in xAI's sandbox for calculations and data.",
          "type": "checkbox",
          "required": false,
          "default": false
        },
        {
          "name": "chatInstructions",
          "title": "Instructions",
          "description": "Sent with every question, such as \"Answer briefly\". Leave empty for none.",
          "type": "textfield",
          "required": false,
          "placeholder": "Answer briefly"
        }
      ]
    },
    {
      "name": "models",
      "title": "Grok Models",
      "subtitle": "Grokcast",
      "description": "Browse the Grok language, image, and video models your subscription can use, and count the tokens in a text.",
      "mode": "view"
    },
    {
      "name": "files",
      "title": "Grok Files",
      "subtitle": "Grokcast",
      "description": "Upload, download, share, and delete the files you keep at xAI with your Grok or X subscription.",
      "mode": "view"
    },
    {
      "name": "voices",
      "title": "Grok Voices",
      "subtitle": "Grokcast",
      "description": "Preview Grok's voices, make your own custom voice from a recording or an audio file, and pick the voice Read Aloud uses.",
      "mode": "view"
    }
  ],
  "platforms": [
    "macOS"
  ],
  "preferences": [
    {
      "name": "language",
      "title": "Dictation Language",
      "description": "The language you speak. Detect Automatically works for most languages, but number formatting needs a language.",
      "type": "dropdown",
      "required": false,
      "default": "en",
      "data": [
        {
          "title": "Detect Automatically",
          "value": "auto"
        },
        {
          "title": "English",
          "value": "en"
        },
        {
          "title": "Spanish",
          "value": "es"
        },
        {
          "title": "French",
          "value": "fr"
        },
        {
          "title": "German",
          "value": "de"
        },
        {
          "title": "Italian",
          "value": "it"
        },
        {
          "title": "Portuguese",
          "value": "pt"
        },
        {
          "title": "Dutch",
          "value": "nl"
        },
        {
