        },
        {
          "title": "Korean",
          "value": "ko"
        },
        {
          "title": "Chinese",
          "value": "zh"
        }
      ]
    },
    {
      "name": "formatNumbers",
      "title": "Formatting",
      "label": "Write numbers as digits",
      "description": "Write spoken numbers, currencies, and units as digits, such as $25 instead of twenty-five dollars. Needs a dictation language.",
      "type": "checkbox",
      "required": false,
      "default": true
    },
    {
      "name": "afterDictation",
      "title": "After Dictation",
      "description": "Paste the text into the app you were using, or only copy it to the clipboard.",
      "type": "dropdown",
      "required": false,
      "default": "paste",
      "data": [
        {
          "title": "Paste into the Frontmost App",
          "value": "paste"
        },
        {
          "title": "Copy to the Clipboard",
          "value": "copy"
        }
      ]
    },
    {
      "name": "keepHistory",
      "title": "History",
      "label": "Keep dictation history",
      "description": "Keep the text of your last 100 dictations on this Mac. Audio is never saved.",
      "type": "checkbox",
      "required": false,
      "default": true
    },
    {
      "name": "clientId",
      "title": "OAuth Client ID",
      "description": "Leave empty to use the default xAI sign-in client. Change it only if xAI gives you a client ID for this extension.",
      "type": "textfield",
      "required": false,
      "placeholder": "Default xAI client"
    }
  ],
  "title": "Grokcast (Grok with Your xAI Subscription)"
}
