{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "grokcast",
  "version": "0.1.0",
  "private": true,
  "description": "Use Grok in Raycast with your own Grok or X subscription and the official xAI SDK. No API key needed.",
  "categories": [
    "Media",
    "Productivity"
  ],
  "license": "MIT",
  "author": "jonbeckman",
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "check": "nub run typecheck && nub run lint && nub run format && nub run test && nub run build",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint": "NODE_OPTIONS='--import tsx' oxlint",
    "lint:fix": "NODE_OPTIONS='--import tsx' oxlint --fix",
    "publish": "npx @raycast/api@latest publish",
    "tegami": "tsx scripts/tegami.mts",
    "test": "node --import tsx --test 'tests/**/*.test.ts'",
    "typecheck": "tsrs --noEmit"
  },
  "dependencies": {
    "@raycast/api": "2.10.1",
    "@xai-official/sdk": "0.2.5",
    "effect": "4.0.6",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@mpsuesser/oxlint-plugin-effect": "0.6.0",
    "@oxlint/plugins": "1.89.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/ws": "8.18.2",
    "anti-slop": "github:dmmulroy/anti-slop",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "tegami": "1.5.0",
    "tsrs": "0.20.0-ts7.1.0-beta",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "icon": "extension-icon.png",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^12.2.0",
      "onFail": "warn"
    },
    "runtime": {
      "name": "node",
      "version": "24.15.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "packageManager": "npm@12.2.0+sha512.66c2632a94e796649738b2d7894d710c2cc2e1696893823066687f6b0d8a52e5f2b54eeaeaa32ffdc513ecca1e49ff794a5c2ec3f9515d879f1b3182b291cf35",
  "commands": [
    {
      "name": "account",
      "title": "Grok Account",
      "subtitle": "Grokcast",
      "description": "See who is signed in, and sign in or out with your Grok or X subscription. No API key needed.",
      "mode": "view"
    },
    {
      "name": "dictate",
      "title": "Dictate",
      "subtitle": "Grokcast",
      "description": "Speak and see the text as you go, then paste it into the app you were using. Transcribed by Grok with your subscription.",
      "mode": "view"
    },
    {
      "name": "dictation-history",
      "title": "Dictation History",
      "subtitle": "Grokcast",
      "description": "Search, paste, or copy your past dictations.",
      "mode": "view"
    },
    {
      "name": "read-aloud",
      "title": "Read Aloud",
      "subtitle": "Grokcast",
      "description": "Read the selected text aloud in a Grok voice, or the clipboard when nothing is selected. Run it again to stop. Spoken by Grok with your subscription.",
      "mode": "no-view",
      "arguments": [
        {
          "name": "text",
          "placeholder": "Text",
          "type": "text",
          "required": false
        }
      ],
      "preferences": [
        {
          "name": "voice",
          "title": "Voice",
          "description": "The Grok voice that reads the text. xAI Default follows xAI's choice.",
          "type": "dropdown",
          "required": false,
          "default": "default",
          "data": [
            {
              "title": "xAI Default",
              "value": "default"
            },
            {
              "title": "Altair (Elegant and premium)",
              "value": "altair"
            },
            {
              "title": "Ara (Warm and friendly)",
              "value": "ara"
            },
            {
              "title": "Atlas (Confident and commanding)",
              "value": "atlas"
            },
            {
              "title": "Aurora (Serene and radiant)",
              "value": "aurora"
            },
            {
              "title": "Carina (Soft and empathetic)",
              "value": "carina"
            },
            {
              "title": "Castor (Down-to-earth and easygoing)",
              "value": "castor"
            },
            {
              "title": "Celeste (Compassionate and reassuring)",
              "value": "celeste"
            },
            {
              "title": "Cosmo (Bright and easy to follow)",
              "value": "cosmo"
            },
            {
              "title": "Eve (Energetic and upbeat, British accent)",
              "value": "eve"
            },
            {
              "title": "Helios (Upbeat and versatile)",
              "value": "helios"
            },
            {
              "title": "Helix (Bold and high-energy)",
              "value": "helix"
            },
            {
              "title": "Iris (Friendly and upbeat)",
              "value": "iris"
            },
            {
              "title": "Kepler (Inventive and charismatic)",
              "value": "kepler"
            },
            {
              "title": "Leo (Authoritative and strong, British accent)",
              "value": "leo"
            },
            {
              "title": "Liora (Calm and luminous)",
              "value": "liora"
            },
            {
              "title": "Lumen (Warm and articulate)",
              "value": "lumen"
            },
            {
              "title": "Luna (Gentle and nurturing)",
              "value": "luna"
            },
            {
              "title": "Lux (Calm and wise)",
              "value": "lux"
            },
            {
              "title": "Naksh (Warm and thoughtful, Indian accent)",
              "value": "naksh"
            },
            {
              "title": "Orion (Rich and cinematic)",
              "value": "orion"
            },
            {
              "title": "Perseus (Strong and trustworthy)",
              "value": "perseus"
            },
            {
              "title": "Rex (Confident and clear)",
              "value": "rex"
            },
            {
              "title": "Rigel (Precise and professional, Australian accent)",
              "value": "rigel"
            },
            {
              "title": "Sal (Smooth and balanced)",
              "value": "sal"
            },
            {
              "title": "Sirius (Quick-witted and playful)",
              "value": "sirius"
            },
            {
              "title": "Ursa (Warm and steadfast)",
              "value": "ursa"
            },
            {
              "title": "Zagan (Powerful and dramatic)",
              "value": "zagan"
            },
            {
              "title": "Zenith (Sharp and driven)",
              "value": "zenith"
            }
          ]
        },
        {
          "name": "speed",
          "title": "Speed",
          "description": "How fast the voice reads.",
          "type": "dropdown",
          "required": false,
          "default": "default",
          "data": [
            {
              "title": "xAI Default",
              "value": "default"
            },
            {
              "title": "Slower (0.7×)",
              "value": "0.7"
            },
            {
              "title": "Slow (0.85×)",
              "value": "0.85"
            },
            {
              "title": "Fast (1.25×)",
              "value": "1.25"
            },
            {
              "title": "Faster (1.5×)",
              "value": "1.5"
            }
          ]
        },
        {
          "name": "speechLanguage",
          "title": "Reading Language",
          "description": "The language of the text. Detect Automatically works for most text.",
          "type": "dropdown",
          "required": false,
          "default": "auto",
          "data": [
            {
              "title": "Detect Automatically",
              "value": "auto"
            },
            {
              "title": "English",
              "value": "en"
            },
            {
              "title": "Arabic (Egypt)",
              "value": "ar-EG"
            },
            {
