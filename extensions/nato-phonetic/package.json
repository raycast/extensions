{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "nato-phonetic",
  "title": "NATO Phonetic",
  "version": "1.0.0",
  "description": "Convert text to NATO phonetic alphabet with pronunciation guide and text-to-speech",
  "icon": "icon.png",
  "author": "raychaser",
  "categories": ["Productivity"],
  "keywords": [
    "nato",
    "phonetic",
    "alphabet",
    "spelling",
    "military",
    "aviation"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "index",
      "title": "Convert to NATO Phonetic",
      "description": "Convert text to NATO phonetic alphabet",
      "mode": "view",
      "arguments": [
        {
          "name": "text",
          "placeholder": "Text to convert",
          "type": "text",
          "required": false
        }
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.83.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@types/node": "22.14.0",
    "@types/react": "18.3.3",
    "typescript": "^5.5.4"
  },
  "scripts": {
    "prebuild": "npm run lint",
    "build": "ray build",
    "dev": "ray develop",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "prepublishOnly": "npm run lint && npm run build",
    "publish": "npx @raycast/api@latest publish"
  }
}
