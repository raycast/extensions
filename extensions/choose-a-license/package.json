{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "choose-a-license",
  "title": "Choose a License",
  "description": "Read, copy, and paste Markdown licenses from choosealicense.com",
  "icon": "icon.png",
  "author": "sandypockets",
  "contributors": [
    "Aayush9029",
    "muhammadrizo"
  ],
  "categories": [
    "Developer Tools",
    "Productivity"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "index",
      "title": "Choose a License",
      "subtitle": "choosealicense.com",
      "description": "Quickly add a license to your open source project",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^2.6.2"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  },
  "allowScripts": {
    "esbuild": true
  }
}
