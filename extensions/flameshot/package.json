{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "flameshot",
  "title": "Flameshot",
  "description": "Capture screenshots with Flameshot",
  "icon": "extension-icon.png",
  "author": "muhammadrizo",
  "platforms": [
    "Windows",
    "macOS"
  ],
  "categories": [
    "Media",
    "Applications"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "capture-screen",
      "icon": "screen.png",
      "title": "Capture Screen",
      "subtitle": "Flameshot",
      "description": "Take a screenshot of the screen",
      "mode": "no-view",
      "preferences": [
        {
          "name": "copyToClipboard",
          "label": "Copy to Clipboard",
          "description": "Copy screenshot to the clipboard after capture",
          "type": "checkbox",
          "required": false,
          "default": true
        },
        {
          "name": "delay",
          "title": "Delay",
          "description": "Delay time in milliseconds",
          "type": "textfield",
          "required": false,
          "placeholder": "3000",
          "default": "0"
        },
        {
          "name": "countdown",
          "label": "Countdown",
          "description": "Show countdown for delay",
          "type": "checkbox",
          "required": false,
          "default": true
        }
      ],
      "arguments": [
        {
          "name": "delay",
          "placeholder": "3000",
          "type": "text",
          "required": false
        }
      ]
    },
    {
      "name": "capture-selection",
      "icon": "selection.png",
      "title": "Capture Selection",
      "subtitle": "Flameshot",
      "description": "Take a screenshot of a selected area",
      "mode": "no-view",
      "preferences": [
        {
          "name": "copyToClipboard",
          "label": "Copy to Clipboard",
          "description": "Copy screenshot to the clipboard after capture",
          "type": "checkbox",
          "required": false,
          "default": true
        },
        {
          "name": "delay",
          "title": "Delay",
          "description": "Delay time in milliseconds",
          "type": "textfield",
          "required": false,
          "placeholder": "3000",
          "default": "0"
        },
        {
          "name": "countdown",
          "label": "Countdown",
          "description": "Show countdown for delay",
          "type": "checkbox",
          "required": false,
          "default": true
        },
        {
          "name": "acceptOnSelect",
          "label": "Accept on Select",
          "description": "Accept capture as soon as a selection is made",
          "type": "checkbox",
          "required": false
        },
        {
          "name": "pin",
          "description": "Pin the capture to the screen",
          "type": "checkbox",
          "required": false,
          "label": "Pin"
        }
      ],
      "arguments": [
        {
          "name": "delay",
          "placeholder": "3000",
          "type": "text",
          "required": false
        },
        {
          "name": "pin",
          "placeholder": "Pin?",
          "type": "dropdown",
          "required": false,
          "data": [
            {
              "title": "Yes",
              "value": "yes"
            }
          ]
        }
      ]
    },
    {
      "name": "capture-all-screens",
      "icon": "all-screens.png",
      "title": "Capture All Screens",
      "subtitle": "Flameshot",
      "description": "Take screenshots of all screens",
      "mode": "no-view",
      "preferences": [
        {
          "name": "delay",
          "title": "Delay",
          "description": "Delay time in milliseconds",
          "type": "textfield",
          "required": false,
          "placeholder": "3000",
          "default": "0"
        },
        {
          "name": "countdown",
          "label": "Countdown",
          "description": "Show countdown for delay",
          "type": "checkbox",
          "required": false,
          "default": true
        }
      ],
      "arguments": [
        {
          "name": "delay",
          "placeholder": "3000",
          "type": "text",
          "required": false
        }
      ]
    }
  ],
  "preferences": [
    {
      "name": "screenshotsFolder",
      "title": "Screenshots Folder",
      "description": "Specify the path to your Flameshot screenshots folder",
      "type": "directory",
      "required": true
    },
    {
      "name": "cliPath",
      "description": "Specify the path to the Flameshot CLI",
      "type": "file",
      "required": false,
      "title": "CLI Path"
    }
  ],
  "dependencies": {
    "@raycast/api": "^2.0.5"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "eslint": "^10.9.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "prepublishOnly": "echo \"\\n\\nIt seems like you are trying to publish the Raycast extension to npm.\\n\\nIf you did intend to publish it to npm, remove the \\`prepublishOnly\\` script and rerun \\`npm publish\\` again.\\nIf you wanted to publish it to the Raycast Store instead, use \\`npm run publish\\` instead.\\n\\n\" && exit 1",
    "publish": "npx @raycast/api@latest publish"
  }
}
