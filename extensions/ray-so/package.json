{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "ray-so",
  "title": "ray.so",
  "description": "Create beautiful images of your code using ray.so",
  "icon": "icon.png",
  "author": "garrett",
  "contributors": [
    "RSO",
    "dgrzedzielski",
    "emlez",
    "samuelkraft",
    "benoit.grelard",
    "sdorra",
    "sebdanielsson",
    "ray.dhruv"
  ],
  "license": "MIT",
  "categories": [
    "Design Tools"
  ],
  "commands": [
    {
      "name": "create-a-snippet",
      "title": "Create Image from Code",
      "subtitle": "ray.so",
      "description": "Use Ray.so to create beautiful images of your code",
      "mode": "view"
    },
    {
      "name": "generate-image",
      "title": "Generate Image",
      "subtitle": "ray.so",
      "description": "Use Ray.so to create beautiful images of your code",
      "mode": "no-view"
    }
  ],
  "dependencies": {
    "@raycast/api": "~2.4.1",
    "@raycast/utils": "^2.3.1"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@typescript/native": "npm:typescript@~7.0.2",
    "eslint": "^10.11.0",
    "prettier": "^3.9.8",
    "react": "^19.3.0",
    "typescript": "npm:@typescript/typescript6@~6.0.2"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish",
    "test": "node --test tests/*.test.cjs"
  },
  "platforms": [
    "macOS",
    "Windows"
  ],
  "overrides": {
    "brace-expansion": "5.0.9",
    "js-yaml@4": "4.3.1"
  },
  "preferences": [
    {
      "name": "theme",
      "title": "Theme",
      "type": "dropdown",
      "required": false,
      "description": "Default color theme for commands and AI tools",
      "default": "candy",
      "data": [
        {
          "title": "Vercel",
          "value": "vercel"
        },
        {
          "title": "Evil Rabbit",
          "value": "rabbit"
        },
        {
          "title": "Supabase",
          "value": "supabase"
        },
        {
          "title": "Tailwind",
          "value": "tailwind"
        },
        {
          "title": "OpenAI",
