        {
          "title": "Midnight",
          "value": "midnight"
        },
        {
          "title": "Raindrop",
          "value": "raindrop"
        },
        {
          "title": "Sunset",
          "value": "sunset"
        }
      ]
    },
    {
      "name": "padding",
      "title": "Padding",
      "type": "dropdown",
      "required": false,
      "description": "Default padding around your code in commands and AI tools",
      "default": "64",
      "data": [
        {
          "title": "16",
          "value": "16"
        },
        {
          "title": "32",
          "value": "32"
        },
        {
          "title": "64",
          "value": "64"
        },
        {
          "title": "128",
          "value": "128"
        }
      ]
    },
    {
      "name": "darkMode",
      "title": "Dark Mode",
      "type": "checkbox",
      "description": "Use dark mode by default in commands and AI tools",
      "required": false,
      "default": true,
      "label": "Enabled"
    },
    {
      "name": "background",
      "title": "Background",
      "type": "checkbox",
      "description": "Show the gradient background by default in commands and AI tools",
      "required": false,
      "default": true,
      "label": "Enabled"
    }
  ],
  "tools": [
    {
      "name": "create-code-image",
      "title": "Create Code Image",
      "description": "Create and optionally open a ray.so editor link for code, using saved image defaults and optional overrides. Export the image from the editor."
    },
    {
      "name": "get-image-options",
      "title": "Get Image Options",
      "description": "List current ray.so themes, languages, padding options, and the user's saved image defaults."
    }
  ]
}
