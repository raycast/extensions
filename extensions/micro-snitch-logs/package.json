{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "micro-snitch-logs",
  "title": "Micro Snitch Logs",
  "description": "Visualize Micro Snitch logs with beautiful formatting",
  "icon": "logo.png",
  "author": "jorgetoh",
  "categories": [
    "Developer Tools",
    "System"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "view-logs",
      "title": "View Micro Snitch Logs",
      "description": "View and monitor Micro Snitch activity logs",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.60.1"
  },
  "devDependencies": {
    "@raycast/eslint-config": "1.0.6",
    "@types/node": "18.8.3",
    "@types/react": "18.0.9",
    "eslint": "^8.21.0",
    "prettier": "^2.7.1",
    "typescript": "^4.7.4"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}