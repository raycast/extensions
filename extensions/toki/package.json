{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "toki",
  "title": "Toki",
  "description": "Track time for projects and tasks with local JSON file storage",
  "icon": "extension_icon.png",
  "author": "medienbaecker",
  "categories": [
    "Productivity"
  ],
  "license": "MIT",
  "preferences": [
    {
      "name": "dataPath",
      "title": "Data File Path",
      "description": "Path to toki.json file",
      "type": "textfield",
      "required": true,
      "default": "~/Documents/Toki/toki.json"
    }
  ],
  "commands": [
    {
      "name": "toki",
      "title": "Time Tracker",
      "description": "Track your time",
      "mode": "view"
    },
    {
      "name": "stop-tracking",
      "title": "Stop Tracking",
      "description": "Stop the current tracking session",
      "mode": "no-view",
      "icon": "stop_icon.png"
    },
    {
      "name": "menu-bar",
      "title": "Tracking Status",
      "description": "Show current tracking status in menu bar",
      "mode": "menu-bar",
      "interval": "1m",
      "icon": "menubar_icon.png"
    }
  ],
  "tools": [
    {
      "name": "get-tracking-status",
      "title": "Get Tracking Status",
      "description": "Get the current time tracking session"
    },
    {
      "name": "get-time",
      "title": "Get Time",
      "description": "Get time tracking data. No params = all groups. groupName = that group's activities. activityName = search across all groups. Both = specific activity. Add date filters as needed."
    },
    {
      "name": "track",
      "title": "Track",
      "description": "Start or stop time tracking. No params = stop current session. To START, BOTH groupName AND activityName are required - ask user if missing."
    },
    {
      "name": "add-time",
      "title": "Add Time",
      "description": "Add manual time entry. Params: groupName, activityName, duration (e.g. '2h 30m'), date (optional)."
    },
    {
      "name": "create",
      "title": "Create",
      "description": "Create group or activity. groupName only = new group. groupName + activityName = new activity."
    }
  ],
  "ai": {
    "instructions": "Toki tracks time. Groups contain activities. Group synonyms: project, client, customer, job. Activity synonyms: task, work, item. If user asks about time 'on X' without saying 'project/client', treat X as an activity first (use activityName). Only use groupName if user explicitly says 'project X' or 'client X'. IMPORTANT: To start tracking, both groupName AND activityName are required. If user doesn't specify both, ask which project and task to track.",
    "evals": [
      {
        "input": "@toki how much time did I spend on Development?",
        "mocks": {
          "get-time": {
            "activityTitle": "Development",
            "totalTime": "5h 30m",
            "totalHours": 5.5,
            "byGroup": [
              {
                "groupTitle": "ProjectX",
                "time": "3h",
                "hours": 3
              },
              {
                "groupTitle": "ProjectY",
                "time": "2h 30m",
                "hours": 2.5
              }
            ]
          }
        },
        "expected": [
          {
            "callsTool": {
              "name": "get-time",
              "arguments": {
                "activityName": "Development"
              }
            }
          }
        ]
      },
      {
        "input": "@toki what are my projects?",
        "mocks": {
          "get-time": {
            "totalTime": "10h",
            "groups": [
              {
                "title": "ProjectX",
                "time": "6h",
                "hours": 6
              },
              {
                "title": "ProjectY",
                "time": "4h",
                "hours": 4
              }
            ]
          },
          "get-tracking-status": null
        },
        "expected": [
          {
            "callsTool": "get-time"
          }
        ]
      },
      {
        "input": "@toki am I tracking time?",
        "mocks": {
          "get-tracking-status": {
            "groupTitle": "ProjectX",
            "activityTitle": "Development",
            "elapsedTime": "1h 30m"
          }
        },
        "expected": [
          {
            "callsTool": "get-tracking-status"
          }
        ]
      },
      {
        "input": "@toki start tracking Development on ProjectX",
        "mocks": {
          "track": {
            "started": true,
            "groupTitle": "ProjectX",
            "activityTitle": "Development"
          }
        },
        "expected": [
          {
            "callsTool": {
              "name": "track",
              "arguments": {
                "activityName": {
                  "includes": "development"
                }
              }
            }
          }
        ]
      },
      {
        "input": "@toki stop tracking",
        "mocks": {
          "track": {
            "stopped": true,
            "duration": "2h 15m"
          }
        },
        "expected": [
          {
            "callsTool": "track"
          }
        ]
      },
      {
        "input": "@toki add 2 hours to meetings on ClientX",
        "mocks": {
          "add-time": {
            "added": true,
            "duration": "2h"
          }
        },
        "expected": [
          {
            "callsTool": {
              "name": "add-time",
              "arguments": {
                "duration": {
                  "includes": "2"
                }
              }
            }
          }
        ]
      }
    ]
  },
  "dependencies": {
    "@raycast/api": "^1.57.2",
    "@raycast/utils": "^1.9.1"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.8",
    "@types/node": "^18.8.3",
    "@types/react": "^18.0.9",
    "eslint": "^8.57.0",
    "prettier": "^2.5.1",
    "typescript": "^4.4.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}
