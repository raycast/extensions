{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "sleep-calculator",
  "title": "Sleep Calculator",
  "description": "Calculate optimal sleep and wake times based on 90-minute sleep cycles",
  "icon": "extension-icon.png",
  "author": "nazzy_wazzy_lu",
  "categories": [
    "Productivity"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "wake-up-at",
      "title": "Wake up at",
      "description": "Calculate when to go to bed based on your desired wake time",
      "mode": "view",
      "arguments": [
        {
          "name": "wakeTime",
          "placeholder": "Time (e.g., 7:30 AM)",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "name": "sleep-now",
      "title": "Sleep Now",
      "description": "See optimal wake times if you go to sleep right now",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.75.2",
    "chrono-node": "^2.7.7"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.1.1",
    "@types/node": "20.8.10",
    "@types/react": "18.2.45",
    "eslint": "^9.22.0",
    "prettier": "^3.0.3",
    "typescript": "^5.2.2"
  },
  "overrides": {
    "@types/react": "18.2.45"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}