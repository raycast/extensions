{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "clipboard-qrcode",
  "title": "Clipboard to QR Code",
  "description": "Convert clipboard content to a QR code",
  "icon": "extension-icon.png",
  "author": "jiu",
  "categories": ["Productivity"],
  "license": "MIT",
  "commands": [
    {
      "name": "clipboard-to-qr",
      "title": "Generate QR Code from Clipboard",
      "description": "Read clipboard text and display it as a QR code",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.18",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.11",
    "@types/node": "^22.13.10",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.10",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "typescript": "^5.4.5"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "prepublishOnly": "echo \"Error: no publish\" && exit 1",
    "publish": "npx @raycast/api@latest publish"
  }
}
