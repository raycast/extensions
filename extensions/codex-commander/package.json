{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "codex-commander",
  "title": "Codex Commander",
  "description": "Open the Codex app via codex:// deeplinks.",
  "icon": "icon.png",
  "author": "tomas_roda",
  "categories": [
    "Developer Tools"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "index",
      "title": "Codex Commander",
      "subtitle": "Codex deeplinks",
      "description": "Open settings, skills, automations, a thread, or a new thread in Codex.",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.79.0",
    "@raycast/utils": "^1.17.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.11",
    "@types/node": "^20.10.0",
    "@types/react": "^19.0.10",
    "eslint": "^8.57.0",
    "typescript": "^5.3.0"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  },
  "overrides": {
    "@types/react": "$@types/react"
  }
}
