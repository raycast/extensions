{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "deepl-tools",
  "title": "DeepL Tools",
  "description": "Fast, smart translation between your two favorite languages",
  "icon": "extension-icon.png",
  "author": "nextster",
  "categories": [
    "Productivity"
  ],
  "license": "MIT",
  "platforms": [
    "macOS"
  ],
  "preferences": [
    {
      "name": "apiKey",
      "title": "DeepL API Key",
      "description": "Open https://www.deepl.com/your-account/keys, sign in or create a DeepL API Free account, copy your Authentication Key, and paste it here",
      "type": "password",
      "placeholder": "Paste your DeepL API key",
      "required": true
    },
    {
      "name": "primaryLanguage",
      "title": "Primary Language",
      "description": "Your main language and the fallback translation target",
      "type": "dropdown",
      "required": true,
      "default": "RU",
      "data": [
        { "title": "Arabic", "value": "AR" },
        { "title": "Bulgarian", "value": "BG" },
        { "title": "Chinese (Simplified)", "value": "ZH-HANS" },
        { "title": "Chinese (Traditional)", "value": "ZH-HANT" },
        { "title": "Czech", "value": "CS" },
        { "title": "Danish", "value": "DA" },
        { "title": "Dutch", "value": "NL" },
        { "title": "English (American)", "value": "EN-US" },
        { "title": "English (British)", "value": "EN-GB" },
        { "title": "Estonian", "value": "ET" },
        { "title": "Finnish", "value": "FI" },
        { "title": "French", "value": "FR" },
        { "title": "German", "value": "DE" },
        { "title": "Greek", "value": "EL" },
        { "title": "Hebrew", "value": "HE" },
        { "title": "Hungarian", "value": "HU" },
        { "title": "Indonesian", "value": "ID" },
        { "title": "Italian", "value": "IT" },
        { "title": "Japanese", "value": "JA" },
        { "title": "Korean", "value": "KO" },
        { "title": "Latvian", "value": "LV" },
        { "title": "Lithuanian", "value": "LT" },
        { "title": "Norwegian Bokmål", "value": "NB" },
        { "title": "Polish", "value": "PL" },
        { "title": "Portuguese (Brazilian)", "value": "PT-BR" },
        { "title": "Portuguese (European)", "value": "PT-PT" },
        { "title": "Romanian", "value": "RO" },
        { "title": "Russian", "value": "RU" },
        { "title": "Slovak", "value": "SK" },
        { "title": "Slovenian", "value": "SL" },
        { "title": "Spanish", "value": "ES" },
        { "title": "Swedish", "value": "SV" },
        { "title": "Thai", "value": "TH" },
        { "title": "Turkish", "value": "TR" },
        { "title": "Ukrainian", "value": "UK" },
        { "title": "Vietnamese", "value": "VI" }
      ]
    },
    {
      "name": "secondaryLanguage",
      "title": "Secondary Language",
      "description": "Text in your primary language is translated here",
      "type": "dropdown",
      "required": true,
      "default": "EN-US",
      "data": [
        { "title": "Arabic", "value": "AR" },
        { "title": "Bulgarian", "value": "BG" },
        { "title": "Chinese (Simplified)", "value": "ZH-HANS" },
        { "title": "Chinese (Traditional)", "value": "ZH-HANT" },
        { "title": "Czech", "value": "CS" },
        { "title": "Danish", "value": "DA" },
        { "title": "Dutch", "value": "NL" },
        { "title": "English (American)", "value": "EN-US" },
        { "title": "English (British)", "value": "EN-GB" },
        { "title": "Estonian", "value": "ET" },
        { "title": "Finnish", "value": "FI" },
        { "title": "French", "value": "FR" },
        { "title": "German", "value": "DE" },
        { "title": "Greek", "value": "EL" },
        { "title": "Hebrew", "value": "HE" },
        { "title": "Hungarian", "value": "HU" },
        { "title": "Indonesian", "value": "ID" },
        { "title": "Italian", "value": "IT" },
        { "title": "Japanese", "value": "JA" },
        { "title": "Korean", "value": "KO" },
        { "title": "Latvian", "value": "LV" },
        { "title": "Lithuanian", "value": "LT" },
        { "title": "Norwegian Bokmål", "value": "NB" },
        { "title": "Polish", "value": "PL" },
        { "title": "Portuguese (Brazilian)", "value": "PT-BR" },
        { "title": "Portuguese (European)", "value": "PT-PT" },
        { "title": "Romanian", "value": "RO" },
        { "title": "Russian", "value": "RU" },
        { "title": "Slovak", "value": "SK" },
        { "title": "Slovenian", "value": "SL" },
        { "title": "Spanish", "value": "ES" },
        { "title": "Swedish", "value": "SV" },
        { "title": "Thai", "value": "TH" },
        { "title": "Turkish", "value": "TR" },
        { "title": "Ukrainian", "value": "UK" },
        { "title": "Vietnamese", "value": "VI" }
      ]
    }
  ],
  "commands": [
    {
      "name": "translate-clipboard",
      "title": "Translate Clipboard",
      "description": "Instantly translate the text on your clipboard",
      "mode": "no-view"
    },
    {
      "name": "translate-text",
      "title": "Translate Text",
      "description": "Type or paste text and see the complete translation",
      "mode": "view",
      "arguments": [
        {
          "name": "text",
          "placeholder": "Text to translate",
          "type": "text",
          "required": false
        }
      ]
    },
    {
      "name": "translate-with-deepl",
      "title": "Translate with DeepL",
      "subtitle": "DeepL Tools",
      "description": "Translate selected text, typed text, or the clipboard",
      "mode": "no-view",
      "arguments": [
        {
          "name": "text",
          "placeholder": "Text to translate (optional)",
          "type": "text",
          "required": false
        }
      ],
      "keywords": [
        "deepl",
        "translation",
        "translate"
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "1.104.24",
    "@raycast/utils": "^1.17.0",
    "franc-min": "^6.2.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.11",
    "@types/node": "20.8.10",
    "@types/react": "18.3.3",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.4.5"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish",
    "build:toast": "scripts/build-translation-toast.sh",
    "test": "tsx --test tests/*.test.ts"
  }
}
