{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "airports",
  "title": "Airport Codes",
  "description": "Find airport IATA codes by code, airport name, or city. Works offline.",
  "icon": "extension-icon.png",
  "author": "riesinger",
  "platforms": ["macOS"],
  "categories": ["Productivity"],
  "keywords": ["iata", "airport", "flight", "aviation"],
  "license": "MIT",
  "type": "module",
  "commands": [
    {
      "name": "search-airports",
      "title": "Search Airport Codes",
      "description": "Look up an IATA code or find a code by airport name or city",
      "mode": "view"
    }
  ],
  "scripts": {
    "dev": "ray develop",
    "build": "ray build",
    "lint": "ray lint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "update-data": "python3 scripts/update-airports.py",
    "publish": "ray publish"
  },
  "dependencies": {
    "@raycast/api": "^2.12.1"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "26.6.5",
    "@types/react": "^19.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0"
  }
}
