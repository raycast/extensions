{
    "$schema": "https://www.raycast.com/schemas/extension.json",
    "name": "figma-shortcuts",
    "title": "Figma Shortcuts",
    "description": "Quickly search and browse Figma keyboard shortcuts on macOS, Windows, and Linux.",
    "icon": "extension-icon.png",
    "author": "arturd95",
    "categories": ["Design Tools", "Productivity"],
    "license": "MIT",
    "commands": [
          {
                  "name": "search-shortcuts",
                  "title": "Search Figma Shortcuts",
                  "description": "Search and browse Figma keyboard shortcuts",
                  "mode": "view"
          }
    ],
    "dependencies": {
          "@raycast/api": "^1.83.1"
    },
    "devDependencies": {
          "@raycast/eslint-config": "^2.0.4",
          "@types/node": "22.13.10",
          "@types/react": "19.0.10",
          "eslint": "^9.8.0",
          "prettier": "^3.3.3",
          "typescript": "^5.5.4"
    },
    "scripts": {
          "build": "ray build -e dist",
          "dev": "ray develop",
          "fix-lint": "ray lint --fix",
          "lint": "ray lint",
          "publish": "npx @raycast/api@latest publish"
    }
}
