{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "figma-shortcuts",
  "title": "Figma Shortcuts",
  "description": "Quickly search and browse Figma keyboard shortcuts on macOS, Windows, and Linux.",
  "icon": "extension-icon.png",
  "author": "arturd95",
  "categories": ["Design Tools", "Productivity"],
  "license": "MIT",
  "commands": [
    {
      "name": "search-shortcuts",
      "title": "Search Figma Shortcuts",
      "description": "Search and browse Figma keyboard shortcuts",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.50.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.6",
    "@types/node": "18.8.3",
    "@types/react": "18.0.9",
    "eslint": "^7.32.0",
    "prettier": "^2.5.1",
    "typescript": "^4.4.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}
