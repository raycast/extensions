{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "yandex-dictionary",
  "title": "Yandex Dictionary",
  "description": "Raycast extension for Yandex Dictionary: quickly translate words between multiple languages, view translation history, and reuse past queries with a single action.",
  "icon": "icon.png",
  "author": "zagoruyko-v",
  "platforms": [
    "macOS",
    "Windows"
  ],
  "categories": [
    "Productivity"
  ],
  "license": "MIT",
  "preferences": [
    {
      "type": "password",
      "name": "apiKey",
      "title": "Yandex Dictionary API Key",
      "description": "Enter your Yandex Dictionary API key",
      "required": true
    }
  ],
