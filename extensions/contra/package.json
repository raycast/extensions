{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "contra",
  "title": "Contra",
  "description": "Track your Contra finances, invoices, revenue, and active projects — right from Raycast.",
  "icon": "extension-icon.png",
  "author": "agusdellaquila",
  "categories": ["Finance", "Productivity"],
  "license": "MIT",
  "commands": [
    {
      "name": "finance",
      "title": "Finance Dashboard",
      "subtitle": "Contra",
      "description": "Balance, revenue, and outstanding invoices.",
      "mode": "view"
    },
    {
      "name": "projects",
      "title": "Active Projects",
      "subtitle": "Contra",
      "description": "Your active projects and clients.",
      "mode": "view"
    },
    {
      "name": "messages",
      "title": "Messages",
      "subtitle": "Contra",
      "description": "Client conversations and unread messages.",
      "mode": "view"
    },
    {
      "name": "create-invoice",
      "title": "Create Invoice",
      "subtitle": "Contra",
      "description": "Draft and send a Contra invoice.",
      "mode": "view"
    },
    {
      "name": "menubar",
      "title": "Contra Menu Bar",
      "description": "Pending balance and next due invoice in your menu bar.",
      "mode": "menu-bar",
      "interval": "30m"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.83.0",
    "@raycast/utils": "^1.17.0",
    "@modelcontextprotocol/sdk": "^1.12.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.11",
    "@types/node": "^20.8.10",
    "@types/react": "19.0.10",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "typescript": "^5.4.5"
  },
  "overrides": {
    "@types/react": "19.0.10"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}
