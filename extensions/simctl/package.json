{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "simulator-control",
  "title": "Simulator Control",
  "description": "Control Apple Simulator devices",
  "icon": "command-icon.png",
  "author": "noppefoxwolf",
  "contributors": [
    "xmok",
    "Fizzbow"
  ],
  "categories": [
    "Developer Tools"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "index",
      "title": "Simulator Control",
      "description": "Control Apple Simulator devices",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.79.0",
    "@raycast/utils": "^1.17.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.8",
    "@types/node": "^20.8.10",
    "@types/react": "^18.3.3",
    "@types/react-test-renderer": "^18.3.1",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "react-test-renderer": "^18.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.4.5"
  },
  "scripts": {
    "test": "tsx --tsconfig tests/tsconfig.json --test tests/*.test.tsx",
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "ray publish"
  },
  "platforms": [
    "macOS"
  ],
  "overrides": {
    "minimatch": "^10.0.1",
    "picomatch": "^4.0.4"
  }
}
