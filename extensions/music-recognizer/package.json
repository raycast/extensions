{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "music-recognizer",
  "title": "Music Recognizer",
  "description": "Identify the song playing on your PC. Records a few seconds of system audio and identifies it with Shazam's recognition service, with quick links to Spotify, YouTube Music, Apple Music, and Shazam.",
  "icon": "icon.png",
  "author": "erenalparslan",
  "categories": [
    "Media"
  ],
  "license": "MIT",
  "platforms": [
    "Windows"
  ],
  "commands": [
    {
      "name": "recognize",
      "title": "Recognize Song",
      "description": "Listen to what's playing and identify the song.",
      "mode": "view"
    },
    {
      "name": "history",
      "title": "Recognition History",
      "description": "Browse previously recognized songs.",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "duration",
      "title": "Recording Duration",
      "description": "How long to record system audio before recognition. Shazam's fingerprint uses at most 8 seconds of audio; 5 is usually plenty.",
      "type": "dropdown",
      "required": false,
      "default": "5",
      "data": [
        {
          "title": "3 seconds",
          "value": "3"
        },
        {
          "title": "5 seconds",
          "value": "5"
        },
        {
          "title": "8 seconds",
          "value": "8"
        },
        {
          "title": "10 seconds",
          "value": "10"
        },
        {
          "title": "12 seconds",
          "value": "12"
        }
      ]
    },
    {
      "name": "primaryService",
      "title": "Primary Music Service",
      "description": "Shown as the first action after a match, so pressing Enter opens the song there.",
      "type": "dropdown",
      "required": false,
      "default": "spotify",
      "data": [
        {
          "title": "Spotify",
          "value": "spotify"
        },
        {
          "title": "YouTube Music",
          "value": "youtubemusic"
        },
        {
          "title": "Apple Music",
          "value": "applemusic"
        },
        {
          "title": "Shazam",
          "value": "shazam"
        }
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.23",
    "@raycast/utils": "^2.2.7",
    "shazamio-core": "^1.3.1"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "22.19.17",
    "@types/react": "19.0.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.0",
    "typescript": "^5.8.0"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "lint": "ray lint",
    "fix-lint": "ray lint --fix",
    "publish": "npx @raycast/api@latest publish"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}
