{
   "compilerOptions": {
      "lib": [
         "ES2021"
      ],
      "module": "commonjs",
      "target": "ES2021",
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": false,
      "forceConsistentCasingInFileNames": true,
      "resolveJsonModule": true,
      "jsx": "react-jsx",
      "outDir": "dist",
      "rootDir": "src"
   },
   "include": [
      "src/**/*"
   ]
}
