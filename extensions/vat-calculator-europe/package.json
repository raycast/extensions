{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "vat-calculator-europe",
  "description": "Calculate VAT for different European Countries.",
  "license": "MIT",
  "scripts": {
    "sync:countries": "node scripts/sync-countries.mjs",
    "predev": "npm run sync:countries",
    "dev": "ray develop",
    "lint": "ray lint",
    "fix-lint": "ray lint --fix",
    "prebuild": "npm run sync:countries",
    "build": "ray build",
    "publish": "npx @raycast/api@latest publish"
  },
  "dependencies": {
    "@raycast/api": "^1.104.19",
    "@raycast/utils": "^2.2.6"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.1.1",
    "@types/node": "22.19.17",
    "@types/react": "19.0.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "icon": "extension-icon.png",
  "commands": [
    {
      "mode": "view",
      "name": "calculate-vat",
      "title": "Calculate VAT",
      "description": "Calculate VAT for different Countries.",
