{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "focus-automation",
  "title": "Focus Automation",
  "description": "Automate Raycast Focus sessions from your calendar.",
  "icon": "extension-icon.png",
  "author": "p2m",
  "categories": [
    "Productivity"
  ],
  "platforms": [
    "macOS"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "set-up",
      "title": "Set up Focus Automation",
      "description": "Connect Google Calendar and configure Focus Automation.",
      "mode": "view"
    },
    {
      "name": "confirm-focus",
      "title": "Confirm Focus Session",
      "description": "Prompts to start a Raycast Focus session for a scheduled event.",
      "mode": "no-view",
      "arguments": [
        {
          "name": "title",
          "placeholder": "Event title",
          "type": "text",
          "required": true
        },
        {
          "name": "duration",
          "placeholder": "Duration in seconds",
          "type": "text",
          "required": true
        },
        {
          "name": "categories",
          "placeholder": "Focus categories (comma-separated)",
          "type": "text",
          "required": false
        }
      ]
    },
    {
      "name": "focus-watcher",
      "title": "Focus Watcher",
      "description": "Background watcher for scheduled Focus sessions.",
      "mode": "no-view",
      "interval": "1m"
    }
  ],
  "preferences": [
    {
      "name": "triggerMode",
      "title": "When a block begins",
      "description": "Confirm: ask before starting Focus. Auto: start it silently.",
      "type": "dropdown",
      "required": false,
      "default": "confirm",
      "data": [
        {
          "title": "Ask me first (Confirm)",
          "value": "confirm"
        },
        {
          "title": "Start automatically (Auto)",
          "value": "auto"
        }
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.24"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "@types/react": "18.3.3"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "22.13.10",
    "@types/react": "18.3.3",
    "eslint": "^9.39.5",
    "prettier": "^3.3.3",
    "typescript": "^5.4.5"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "lint": "ray lint",
    "fix-lint": "ray lint --fix"
  }
}
