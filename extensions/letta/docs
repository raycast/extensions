### 5.5 `src/memory.tsx` – memory block inspection

**Responsibilities:**

* For the active agent:

  * List memory blocks (`label`).
  * On selection, fetch and show block content.

Skeleton:

```tsx
import { Action, ActionPanel, Detail, List, showToast, Toast } from "@raycast/api";
import { useEffect, useState } from "react";
import { useLettaClient } from "./hooks/useLettaClient";
import { useAgents } from "./hooks/useAgents";

type MemoryBlock = {
  label: string;
  value: string;
};

export default function MemoryCommand() {
  const { client } = useLettaClient();
  const { activeAgent } = useAgents(client);
  const [blocks, setBlocks] = useState<MemoryBlock[]>([]);
  const [isLoading, setIsLoading] = useState(false);

  useEffect(() => {
    if (!activeAgent) return;
    setIsLoading(true);
    client.agents.blocks
      .list(activeAgent.id)
      .then((res: any) => {
        const items = (res.data ?? []).map((b: any) => ({
          label: b.label,
          value: "",
        }));
        setBlocks(items);
      })
      .catch((e: any) =>
        showToast({
          style: Toast.Style.Failure,
          title: "Error loading blocks",
          message: e?.message,
        }),
      )
      .finally(() => setIsLoading(false));
  }, [activeAgent?.id]);

  if (!activeAgent) {
    showToast({
      style: Toast.Style.Failure,
      title: "No active agent",
      message: "Pick an agent first in ‘Manage Agents’.",
    });
    return <Detail markdown="No active agent selected." />;
  }

  return (
    <List isLoading={isLoading}>
      {blocks.map((block) => (
        <List.Item
          key={block.label}
          title={block.label}
          actions={
            <ActionPanel>
              <Action.Push
                title="View Block"
                target={<MemoryBlockDetail agentId={activeAgent.id} label={block.label} />}
              />
            </ActionPanel>
          }
        />
      ))}
    </List>
  );
}

function MemoryBlockDetail({ agentId, label }: { agentId: string; label: string }) {
  const { client } = useLettaClient();
  const [value, setValue] = useState<string>("Loading…");
  const [isLoading, setIsLoading] = useState(true);

  useEffect(() => {
    client.agents.blocks
      .retrieve(agentId, label)
      .then((res: any) => {
        setValue(String(res.value ?? ""));
      })
      .catch((e: any) => {
        setValue("Error loading memory block: " + (e?.message ?? "Unknown error"));
      })
      .finally(() => setIsLoading(false));
  }, [agentId, label]);

  return (
    <Detail
      isLoading={isLoading}
      markdown={`# ${label}\n\n\`\`\`\n${value}\n\`\`\``}
    />
  );
}
```

