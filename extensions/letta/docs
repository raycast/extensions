### 5.4 `src/create-agent.tsx` – basic Ion/default agent creation

**Responsibilities:**

* Provide a form to create an agent using a simple template (Ion‑like).
* Call `client.agents.create`.
* Set the new agent as active and redirect back to chat.

Skeleton:

```tsx
import { Action, ActionPanel, Form, popToRoot, showToast, Toast } from "@raycast/api";
import { useState } from "react";
import { useLettaClient } from "./hooks/useLettaClient";
import { useAgents } from "./hooks/useAgents";

export default function CreateAgentCommand() {
  const { client } = useLettaClient();
  const { setActiveAgentId, revalidate } = useAgents(client);
  const [name, setName] = useState("Ion");
  const [description, setDescription] = useState("My personal Letta agent with memory.");

  async function handleSubmit() {
    try {
      showToast({ style: Toast.Style.Animated, title: "Creating agent…" });

      const agent = await client.agents.create({
        name,
        description,
        model: "openai/gpt-4.1",
        memory_blocks: [
          { label: "human", value: "The human's name is unknown yet." },
          { label: "persona", value: "You are a helpful assistant." },
        ],
        tools: ["web_search", "run_code"],
      });

      setActiveAgentId(agent.id);
      await revalidate();

      showToast({ style: Toast.Style.Success, title: "Agent created", message: agent.name });
      popToRoot();
    } catch (e: any) {
      showToast({
        style: Toast.Style.Failure,
        title: "Failed to create agent",
        message: e?.message ?? "Unknown error",
      });
    }
  }

  return (
    <Form
      actions={
        <ActionPanel>
          <Action.SubmitForm title="Create Agent" onSubmit={handleSubmit} />
        </ActionPanel>
      }
    >
      <Form.TextField
        id="name"
        title="Agent Name"
        value={name}
        onChange={setName}
      />
      <Form.TextArea
        id="description"
        title="Description"
        value={description}
        onChange={setDescription}
      />
    </Form>
  );
}
```

