### 5.3 `src/agents.tsx` – agent selection & management

**Responsibilities:**

* List existing agents.
* Select active agent (store in `useAgents`’s local storage).
* Provide actions: “Make Active”, “Open in ADE” (optional `app.letta.com` link), “Create Agent” (push to `create-agent` command).

Skeleton:

```tsx
import { Action, ActionPanel, List, open, showToast, Toast } from "@raycast/api";
import { useLettaClient } from "./hooks/useLettaClient";
import { useAgents } from "./hooks/useAgents";

export default function AgentsCommand() {
  const { client } = useLettaClient();
  const { agents, isLoading, activeAgentId, setActiveAgentId, error, revalidate } =
    useAgents(client);

  if (error) {
    showToast({ style: Toast.Style.Failure, title: "Error loading agents", message: String(error) });
  }

  return (
    <List isLoading={isLoading}>
      {agents?.map((agent) => (
        <List.Item
          key={agent.id}
          title={agent.name}
          subtitle={agent.description ?? ""}
          accessories={
            agent.id === activeAgentId ? [{ tag: { value: "Active" } }] : []
          }
          actions={
            <ActionPanel>
              <Action
                title="Set as Active Agent"
                onAction={() => setActiveAgentId(agent.id)}
              />
              <Action
                title="Refresh"
                onAction={() => revalidate()}
              />
              <Action.OpenInBrowser
                title="Open in Letta ADE"
                url={`https://app.letta.com/agents/${agent.id}`}
              />
              <Action.Push
                title="Create New Agent"
                target={<CreateAgentQuick />}
              />
            </ActionPanel>
          }
        />
      ))}
    </List>
  );
}

// Simple wrapper that just renders the create-agent command component
import CreateAgentCommand from "./create-agent";
function CreateAgentQuick() {
  return <CreateAgentCommand />;
}
```

