## 4. Core hooks you’ll add

Create a small hooks layer under `src/hooks/`.

### 4.1 `src/hooks/useLettaClient.ts`

**Purpose:** Single source of truth for:

* Reading Raycast preferences.
* Instantiating the Letta client.
* Exposing `showReasoning` flag.

**File:** `src/hooks/useLettaClient.ts`

```ts
import { getPreferenceValues } from "@raycast/api";
import { Letta } from "@letta-ai/letta-client"; // per Letta TS docs :contentReference[oaicite:4]{index=4}

type ExtensionPreferences = {
  apiKey: string;
  baseUrl?: string;
  showReasoning?: boolean;
};

export function useLettaClient() {
  const { apiKey, baseUrl, showReasoning } =
    getPreferenceValues<ExtensionPreferences>();

  const client = new Letta({
    apiKey,
    ...(baseUrl ? { baseUrl } : {}),
  });

  return {
    client,
    showReasoning: showReasoning ?? true,
  };
}
```

### 4.2 `src/hooks/useAgents.ts`

**Purpose:** Fetch and cache agent list + active agent id.

**File:** `src/hooks/useAgents.ts`

```ts
import { useCachedPromise, useLocalStorage } from "@raycast/utils";
import type { Letta } from "@letta-ai/letta-client";

type AgentSummary = {
  id: string;
  name: string;
  description?: string | null;
};

const STORAGE_KEY_ACTIVE_AGENT = "letta-active-agent-id";

export function useAgents(client: Letta) {
  const {
    value: agents,
    isLoading,
    error,
    revalidate,
  } = useCachedPromise(
    async () => {
      const result = await client.agents.list();
      // shape depends on SDK; map to a lean view
      return result.data?.map((a: any) => ({
        id: a.id,
        name: a.name,
        description: a.description,
      })) as AgentSummary[];
    },
    [],
  );

  const { value: activeAgentId, setValue: setActiveAgentId } =
    useLocalStorage<string | null>(STORAGE_KEY_ACTIVE_AGENT, null);

  const activeAgent = agents?.find((a) => a.id === activeAgentId) ?? null;

  return {
    agents,
    isLoading,
    error,
    revalidate,
    activeAgent,
    activeAgentId,
    setActiveAgentId,
  };
}
```

### 4.3 `src/hooks/useChat.ts`

**Purpose:** Encapsulate the “send message to agent and get response” logic. Start with non‑streaming; you can upgrade to SSE streaming later.

**File:** `src/hooks/useChat.ts`

```ts
import { useState } from "react";
import type { Letta } from "@letta-ai/letta-client";

export function useChat(client: Letta, agentId?: string | null) {
  const [isLoading, setIsLoading] = useState(false);
  const [answer, setAnswer] = useState<string | null>(null);
  const [reasoning, setReasoning] = useState<string | null>(null);
  const [error, setError] = useState<string | null>(null);

  async function send(input: string) {
    if (!agentId) {
      setError("No active Letta agent selected.");
      return;
    }
    setIsLoading(true);
    setError(null);
    setAnswer(null);
    setReasoning(null);

    try {
      const response = await client.agents.messages.create(agentId, {
        input,
      });

      // Letta TS docs: response.messages is an array of typed messages :contentReference[oaicite:5]{index=5}
      const messages = response.messages ?? [];

      const assistantParts: string[] = [];
      const reasoningParts: string[] = [];

      for (const m of messages as any[]) {
        if (m.message_type === "assistant_message" && m.content) {
          assistantParts.push(m.content);
        } else if (m.message_type === "reasoning_message" && m.reasoning) {
          reasoningParts.push(m.reasoning);
        }
      }

      setAnswer(assistantParts.join("\n\n"));
      if (reasoningParts.length) {
        setReasoning(reasoningParts.join("\n\n"));
      }
    } catch (e: any) {
      setError(e?.message ?? "Error talking to Letta.");
    } finally {
      setIsLoading(false);
    }
  }

  return { isLoading, answer, reasoning, error, send };
}
```

