## 5. Commands you’ll add / modify

### 5.1 Replace the starter command

The template has something like `src/command-name.tsx`. Delete or rename it; you’ll create four commands instead:

* `src/chat.tsx`
* `src/agents.tsx`
* `src/memory.tsx`
* `src/create-agent.tsx`

Each command file name must match the `commands[].name` value in the manifest. ([Juejin][3])

---

### 5.2 `src/chat.tsx` – main chat command

**Responsibilities:**

* Show a simple chat UI (prompt input + answer, optionally reasoning).
* Use `useLettaClient` and `useAgents` to get client and active agent.
* Use `useChat` to send messages.

Skeleton:

```tsx
import { Action, ActionPanel, Detail, Form, showToast, Toast } from "@raycast/api";
import { useState } from "react";
import { useLettaClient } from "./hooks/useLettaClient";
import { useAgents } from "./hooks/useAgents";
import { useChat } from "./hooks/useChat";

export default function ChatCommand() {
  const { client, showReasoning } = useLettaClient();
  const { activeAgent, agents } = useAgents(client);
  const [prompt, setPrompt] = useState("");
  const { isLoading, answer, reasoning, error, send } = useChat(
    client,
    activeAgent?.id,
  );

  if (!activeAgent && agents && agents.length > 0) {
    showToast({
      style: Toast.Style.Failure,
      title: "No active agent",
      message: "Open ‘Manage Agents’ to pick one.",
    });
  }

  const markdownParts: string[] = [];
  if (activeAgent) {
    markdownParts.push(`# ${activeAgent.name}\n`);
  }
  if (answer) {
    markdownParts.push(answer);
  } else {
    markdownParts.push("_Ask your Letta agent something to get started._");
  }
  if (showReasoning && reasoning) {
    markdownParts.push("---\n**Agent reasoning (Letta)**\n\n" + reasoning);
  }

  const markdown = markdownParts.join("\n\n");

  return (
    <Detail
      isLoading={isLoading}
      markdown={markdown}
      actions={
        <ActionPanel>
          <Action.Push
            title="Ask Question"
            target={
              <PromptForm
                initialPrompt={prompt}
                onSubmit={(value) => {
                  setPrompt(value);
                  void send(value);
                }}
              />
            }
          />
        </ActionPanel>
      }
    />
  );
}

function PromptForm(props: { initialPrompt: string; onSubmit: (value: string) => void }) {
  const [value, setValue] = useState(props.initialPrompt);

  return (
    <Form
      actions={
        <ActionPanel>
          <Action.SubmitForm onSubmit={() => props.onSubmit(value)} />
        </ActionPanel>
      }
    >
      <Form.TextArea
        id="prompt"
        title="Prompt"
        placeholder="Ask your Letta agent…"
        value={value}
        onChange={setValue}
      />
    </Form>
  );
}
```

