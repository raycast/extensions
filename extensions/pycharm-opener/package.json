{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "pycharm-opener",
  "title": "Open in PyCharm",
  "description": "Quickly open folders in PyCharm from Finder",
  "icon": "extension-icon.png",
  "author": "oresamp",
  "categories": ["Developer Tools", "Productivity"],
  "license": "MIT",
  "commands": [
    {
      "name": "open-in-pycharm",
      "title": "Open in PyCharm",
      "description": "Open selected folder in PyCharm",
      "mode": "no-view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.64.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.8",
    "@types/node": "20.10.4",
    "@types/react": "18.2.45",
    "eslint": "^8.55.0",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}
