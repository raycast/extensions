{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "screenshots",
  "version": "1.0.0",
  "title": "Screenshots",
  "description": "Browse and paste screenshots with a paste-first workflow",
  "icon": "screenshots.png",
  "author": "elliot",
  "categories": [
    "Productivity"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "browse-screenshots",
      "title": "Screenshots",
      "description": "Browse and paste screenshots",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "screenshotPath",
      "title": "Screenshots Directory",
      "description": "Custom screenshots directory. When empty, uses macOS system default.",
      "type": "directory",
      "required": false
    }
  ],
  "dependencies": {
    "@raycast/api": "latest",
    "image-size": "^1.1.1"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.6",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "eslint": "^8.51.0",
    "prettier": "^3.0.3",
    "typescript": "^5.2.2"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "ray publish"
  }
}
