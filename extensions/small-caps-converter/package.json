{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "small-caps-converter",
  "title": "Small Caps Converter",
  "description": "Convert regular text into small caps Unicode text and copy it quickly.",
  "icon": "small-caps-icon.png",
  "author": "tom",
  "license": "MIT",
  "categories": [
    "Productivity"
  ],
  "platforms": [
    "macOS"
  ],
  "commands": [
    {
      "name": "index",
      "title": "Convert to Small Caps",
      "description": "Type text and copy a small caps version.",
      "mode": "view",
      "keywords": [
        "small caps",
        "unicode",
        "text",
        "typography",
        "convert"
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.1"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.1.1",
    "@types/node": "25.0.3",
    "@types/react": "19.2.7",
    "eslint": "^9.39.2",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}
