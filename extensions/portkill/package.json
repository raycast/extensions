{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "portkill",
  "title": "PortKill",
  "description": "Find local TCP listeners and stop the process on a port",
  "icon": "extension-icon.png",
  "author": "blueemi",
  "license": "MIT",
  "platforms": ["macOS", "Windows"],
  "categories": ["Developer Tools", "System"],
  "commands": [
    {
      "name": "portkill",
