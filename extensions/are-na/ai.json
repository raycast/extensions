      "expected": [
        {
          "or": [
            {
              "callsTool": {
                "name": "create-block",
                "arguments": {
                  "content": "A note about typography",
                  "channelIds": ["design-notes"]
                }
              }
            },
            {
              "callsTool": {
                "name": "create-block",
                "arguments": {
                  "content": "A note about typography",
                  "channelIds": ["42"]
                }
              }
            },
            {
              "callsTool": {
                "name": "create-block",
