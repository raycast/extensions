        "create-block": {
          "block": {
            "id": 123,
            "url": "https://www.are.na/block/123"
          }
        },
        "get-me": {
          "user": {
            "id": 1,
            "slug": "demo-user",
            "full_name": "Demo User"
          }
        },
        "list-my-channels": {
          "channels": [
            {
              "id": 42,
              "slug": "design-notes",
              "title": "Design Notes",
              "owner_slug": "demo-user",
              "url": "https://www.are.na/demo-user/design-notes"
            }
          ],
          "has_more": false
        },
        "get-channel": {
          "channel": {
            "id": 42,
            "slug": "design-notes",
            "title": "Design Notes",
            "owner_slug": "demo-user",
            "url": "https://www.are.na/demo-user/design-notes"
          }
        },
        "search-arena": {
          "query": "design-notes",
          "page": 1,
          "per": 24,
          "total_count": 1,
          "has_more": false,
          "next_page": null,
          "channels": [
            {
              "id": 42,
              "slug": "design-notes",
              "title": "Design Notes",
              "owner_slug": "demo-user",
              "url": "https://www.are.na/demo-user/design-notes"
