{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "ray-icon",
  "title": "Ray Icon",
  "description": "Create extension and app icons like ray.so/icon, from Raycast or with AI.",
  "icon": "extension-icon.png",
  "author": "0xdhrv",
  "categories": [
    "Design Tools",
    "Developer Tools"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "create-icon",
      "title": "Create Icon",
      "subtitle": "Ray Icon",
      "description": "Browse icons, history, favorites, and templates; customize and export an icon.",
      "mode": "view"
    },
    {
      "name": "icon-from-svg",
      "title": "Create Icon from SVG",
      "subtitle": "Ray Icon",
      "description": "Wrap your own SVG (from the clipboard or a file) in a ray.so-style icon.",
      "mode": "view"
    },
    {
      "name": "icon-history",
      "title": "Icon History",
      "subtitle": "Ray Icon",
      "description": "Find, edit, and export your recent icons, including AI-generated designs.",
      "mode": "view"
    },
    {
      "name": "icon-favorites",
      "title": "Favorite Icons",
      "subtitle": "Ray Icon",
      "description": "Open your favorite icon designs for editing or quick export.",
      "mode": "view"
    },
    {
      "name": "icon-templates",
      "title": "Icon Templates",
      "subtitle": "Ray Icon",
      "description": "Start from a saved style or a built-in template and reuse it with any icon.",
      "mode": "view"
    }
  ],
  "tools": [
    {
      "name": "search-icons",
      "title": "Search Icons",
      "description": "Search the Raycast icon set (the glyphs available on ray.so/icon) by keyword. Returns matching icon names to pass to Create Icon."
    },
    {
      "name": "list-presets",
      "title": "List Presets",
      "description": "List the ray.so/icon background presets (index, fill type, colors, angle/position, icon color)."
    },
    {
      "name": "create-icon",
      "title": "Create Icon",
      "description": "Render local PNG and SVG icons. Pass appearance light, dark, or both when requested; both creates a matching pair with separate files. Returns preview Markdown, file links, and ray.so editing links for built-in glyphs."
    },
    {
      "name": "list-library",
      "title": "List Library",
      "description": "Find saved icons in history, favorites, or templates. Returns IDs to reuse with Create Icon or manage with Save Library Item. History is ordered most recent first."
    },
    {
      "name": "save-library-item",
      "title": "Save Library Item",
      "description": "Add or remove a favorite, or save a named template, using a saved design ID. Does not regenerate icons or delete exported files."
    }
  ],
  "ai": {
    "instructions": "Create app and extension icons in the style of ray.so/icon. Call Search Icons to find a real icon name unless the user already supplied one or requested a custom SVG; never invent icon names.\n\nRespect the requested appearance. For light or light mode, pass appearance=\"light\" to Create Icon. For dark or dark mode, pass appearance=\"dark\". For both light and dark (in either order), pass appearance=\"both\" in ONE Create Icon call: the tool creates two matching variants with the same glyph and geometry. Never generate an unrequested second variant. When no appearance is specified, omit appearance and use the requested palette or a suitable preset. If a user explicitly specifies exact colors, do not invent different colors; the tool only adjusts them as needed for an explicitly requested appearance.\n\nUse List Presets or explicit colors to match the requested hue and mood. Only draw customSvg when requested or no Raycast icon fits; use a simple single-color glyph with fill=\"currentColor\" or stroke=\"currentColor\" and a square viewBox.\n\nAfter Create Icon, display EVERY item in variants, labeling Light and Dark when applicable. Copy each variant.preview verbatim as Markdown image syntax, outside code fences, then include its downloads Markdown so the local PNG and SVG can be opened even when the chat client cannot display local images. Do not replace the image with a plain path. Use only returned paths and URLs. Local image embedding depends on the Raycast client; do not claim a preview is visible or upload images to a hosting service.\n\nInclude each returned raySoUrl for further editing. Custom SVG results have no ray.so editing link; do not invent one.\n\nEvery successful Create Icon result is saved to History and returns historyId. If historyWarning is present, explain that the files were exported but history could not be saved. For requests to reuse an old icon, favorite, or template, call List Library with the correct collection first. Pass the returned id and collection as sourceId and sourceCollection to Create Icon. Supply icon to apply the saved style to a different glyph; omit icon and customSvg to reuse the saved glyph. Do not pass preset or colors unless the user asks to change that style. Never invent saved IDs. For favorites or named templates, use Save Library Item with a returned ID and the requested action; use the Create Icon historyId with collection history for a newly generated icon. Saving a favorite or template must not regenerate an existing icon. Only change favorites or save templates when requested. If nothing matches, say so and ask the user to choose another saved item.",
    "evals": [
      {
        "input": "@ray-icon make me an icon for a weather extension",
        "mocks": {
          "search-icons": [
            {
              "name": "cloud-sun",
              "title": "cloud sun"
            }
          ],
          "list-presets": [
            {
              "index": 7,
              "backgroundFillType": "Linear",
              "backgroundStartColor": "#00B4DB",
              "backgroundEndColor": "#003357",
              "backgroundAngle": 45,
              "iconColor": "#FFFFFF"
            }
          ],
          "create-icon": {
            "appearance": "default",
            "pngPath": "/tmp/cloud-sun_icon.png",
            "svgPath": "/tmp/cloud-sun_icon.svg",
            "preview": "![Icon](file:///tmp/cloud-sun_icon.png)",
            "downloads": "[Open Icon PNG](file:///tmp/cloud-sun_icon.png) \u00b7 [Open Icon SVG](file:///tmp/cloud-sun_icon.svg)",
            "raySoUrl": "https://ray.so/icon?icon=cloud-sun&backgroundStartColor=%23222222",
            "variants": [
              {
                "appearance": "default",
                "pngPath": "/tmp/cloud-sun_icon.png",
                "svgPath": "/tmp/cloud-sun_icon.svg",
                "preview": "![Icon](file:///tmp/cloud-sun_icon.png)",
                "downloads": "[Open Icon PNG](file:///tmp/cloud-sun_icon.png) \u00b7 [Open Icon SVG](file:///tmp/cloud-sun_icon.svg)",
                "raySoUrl": "https://ray.so/icon?icon=cloud-sun&backgroundStartColor=%23222222",
                "historyId": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
              }
            ],
            "historyId": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
          },
          "list-library": {
            "items": [],
            "total": 0,
            "warnings": []
          },
          "save-library-item": {
            "action": "favorite",
            "id": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "name": "rocket_icon_dark",
            "collection": "favorites"
          }
        },
        "expected": [
          {
            "callsTool": "search-icons"
          },
          {
            "callsTool": {
              "name": "create-icon",
              "arguments": {
                "icon": "cloud-sun"
              }
            }
          },
          {
            "includes": "![Icon](file:///tmp/cloud-sun_icon.png)"
          },
          {
            "includes": "[Open Icon PNG](file:///tmp/cloud-sun_icon.png)"
          }
        ]
      },
