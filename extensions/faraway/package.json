{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "faraway",
  "title": "Far Away",
  "description": "Keep track of what time it is for your friends around the world.",
  "icon": "extension-icon.png",
  "author": "henriquepmartins",
  "license": "MIT",
  "categories": [
    "Productivity"
  ],
  "preferences": [
    {
      "name": "language",
      "title": "Language",
      "description": "Interface language",
      "type": "dropdown",
      "default": "en",
      "required": false,
      "data": [
        {
          "title": "English",
          "value": "en"
        },
        {
          "title": "Português",
          "value": "pt"
        }
      ]
    }
  ],
  "commands": [
    {
      "name": "menu-bar",
      "title": "Friends Menu Bar",
      "description": "Show your friends and their local times in the menu bar.",
      "mode": "menu-bar",
      "interval": "1m"
    },
    {
      "name": "add-friend",
      "title": "Add Friend",
      "description": "Add a friend with their timezone and photo.",
      "mode": "view"
    },
    {
      "name": "manage-friends",
      "title": "Manage Friends",
      "description": "View, edit and delete your friends.",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.79.0",
    "@raycast/utils": "^1.17.0",
    "city-timezones": "^1.3.4",
    "jimp": "^0.22.12"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.11",
    "@types/node": "20.8.10",
    "@types/react": "19.0.10",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "typescript": "^5.4.5"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}
