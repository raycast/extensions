{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "change-scroll-direction",
  "title": "Change Scroll Direction",
  "description": "Changes between the two scroll directions „natural“ and „mouse-friendly“. Useful when switching between trackpad and mouse.",
  "icon": "command-icon.png",
  "author": "gregoralbrecht",
  "contributors": [
    "emilsharier",
    "michaelhaar",
    "oh.cactus"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "changeScrollDirection",
      "title": "Change Scroll Direction",
      "description": "Switches between \"natural\" and \"mouse-friendly.\"",
      "mode": "no-view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^2.3.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.1.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.2",
    "eslint": "^10.0.1",
    "jest": "^30.5.1",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "test": "jest --verbose",
    "test:watch": "jest --watch",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint"
  },
  "platforms": [
    "macOS"
  ]
}
