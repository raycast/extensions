{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "stock-tracker",
  "title": "Stock Tracker",
  "description": "Track and monitor your stock portfolio. Search stocks across multiple markets and manage watchlists.",
  "icon": "extension-icon.png",
  "author": "Enciyo",
  "contributors": ["ericchernuka", "kristoffermelen"],
  "categories": ["Finance", "Productivity"],
  "license": "MIT",
  "commands": [
    {
      "name": "search-stocks",
      "title": "Search Stocks",
      "subtitle": "Stock Tracker",
      "description": "Search for stocks and add them to your watchlist",
      "mode": "view",
      "icon": "search-icon.png",
      "keywords": ["stock", "search", "find", "ticker", "watchlist", "portfolio", "market"]
    },
    {
      "name": "watchlist",
      "title": "Watchlist",
      "subtitle": "Stock Tracker",
      "description": "View and manage your stock watchlists",
      "mode": "view",
      "icon": "watchlist-icon.png",
      "keywords": ["watchlist", "portfolio", "stocks", "list", "track", "monitor"]
    }
  ],
  "preferences": [
    {
      "name": "language",
      "type": "dropdown",
      "required": false,
      "title": "Language",
      "description": "Select application language",
      "default": "en",
      "data": [
        { "title": "Turkish", "value": "tr" },
        { "title": "English", "value": "en" }
      ]
    },
    {
      "name": "column1",
      "type": "dropdown",
      "required": false,
      "title": "1st Column",
      "description": "Select column to display in first position",
      "default": "price",
      "data": [
        { "title": "None", "value": "none" },
        { "title": "Price", "value": "price" },
        { "title": "Change %", "value": "change" },
        { "title": "Change", "value": "changeAbs" },
        { "title": "Volume", "value": "volume" },
        { "title": "Exchange", "value": "exchange" },
        { "title": "Market", "value": "market" }
      ]
    },
    {
      "name": "column2",
      "type": "dropdown",
      "required": false,
      "title": "2nd Column",
      "description": "Select column to display in second position",
      "default": "change",
      "data": [
        { "title": "None", "value": "none" },
        { "title": "Price", "value": "price" },
        { "title": "Change %", "value": "change" },
        { "title": "Change", "value": "changeAbs" },
        { "title": "Volume", "value": "volume" },
        { "title": "Exchange", "value": "exchange" },
        { "title": "Market", "value": "market" }
      ]
    },
    {
      "name": "column3",
      "type": "dropdown",
      "required": false,
      "title": "3rd Column",
      "description": "Select column to display in third position",
      "default": "volume",
      "data": [
        { "title": "None", "value": "none" },
        { "title": "Price", "value": "price" },
        { "title": "Change %", "value": "change" },
        { "title": "Change", "value": "changeAbs" },
        { "title": "Volume", "value": "volume" },
        { "title": "Exchange", "value": "exchange" },
        { "title": "Market", "value": "market" }
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.80.0",
    "@raycast/utils": "^1.16.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.11",
    "@types/node": "^20.8.10",
    "@types/react": "^18.2.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "ray publish"
  },
  "overrides": {
    "@types/react": "^18.2.0"
  }
}
