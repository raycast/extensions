{
  "$schema": "https://json.schemastore.org/tsconfig",
  "include": ["src/**/*", "tests/**/*", "raycast-env.d.ts"],
  "compilerOptions": {
    "lib": ["ES2023"],
    "module": "commonjs",
    "target": "ES2022",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "types": ["node", "react"],
    "strict": true,
    "isolatedModules": true,
    // node --test で .ts を直接実行できるよう、相対 import には拡張子を付けている
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true
  }
}
