{
  "extends": "./tsconfig.json",
  "include": ["companion/background.ts"],
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "types": ["firefox-webext-browser"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "moduleDetection": "legacy",
    "rootDir": "companion",
    "outDir": "dist/companion/extension",
    "noEmitOnError": true
  }
}
