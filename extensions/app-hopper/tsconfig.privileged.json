{
  "extends": "./tsconfig.json",
  "include": [
    "companion/zen-workspace-bridge/**/*.ts",
    "scripts/prototypes/**/*.ts",
    "tests/fixtures/zen-workspace-smoke.ts"
  ],
  "compilerOptions": {
    "types": [],
    "lib": ["ES2023", "DOM"],
    "module": "ES2022",
    "moduleDetection": "legacy",
    "rootDir": ".",
    "outDir": "dist/privileged",
    "noEmitOnError": true,
    "moduleResolution": "bundler"
  }
}
