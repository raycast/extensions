{
  "manifest_version": 2,
  "name": "App Hopper Companion",
  "version": "1.0.2",
  "description": "Show live Firefox and Zen tab URLs and switch tabs from App Hopper for Raycast.",
  "permissions": ["tabs", "nativeMessaging"],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "browser_action": {
    "default_title": "Reconnect to App Hopper"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "app-hopper-firefox@chenghsj",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
