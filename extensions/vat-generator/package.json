{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "vat-generator",
  "title": "VAT Generator",
  "description": "Generate valid-format (test) VAT numbers for countries worldwide.",
  "icon": "icon.png",
  "author": "hikmat",
  "categories": [
    "Developer Tools",
    "Finance"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "generate-vat",
      "title": "Generate VAT Number",
      "subtitle": "VAT Generator",
      "description": "Search a country and generate a valid-format test VAT number.",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.78.0",
    "@raycast/utils": "^1.17.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.11",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.16",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "typescript": "^5.4.5"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}
