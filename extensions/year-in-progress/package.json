{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "year-in-progress",
  "title": "Year in Progress",
  "description": "Stay motivated by see the progress of the year.",
  "icon": "icon.png",
  "author": "thomas",
  "contributors": [
    "anothertempore",
    "akshay_khade",
    "teemu_suvinen",
    "0xdhrv"
  ],
  "pastContributors": [
    "danulqua"
  ],
  "categories": [
    "Productivity",
    "Fun"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "show-year-progress",
      "title": "Year in Progress",
      "description": "Display the current year's progress in the command subtitle. Add to Favorites to keep it visible in Raycast.",
      "mode": "no-view",
      "interval": "4h"
    },
    {
      "name": "year-in-progress",
      "title": "Progress",
      "description": "Display the selected calendar or custom progress in the command subtitle.",
      "mode": "no-view",
      "interval": "4h"
    },
    {
      "name": "index",
      "title": "Show X in Progress in Menu Bar",
      "description": "Display X In Progress In Menu Bar",
      "mode": "menu-bar",
      "interval": "2m"
    },
    {
      "name": "x-in-progress",
      "title": "X in Progress",
      "description": "Display and manage X In Progress In Command",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "weekStartsOn",
      "description": "Week starts date",
      "type": "dropdown",
      "required": true,
      "title": "Week Starts On",
      "placeholder": "Monday",
      "data": [
        {
          "title": "Sunday",
          "value": "0"
        },
        {
          "title": "Monday",
          "value": "1"
        },
        {
          "title": "Tuesday",
          "value": "2"
        },
        {
          "title": "Wednesday",
          "value": "3"
        },
        {
          "title": "Thursday",
          "value": "4"
        },
        {
          "title": "Friday",
          "value": "5"
        },
        {
          "title": "Saturday",
          "value": "6"
        }
      ],
      "default": "1"
    }
  ],
  "dependencies": {
    "@raycast/api": "^2.6.2",
    "@raycast/utils": "^2.3.2",
    "date-fns": "^2.29.3"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.10",
    "eslint": "^10.12.0",
    "prettier": "^2.5.1",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "ray publish"
  },
  "platforms": [
    "macOS",
    "Windows"
  ]
}
