{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "babel-ipsum",
  "title": "Babel Ipsum",
  "description": "Generate placeholder text from 13 classic books in 12 languages. Copy or paste sentences and passages, entirely offline",
  "icon": "extension-icon.png",
  "author": "felrov",
  "platforms": [
    "macOS"
  ],
  "categories": [
    "Developer Tools"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.14.0"
  },
  "commands": [
    {
      "name": "generate-paragraphs",
      "title": "Generate Passages",
      "subtitle": "Babel Ipsum",
      "description": "Preview, copy, or paste random passages from classic books",
      "mode": "view"
    },
    {
      "name": "generate-sentences",
      "title": "Generate Sentences",
      "subtitle": "Babel Ipsum",
      "description": "Preview, copy, or paste random sentences from classic books",
      "mode": "view"
    }
  ],
  "tools": [],
  "dependencies": {
    "@raycast/api": "^2.9.0",
    "@raycast/utils": "^2.2.7"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "22.19.17",
    "@types/react": "19.0.10",
    "eslint": "^10.5.0",
    "prettier": "^3.8.5",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "node scripts/clean-build.mjs && ray build --output dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-strip-types --test tests/*.test.ts tests/*.test.mjs",
    "test:extraction": "python3 -m unittest discover -s tests -p '*_test.py'",
    "corpus:extract": "python3 scripts/extract-corpus.py && node scripts/prepare-sub-terra.mjs",
    "corpus:build": "node scripts/build-corpus.mjs",
    "corpus:fetch": "node scripts/fetch-corpus.mjs",
    "corpus:fetch:western": "python3 scripts/import-western.py --refresh",
    "corpus:fetch:multilingual": "python3 scripts/import-multilingual.py --fetch",
    "prepublishOnly": "echo \"\\n\\nIt seems like you are trying to publish the Raycast extension to npm.\\n\\nIf you did intend to publish it to npm, remove the \\`prepublishOnly\\` script and rerun \\`npm publish\\` again.\\nIf you wanted to publish it to the Raycast Store instead, use \\`npm run publish\\` instead.\\n\\n\" && exit 1",
    "publish": "npx @raycast/api@latest publish",
    "corpus:prepare:sub-terra": "node scripts/prepare-sub-terra.mjs",
    "corpus:extract:western": "python3 scripts/import-western.py --offline",
    "corpus:extract:multilingual": "python3 scripts/import-multilingual.py",
    "corpus:audit": "node scripts/audit-corpus.mjs && node scripts/prepare-sub-terra.mjs --check && python3 scripts/import-western.py --offline --check && python3 scripts/import-multilingual.py --audit",
    "artwork:build": "node scripts/build-artwork.mjs"
  },
  "preferences": [
    {
      "name": "defaultBook",
      "title": "Default Book",
      "description": "Book selected when opening either generator.",
      "type": "dropdown",
      "required": false,
      "default": "de-finibus",
      "data": [
        {
          "title": "De finibus bonorum et malorum — Liber I (Latin)",
          "value": "de-finibus"
