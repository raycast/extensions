{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "translatone",
  "description": "Translate text with the right tone for LinkedIn, email, and chat using free AI providers.",
  "categories": [
    "Communication",
    "Productivity"
  ],
  "license": "MIT",
  "author": "ayungavis",
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "lint": "ray lint",
    "fix-lint": "ray lint --fix",
    "typecheck": "tsc --noEmit",
    "test": "bun test && bun scripts/check-coverage.ts",
    "publish": "npx @raycast/api@latest publish"
  },
  "dependencies": {
    "@raycast/api": "^2.10.1",
    "@raycast/utils": "^2.3.3"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/bun": "^1.4.4",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "icon": "icon.png",
  "commands": [
    {
      "name": "translate",
      "title": "Translate",
      "subtitle": "TranslaTone",
      "description": "Translate text with a selected tone and target language.",
      "mode": "view"
    },
    {
      "name": "translate-selection",
      "title": "Translate Selection",
      "subtitle": "TranslaTone",
      "description": "Replace the selected text with its translation in your default tone. Opens Translate when nothing is selected.",
      "mode": "no-view"
    },
    {
      "name": "choose-model",
      "title": "Choose Model",
      "subtitle": "TranslaTone",
      "description": "Pick a model from your provider's model list. Overrides the model saved in Manage Providers.",
      "mode": "view"
    },
    {
      "name": "manage-providers",
      "title": "Manage Providers",
      "subtitle": "TranslaTone",
      "description": "Add, edit, test, enable or remove translation providers and choose your primary provider.",
      "mode": "view"
    }
  ],
  "platforms": [
    "macOS"
  ],
  "preferences": [
    {
      "name": "mainLanguage",
      "title": "Main Language",
      "description": "Text in any other language is translated into this one.",
      "type": "dropdown",
      "required": false,
      "default": "en",
