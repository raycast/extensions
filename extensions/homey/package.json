{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "homey",
  "title": "Homey",
  "description": "Homey Flows & Devices",
  "icon": "8502422.png",
  "author": "DominicVonk",
  "categories": [
    "Productivity"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "flows",
      "title": "Homey Flows",
      "description": "Show Homey Flows",
      "mode": "view",
      "icon": "8502422.png"
    },
    {
      "name": "devices",
      "title": "Homey Devices",
      "description": "Show Homey Devices",
      "mode": "view",
      "icon": "8502422.png"
    }
  ],
  "tools": [
    {
      "name": "homey-exec",
      "title": "Homey Execute",
      "description": "Execute a Homey action",
      "icon": "8502422.png"
    },
    {
      "name": "homey-devices",
      "title": "Homey Devices",
      "description": "Get Homey Devices with their name and id",
      "icon": "8502422.png"
    },
    {
      "name": "homey-flows",
      "title": "Homey Flows",
      "description": "Get Homey Flows with their name and id and advanced flag",
      "icon": "8502422.png"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.103.6",
    "@raycast/utils": "^2.2.2",
    "homey-api": "3.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "eslint": "^9.39.1",
    "prettier": "^2.5.1",
    "react": "^19.2.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "ray publish"
  },
  "platforms": [
    "macOS",
    "Windows"
  ]
}
