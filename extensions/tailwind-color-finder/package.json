{                                                                             
    "name": "tailwind-color-finder",                                            
    "title": "Tailwind Color Finder",                                           
    "description": "Find the nearest Tailwind CSS color from any hex code",     
    "icon": "command-icon.png",                                                 
    "author": "feedain",                                                        
    "categories": ["Developer Tools", "Design Tools"],                          
    "license": "MIT",                                                           
    "commands": [                                                               
      {                                                                         
        "name": "find-tailwind-color",                                          
        "title": "Find Tailwind Color",                                         
        "subtitle": "Tailwind CSS",                                             
        "description": "Convert a hex color to the nearest Tailwind color",     
        "mode": "view",                                                         
        "arguments": [                                                          
          {                                                                     
            "name": "hexColor",                                                 
            "type": "text",                                                     
            "placeholder": "#ff5733",                                           
            "required": false                                                   
          }                                                                     
        ],                                                                      
        "preferences": [                                                        
          {                                                                     
            "name": "autoClipboard",                                            
            "type": "checkbox",                                                 
            "default": true,                                                    
            "title": "Auto-detect clipboard",                                   
            "description": "Automatically use hex color from clipboard if       
  available",                                                                   
            "required": false                                                   
          },                                                                    
          {                                                                     
            "name": "tailwindVersion",                                          
            "type": "dropdown",                                                 
            "default": "v4",                                                    
            "title": "Tailwind Version",                                        
            "description": "Choose which Tailwind color palette to use",        
            "required": false,                                                  
            "data": [                                                           
              { "title": "Tailwind v4 (latest)", "value": "v4" },               
              { "title": "Tailwind v3.4", "value": "v3" }                       
            ]                                                                   
          }                                                                     
        ]                                                                       
      }                                                                         
    ],                                                                          
    "dependencies": {                                                           
      "@raycast/api": "^1.64.0",                                                
      "@raycast/utils": "^1.10.0"                                               
    },                                                                          
    "devDependencies": {                                                        
      "@raycast/eslint-config": "^1.0.8",                                       
      "@types/node": "~20.8.10",                                                
      "eslint": "^8.54.0",                                                      
      "prettier": "^3.1.0",                                                     
      "typescript": "^5.2.2"                                                    
    },                                                                          
    "scripts": {                                                                
      "build": "ray build -e dist",                                             
      "dev": "ray develop",                                                     
      "fix-lint": "ray lint --fix",                                             
      "lint": "ray lint",                                                       
      "publish": "npx @raycast/api@latest publish"                              
    }                                                                           
  }
