{
  "compilerOptions": {
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "noEmit": true,
    "outDir": "dist",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "ES2022",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "paths": {
      "react": ["./node_modules/@raycast/api/node_modules/@types/react"]
    }
  },
  "include": ["src/**/*"]
}
