{
  "name": "totp",
  "version": "1.0.0",
  "description": "Generate and copy time-based one-time passwords.",
  "main": "src/index.tsx",
  "type": "module",
  "author": "brianvu",
  "license": "MIT",
  "scripts": {
    "dev": "ray develop",
    "build": "ray build",
    "lint": "ray lint",
    "test": "node --experimental-strip-types --experimental-specifier-resolution=node src/totp.test.ts",
    "publish": "npx @raycast/api@latest publish"
  },
  "dependencies": {
    "@raycast/api": "1.104.24"
  },
  "devDependencies": {
    "@types/node": "22.19.17",
    "@types/react": "19.0.10"
  },
  "title": "TOTP",
  "icon": "totp-icon.png",
  "categories": ["Security"],
  "platforms": ["macOS"],
  "commands": [
      {
        "name": "index",
        "title": "TOTP",
        "description": "Copy a saved time-based one-time password.",
        "mode": "view",
        "keywords": ["otp", "2fa", "authenticator"]
      },
      {
        "name": "quick-otp",
        "title": "Quick OTP",
        "description": "Generate a one-time password without saving it.",
        "mode": "view",
        "keywords": ["totp", "2fa", "authenticator"]
      }
  ]
}
