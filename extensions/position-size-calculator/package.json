{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "position-size-calculator",
  "title": "Position Size Calculator",
  "description": "Calculate trading position size from your capital, risk per trade, stop loss and target levels to manage risk.",
  "icon": "extension-icon.png",
  "author": "akhilesh_dalvi",
  "categories": [
    "Finance",
    "Productivity"
  ],
  "license": "MIT",
  "preferences": [
    {
      "name": "capital",
      "title": "Trading Capital",
      "description": "Your default trading capital.",
      "type": "textfield",
      "required": true,
      "default": "200000"
    },
    {
      "name": "riskPercent",
      "title": "Risk per Trade (%)",
      "description": "Your default risk percentage per trade.",
      "type": "textfield",
      "required": true,
      "default": "1.0"
    },
    {
      "name": "currencyCode",
      "title": "Currency",
      "description": "Select your preferred currency for display.",
      "type": "dropdown",
      "required": true,
      "default": "USD",
      "data": [
        {
          "title": "🇺🇸 $ USD - US Dollar",
          "value": "USD"
        },
        {
          "title": "🇮🇳 ₹ INR - Indian Rupee",
          "value": "INR"
        },
        {
          "title": "🇪🇺 € EUR - Euro",
          "value": "EUR"
        },
        {
          "title": "🇯🇵 ¥ JPY - Japanese Yen",
          "value": "JPY"
        },
        {
          "title": "🇬🇧 £ GBP - British Pound",
          "value": "GBP"
        },
        {
          "title": "🇦🇺 A$ AUD - Australian Dollar",
          "value": "AUD"
        },
        {
          "title": "🇨🇦 C$ CAD - Canadian Dollar",
          "value": "CAD"
        },
        {
          "title": "🇨🇭 CHF CHF - Swiss Franc",
          "value": "CHF"
        },
        {
          "title": "🇨🇳 ¥ CNY - Chinese Yuan Renminbi",
          "value": "CNY"
        },
        {
          "title": "🇭🇰 HK$ HKD - Hong Kong Dollar",
          "value": "HKD"
        },
        {
          "title": "🇰🇷 ₩ KRW - South Korean Won",
          "value": "KRW"
        },
        {
          "title": "🇸🇬 S$ SGD - Singapore Dollar",
          "value": "SGD"
        },
        {
          "title": "🇳🇿 NZ$ NZD - New Zealand Dollar",
          "value": "NZD"
        },
        {
          "title": "🇧🇷 R$ BRL - Brazilian Real",
          "value": "BRL"
        },
        {
          "title": "🇷🇺 ₽ RUB - Russian Ruble",
          "value": "RUB"
        },
        {
          "title": "🇿🇦 R ZAR - South African Rand",
          "value": "ZAR"
        }
      ]
    }
  ],
  "commands": [
    {
      "name": "index",
      "title": "Calculate Position Size",
      "description": "Calculates position size based on different modes.",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.97.1",
    "@raycast/utils": "^1.17.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.4",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "prepublishOnly": "echo \"\\n\\nIt seems like you are trying to publish the Raycast extension to npm.\\n\\nIf you did intend to publish it to npm, remove the \\`prepublishOnly\\` script and rerun \\`npm publish\\` again.\\nIf you wanted to publish it to the Raycast Store instead, use \\`npm run publish\\` instead.\\n\\n\" && exit 1",
    "publish": "npx @raycast/api@latest publish"
  }
}
