{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "text-replacement-manager",
  "title": "Text Replacement Manager",
  "description": "Manage macOS Text Replacements from Raycast.",
  "icon": "command-icon.png",
  "author": "maxludden",
  "license": "MIT",
  "categories": [
    "Productivity"
  ],
  "platforms": [
    "macOS"
  ],
  "commands": [
    {
      "name": "manage-replacements",
      "title": "Manage Text Replacements",
      "description": "View, create, edit, clone, delete, import, and export macOS Text Replacements.",
      "mode": "view"
    }
  ],
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@raycast/api": "^1.98.5",
    "@raycast/utils": "^1.18.1",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.1.1",
    "@types/node": "^22.15.21",
    "@types/react": "^19.2.15",
    "eslint": "^9.39.4",
    "prettier": "^3.8.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
