{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "rg-adguard-links",
  "title": "RG AdGuard Links",
  "description": "Convert Microsoft Store URLs to rg-adguard.net download links",
  "icon": "icon.png",
  "author": "jergensturdley",
  "license": "MIT",
  "commands": [
    {
      "name": "convert-url",
      "title": "Convert Store URL",
      "description": "Convert Microsoft Store URL to rg-adguard.net link",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.83.2",
    "@raycast/utils": "^1.17.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.11",
    "@types/node": "20.8.10",
    "@types/react": "19.0.10",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}
