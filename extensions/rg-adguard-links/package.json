{
  "name": "rg-adguard-links",
  "version": "1.0.0",
  "title": "RG AdGuard Links",
  "description": "Browse and open AdGuard filter list resources (official + community).",
  "icon": "icon.png",
  "author": "jergensturdley",
  "license": "MIT",
  "categories": ["Developer Tools"],
  "keywords": ["adguard", "filters", "privacy", "blocklists"],
  "repository": "https://github.com/jergensturdley/raycast-extensions",
  "commands": [
    {
      "name": "adguard-links",
      "title": "AdGuard Links",
      "subtitle": "AdGuard",
      "description": "Search and open AdGuard filter lists",
      "mode": "view"
    },
    {
      "name": "refresh-adguard-index",
      "title": "Refresh AdGuard Index",
      "subtitle": "AdGuard",
      "description": "Refresh cached filter list metadata",
      "mode": "no-view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.103.6"
  },
  "devDependencies": {
    "@types/node": "^20.8.10",
    "@types/react": "^18.2.0",
    "typescript": "^5.3.0"
  }
}
