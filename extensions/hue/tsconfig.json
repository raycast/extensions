{
  "$schema": "https://json.schemastore.org/tsconfig",
  "include": [
    "src/**/*",
    "raycast-env.d.ts"
  ],
  "compilerOptions": {
    "lib": ["es2024"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2024",
    "types": ["node"],
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "jsx": "react-jsx"
  }
}
