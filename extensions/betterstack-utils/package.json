{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "betterstack-utils",
  "title": "BetterStack Utils",
  "description": "View your BetterStack Primary on-call schedule",
  "icon": "extension-icon.png",
  "author": "doktor500",
  "categories": [
    "Productivity"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "on-call-schedule",
      "title": "On Call Schedule",
      "description": "Shows a 3-month on-call grid for the Primary schedule",
      "mode": "view"
    },
    {
      "name": "create-incident",
      "title": "Create Incident",
      "description": "File a new BetterStack incident",
      "mode": "view"
    },
    {
      "name": "incidents",
      "title": "Incidents",
      "description": "View and manage active incidents",
      "mode": "view"
    },
    {
      "name": "status-pages",
      "title": "Status Pages",
      "description": "View your BetterStack status pages and open them in the browser",
      "mode": "view"
    },
    {
      "name": "monitors",
      "title": "Monitors",
      "description": "View your BetterStack monitors and open them in the browser",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "apiToken",
      "title": "API Token",
      "description": "Your BetterStack API token",
      "type": "password",
      "required": true
    },
    {
      "name": "teamId",
      "title": "Team Id",
      "description": "Your BetterStack team Id. Find it in the URL when viewing your on-call schedule: uptime.betterstack.com/team/t{id}/oncalls",
      "type": "textfield",
      "required": false
    },
    {
      "name": "requesterEmail",
      "title": "Requester Email",
      "description": "Default e-mail used when creating incidents",
      "type": "textfield",
      "required": false
    }
  ],
  "dependencies": {
    "@raycast/api": "^2.6.2",
    "@tanstack/react-query": "^5.104.1",
    "clsx": "^2.1.1",
    "harfbuzzjs": "file:./vendor/harfbuzzjs",
    "luxon": "^3.7.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "satori": "^0.35.0",
    "tailwind-merge": "^3.7.0",
    "ts-pattern": "^5.9.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "~26.6.4",
    "@types/react": "~19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-7": "npm:typescript@~7.0.2",
    "vitest": "^5.0.3",
    "vitest-tsconfig-paths": "^3.4.1"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "harfbuzzjs": "$harfbuzzjs"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "lint": "ray lint",
    "fix-lint": "ray lint --fix",
    "publish": "npx @raycast/api@latest publish",
    "ts:check": "node node_modules/typescript-7/bin/tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "platforms": [
    "macOS"
  ]
}
