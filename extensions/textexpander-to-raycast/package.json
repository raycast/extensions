{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "textexpander-to-raycast",
  "title": "TextExpander to Raycast",
  "description": "Review, edit, and combine TextExpander snippets for import into Raycast.",
  "icon": "extension-icon.png",
  "author": "0xdhrv",
  "license": "MIT",
  "categories": [
    "Productivity"
  ],
  "platforms": [
    "macOS"
  ],
  "commands": [
    {
      "name": "convert-snippets",
      "title": "Convert TextExpander Snippets",
      "description": "Combine TextExpander exports, edit snippets, resolve keyword conflicts, and export Raycast JSON with a migration report.",
      "mode": "view",
      "keywords": [
        "migrate",
        "import",
        "text expansion"
      ]
    }
  ],
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "lint": "ray lint",
    "fix-lint": "ray lint --fix",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm test && npm run typecheck && npm run lint && npm run build",
    "publish": "npx @raycast/api@latest publish"
  },
  "dependencies": {
    "@raycast/api": "^2.10.1",
    "@raycast/utils": "^2.3.3",
    "csv-parse": "^7.0.3",
    "plist": "^3.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.1.1",
    "@types/node": "26.6.5",
    "@types/plist": "^3.0.5",
    "@types/react": "19.3.0",
    "eslint": "^9.39.1",
    "prettier": "^3.8.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.22.2"
  }
}
