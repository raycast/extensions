{
  "theme": {
    "$type": "color",
    "bg": {
      "default": { "$value": "{color.white}" },
      "subtle": { "$value": "{color.gray.50}" },
      "muted": { "$value": "{color.gray.100}" },
      "inverse": { "$value": "{color.black}" }
    },
    "text": {
      "default": { "$value": "{color.gray.900}" },
      "muted": { "$value": "{color.gray.600}" },
      "inverse": { "$value": "{color.white}" },
      "link": { "$value": "{color.brand.600}" }
    },
    "border": {
      "default": { "$value": "{color.gray.200}" },
      "strong": { "$value": "{color.gray.400}" },
      "focus": { "$value": "{color.brand.400}" }
    },
    "accent": {
      "primary": { "$value": "{color.brand.500}" },
      "success": { "$value": "{color.green.500}" },
      "warning": { "$value": "{color.amber.400}" },
      "danger": { "$value": "{color.red.500}" }
    },
    "overlay": { "$value": "rgba(11, 11, 18, 0.64)" }
  }
}
