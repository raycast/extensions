{
  "shadow": {
    "$type": "shadow",
    "sm": {
      "$value": {
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0px",
        "color": "rgba(11, 11, 18, 0.12)"
      }
    },
    "md": {
      "$value": {
        "offsetX": "0px",
        "offsetY": "4px",
        "blur": "8px",
        "spread": "-2px",
        "color": "rgba(11, 11, 18, 0.16)"
      }
    },
    "lg": {
      "$value": [
        { "offsetX": "0px", "offsetY": "12px", "blur": "24px", "spread": "-4px", "color": "rgba(11, 11, 18, 0.18)" },
        { "offsetX": "0px", "offsetY": "2px", "blur": "6px", "spread": "0px", "color": "rgba(11, 11, 18, 0.08)" }
      ]
    },
    "focus": {
      "$value": { "offsetX": "0px", "offsetY": "0px", "blur": "0px", "spread": "3px", "color": "{color.brand.300}" }
    }
  },
  "duration": {
    "$type": "duration",
    "fast": { "$value": "120ms" },
    "base": { "$value": "200ms" },
    "slow": { "$value": "320ms" }
  },
  "opacity": {
    "$type": "number",
    "disabled": { "$value": 0.4 },
    "overlay": { "$value": 0.64 }
  }
}
