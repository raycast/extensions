{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "loop-window-control",
  "title": "Loop Window Control",
  "description": "Control Loop window management from Raycast using its native URL scheme.",
  "icon": "extension-icon.png",
  "author": "zwjacl",
  "license": "MIT",
  "categories": [
    "Productivity",
    "System"
  ],
  "platforms": [
    "macOS"
  ],
  "commands": [
    {
      "name": "window-actions",
      "title": "Window Actions",
      "description": "Search and run Loop window actions",
      "mode": "view",
      "subtitle": "Loop"
    },
    {
      "name": "run-keybind",
      "title": "Run Named Keybind",
      "description": "Run a named custom layout, cycle, or stash configured in Loop",
      "mode": "no-view",
      "arguments": [
        {
          "name": "name",
          "type": "text",
          "placeholder": "Exact name in Loop",
          "required": true
        }
      ],
      "subtitle": "Loop"
    },
    {
      "name": "setup",
      "title": "Check Installation",
      "description": "Check Loop installation and troubleshoot window actions",
      "mode": "view",
      "subtitle": "Loop"
    },
    {
      "name": "left-half",
      "title": "Left Half",
      "description": "Left Half using Loop",
      "mode": "no-view",
      "subtitle": "Loop"
    },
    {
      "name": "right-half",
      "title": "Right Half",
      "description": "Right Half using Loop",
      "mode": "no-view",
      "subtitle": "Loop"
    },
    {
      "name": "top-half",
      "title": "Top Half",
      "description": "Top Half using Loop",
      "mode": "no-view",
      "subtitle": "Loop"
    },
    {
      "name": "bottom-half",
      "title": "Bottom Half",
      "description": "Bottom Half using Loop",
      "mode": "no-view",
      "subtitle": "Loop"
    },
    {
      "name": "maximize",
      "title": "Maximize",
      "description": "Maximize using Loop",
      "mode": "no-view",
      "subtitle": "Loop"
    },
    {
      "name": "center",
      "title": "Center",
      "description": "Center using Loop",
      "mode": "no-view",
      "subtitle": "Loop"
    },
    {
      "name": "undo",
      "title": "Undo",
      "description": "Undo using Loop",
      "mode": "no-view",
      "subtitle": "Loop"
    },
    {
      "name": "next-screen",
      "title": "Next Screen",
      "description": "Next Screen using Loop",
      "mode": "no-view",
      "subtitle": "Loop"
    },
    {
      "name": "previous-screen",
      "title": "Previous Screen",
      "description": "Previous Screen using Loop",
      "mode": "no-view",
      "subtitle": "Loop"
    }
  ],
  "preferences": [
    {
      "name": "appPath",
      "type": "textfield",
      "title": "Loop Application Path",
      "description": "Path to Loop.app. Supports ~/Applications/Loop.app.",
      "required": false,
      "default": "/Applications/Loop.app",
      "placeholder": "/Applications/Loop.app"
    },
    {
      "name": "focusDelay",
      "type": "dropdown",
      "title": "Focus Restore Delay",
      "description": "Wait after closing Raycast before sending the window action.",
      "required": false,
      "default": "250",
      "data": [
        {
          "title": "150 ms",
          "value": "150"
        },
        {
          "title": "250 ms",
          "value": "250"
        },
        {
          "title": "500 ms",
          "value": "500"
        },
        {
          "title": "800 ms",
          "value": "800"
        }
      ]
    }
  ],
  "scripts": {
    "dev": "ray develop",
    "build": "ray build -e dist",
    "typecheck": "tsc --noEmit",
    "lint": "ray lint",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write .",
    "publish": "npx @raycast/api@latest publish",
    "fix-lint": "ray lint --fix"
  },
  "dependencies": {
    "@raycast/api": "^2.4.1"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0",
    "tsx": "^4.20.0"
  },
  "engines": {
    "node": ">=22.22.2"
  }
}
