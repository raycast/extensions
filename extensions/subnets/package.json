{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "subnets",
  "title": "Subnet Calculator",
  "description": "Break down an IPv4 or IPv6 subnet and jump to its halves, neighbors, and supernet without retyping the CIDR.",
  "icon": "icon.png",
  "author": "don.draper",
  "platforms": ["macOS"],
  "categories": ["Developer Tools"],
  "license": "MIT",
  "commands": [
    {
      "name": "subnet",
      "title": "Subnet Calculator",
      "description": "Break down an IPv4 or IPv6 subnet and walk through neighboring blocks.",
      "mode": "view",
      "keywords": ["cidr", "ip", "ipv4", "ipv6", "netmask", "network", "prefix"],
      "arguments": [
        {
          "name": "cidr",
          "type": "text",
          "placeholder": "10.0.0.0/16",
          "required": false
        }
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^2.4.1",
    "@raycast/utils": "^2.3.1"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "22.19.17",
    "@types/react": "19.0.10",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "lint": "ray lint",
    "fix-lint": "ray lint --fix",
    "test": "node --test tests/*.test.ts",
    "publish": "npx @raycast/api@latest publish"
  }
}
