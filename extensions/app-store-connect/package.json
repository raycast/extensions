{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "app-store-connect",
  "title": "App Store Connect",
  "description": "Perform tasks from App Store Connect",
  "icon": "icon.png",
  "author": "johanthorell",
  "contributors": [
    "danilorequena",
    "chrismessina"
  ],
  "categories": [
    "Developer Tools"
  ],
  "keywords": [
    "app store connect",
    "apple",
    "ios",
    "asc"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "appStatus",
      "title": "View App Status",
      "subtitle": "App Store Connect",
      "description": "Display app statuses and release versions pending developer release",
      "mode": "view"
    },
    {
      "name": "testFlightBuilds",
      "title": "Manage Builds",
      "subtitle": "App Store Connect",
      "description": "Show and manage builds",
      "mode": "view"
    },
    {
      "name": "testInformation",
      "title": "Edit Test Information",
      "subtitle": "App Store Connect",
      "description": "Edit test information",
      "mode": "view"
    },
    {
      "name": "showGroups",
      "title": "Manage Beta Groups",
      "subtitle": "App Store Connect",
      "description": "Show and manage beta groups",
      "mode": "view"
    },
    {
      "name": "teamMembers",
      "title": "Manage Team Members",
      "subtitle": "App Store Connect",
      "description": "Show and manage team members",
      "mode": "view"
    },
    {
      "name": "manageTeams",
      "title": "Manage API Keys",
      "subtitle": "App Store Connect",
      "description": "Add, switch between, and remove App Store Connect API keys",
      "mode": "view",
      "keywords": [
        "teams",
        "manage teams",
        "credentials",
        "sign in",
        "sign out"
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^2.0.6",
    "@raycast/utils": "^2.3.0",
    "jose": "^6.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.8",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "prepublishOnly": "echo \"\\n\\nIt seems like you are trying to publish the Raycast extension to npm.\\n\\nIf you did intend to publish it to npm, remove the \\`prepublishOnly\\` script and rerun \\`npm publish\\` again.\\nIf you wanted to publish it to the Raycast Store instead, use \\`npm run publish\\` instead.\\n\\n\" && exit 1",
    "publish": "npx @raycast/api@latest publish",
    "test": "node --experimental-strip-types --test src/Utils/*.test.ts"
  },
  "platforms": [
    "macOS"
  ]
}
