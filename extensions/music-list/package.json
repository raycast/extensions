{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "music-list",
  "title": "Music List",
  "description": "Music List Shortcut",
  "icon": "extension-icon.png",
  "license": "MIT",
  "commands": [
    {
      "name": "ff",
      "title": "ff",
      "description": "Browse and search your local music files",
      "mode": "view",
      "subtitle": "Local library browser",
      "keywords": [
        "music",
        "song",
        "songs",
        "audio",
        "mp3",
        "flac",
        "library"
      ]
    }
  ],
  "preferences": [
    {
      "name": "musicFolder",
      "type": "directory",
      "required": true,
      "title": "Music Folder",
      "description": "Single folder path"
    },
    {
      "name": "audioExtensions",
      "type": "textfield",
      "required": true,
      "title": "Audio Extensions",
      "description": "Comma-separated extensions, e.g. .mp3,.flac,.wav,.ogg",
      "default": ".mp3,.flac,.wav,.ogg"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.103.0",
    "@raycast/utils": "^2.2.1",
    "music-metadata": "^11.12.3"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.4",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "dev": "ray develop",
    "lint": "ray lint",
    "fix-lint": "ray lint --fix",
    "build": "ray build",
    "publish": "npx @raycast/api@latest publish",
    "prepublishOnly": "echo \"\\n\\nIt seems like you are trying to publish the Raycast extension to npm.\\n\\nIf you did intend to publish it to npm, remove the \\`prepublishOnly\\` script and rerun \\`npm publish\\` again.\\nIf you wanted to publish it to the Raycast Store instead, use \\`npm run publish\\` instead.\\n\\n\" && exit 1"
  },
  "author": "quo-len",
  "platforms": [
    "Windows"
  ],
  "categories": [
    "Media",
    "Fun"
  ]
}
