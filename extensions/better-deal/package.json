{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "better-deal",
  "title": "Better Deal",
  "description": "Compare unit prices of two products by price, quantity and size to find the better deal, and keep a history of past comparisons.",
  "icon": "extension_icon.png",
  "author": "juxtdesigncc",
  "categories": [
    "Productivity",
    "Finance"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "index",
      "title": "Calculate Better Deal",
      "description": "Add new deal to compare",
      "mode": "view",
      "arguments": [
        {
          "name": "price",
          "type": "text",
          "placeholder": "Cost",
          "required": true
        },
        {
          "name": "quantity",
          "type": "text",
          "placeholder": "Quantity",
          "required": true
        },
        {
          "name": "unitSize",
          "type": "text",
          "placeholder": "Unit Size",
          "required": false
        }
      ]
    },
    {
      "name": "view",
      "title": "View Better Deal History",
      "description": "View previous deals for comparison",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.67.1"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.6",
    "@types/node": "20.8.10",
    "@types/react": "18.2.27",
    "eslint": "^8.51.0",
    "prettier": "^3.0.3",
    "typescript": "^5.2.2"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}
