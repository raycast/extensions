{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "strudel",
  "title": "Strudel",
  "description": "Evaluate Strudel live-coding patterns",
  "icon": "extension-icon.png",
  "author": "0xdhrv",
  "platforms": [
    "macOS",
    "Windows"
  ],
  "categories": [
    "Fun"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "evaluate",
      "title": "Evaluate",
      "description": "Evaluate Strudel code",
      "mode": "view"
    },
    {
      "name": "playground",
      "title": "Playground",
      "description": "Play saved Strudel patterns together",
      "mode": "view",
      "preferences": [
        {
          "name": "defaultCpm",
          "title": "Default CPM",
          "description": "Default cycles per minute when the playground opens",
          "type": "dropdown",
          "required": false,
          "default": "60",
          "data": [
            {
              "title": "30 cpm",
              "value": "30"
            },
            {
              "title": "45 cpm",
              "value": "45"
            },
            {
              "title": "60 cpm",
              "value": "60"
            },
            {
              "title": "90 cpm",
              "value": "90"
            },
            {
              "title": "120 cpm",
              "value": "120"
            },
            {
              "title": "150 cpm",
              "value": "150"
            },
            {
              "title": "180 cpm",
              "value": "180"
            }
          ]
        },
        {
          "name": "defaultCycles",
          "title": "Default Cycles",
          "description": "Number of cycles to render per pattern",
          "type": "textfield",
          "required": false,
          "default": "2"
        },
        {
          "name": "loopPatterns",
          "title": "Loop Patterns",
          "description": "Loop patterns continuously instead of playing once",
          "type": "checkbox",
          "required": false,
          "default": true,
          "label": "Loop"
        }
      ]
    },
    {
      "name": "quickplay",
      "title": "Quick Play / Stop",
      "description": "Play the last-used pattern, or stop if already playing",
      "mode": "no-view"
    },
    {
      "name": "docs",
      "title": "Browse Docs",
      "description": "Browse Strudel reference documentation",
      "mode": "view"
    },
    {
      "name": "reference",
      "title": "Browse Reference",
      "description": "Browse Strudel function and API reference",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.13",
    "@raycast/utils": "^1.17.0",
    "@strudel/core": "^1.2.6",
    "@strudel/mini": "^1.2.6",
    "@strudel/transpiler": "^1.2.6",
    "@strudel/webaudio": "^1.3.0",
    "node-web-audio-api": "^1.0.9",
    "superdough": "^1.3.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.4",
    "@strudel/reference": "^1.2.2",
    "@types/node": "22.19.17",
    "@types/react": "19.0.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "postinstall": "node scripts/sync-native-assets.mjs",
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "prepublishOnly": "echo \"\\n\\nIt seems like you are trying to publish the Raycast extension to npm.\\n\\nIf you did intend to publish it to npm, remove the \\`prepublishOnly\\` script and rerun \\`npm publish\\` again.\\nIf you wanted to publish it to the Raycast Store instead, use \\`npm run publish\\` instead.\\n\\n\" && exit 1",
    "publish": "npx @raycast/api@latest publish",
    "update-reference": "npm install @strudel/reference@latest --save-dev"
  }
}
