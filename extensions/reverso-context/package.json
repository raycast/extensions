{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "reverso-context",
  "title": "Reverso Context",
  "description": "Translate words and phrases with Reverso Context and see example sentences in context and pronunciation.",
  "icon": "reverso-context.png",
  "author": "adielBm",
  "contributors": [
    "MrModest"
  ],
  "categories": [
    "Web",
    "Productivity"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "context",
      "title": "Translate",
      "subtitle": "Reverso Context",
      "description": "Get Translations, Pronunciation and Examples.",
      "mode": "view",
      "arguments": [
        {
          "name": "text",
          "placeholder": "Enter text",
          "type": "text",
          "required": true
        }
      ]
    }
  ],
  "preferences": [
    {
      "name": "correctLangPairDirection",
      "type": "checkbox",
      "required": true,
      "title": "Translation direction",
      "default": false,
      "description": "Corrects translation direction based on typed text language",
      "label": "Auto reverse direction"
    },
    {
      "name": "langFrom",
      "type": "dropdown",
      "required": true,
      "title": "From language",
      "default": "en",
      "description": "From language",
      "data": [
        {
          "title": "🇬🇧 English",
          "value": "en"
        },
        {
          "title": "🇩🇪 German",
          "value": "de"
        },
        {
          "title": "🇷🇺 Russian",
          "value": "ru"
        },
        {
          "title": "🇦🇪 Arabic",
          "value": "ar"
        },
        {
          "title": "🇪🇸 Spanish",
          "value": "es"
        },
        {
          "title": "🇫🇷 French",
          "value": "fr"
        },
        {
          "title": "🇮🇱 Hebrew",
          "value": "he"
        },
        {
          "title": "🇮🇹 Italian",
          "value": "it"
        },
        {
          "title": "🇯🇵 Japanese",
          "value": "ja"
        },
        {
          "title": "🇳🇱 Dutch",
          "value": "nl"
        },
        {
          "title": "🇵🇱 Polish",
          "value": "pl"
        },
        {
          "title": "🇵🇹 Portuguese",
          "value": "pt"
        },
        {
          "title": "🇷🇴 Romanian",
          "value": "ro"
        },
        {
          "title": "🇸🇪 Swedish",
          "value": "sv"
        },
        {
          "title": "🇹🇷 Turkish",
          "value": "tr"
        },
        {
          "title": "🇺🇦 Ukrainian",
          "value": "uk"
        },
        {
          "title": "🇨🇳 Chinese",
          "value": "zh"
        }
      ]
    },
    {
      "name": "langTo",
      "type": "dropdown",
      "required": true,
      "title": "To language",
      "default": "en",
      "description": "To language",
      "data": [
        {
          "title": "🇬🇧 English",
          "value": "en"
        },
        {
          "title": "🇩🇪 German",
          "value": "de"
        },
        {
          "title": "🇷🇺 Russian",
          "value": "ru"
        },
        {
          "title": "🇦🇪 Arabic",
          "value": "ar"
        },
        {
          "title": "🇪🇸 Spanish",
          "value": "es"
        },
        {
          "title": "🇫🇷 French",
          "value": "fr"
        },
        {
          "title": "🇮🇱 Hebrew",
          "value": "he"
        },
        {
          "title": "🇮🇹 Italian",
          "value": "it"
        },
        {
          "title": "🇯🇵 Japanese",
          "value": "ja"
        },
        {
          "title": "🇳🇱 Dutch",
          "value": "nl"
        },
        {
          "title": "🇵🇱 Polish",
          "value": "pl"
        },
        {
          "title": "🇵🇹 Portuguese",
          "value": "pt"
