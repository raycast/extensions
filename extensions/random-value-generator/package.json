{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "random-value-generator",
  "title": "Random Value Generator",
  "description": "Generate and copy commonly used random values.",
  "icon": "extension-icon.png",
  "author": "yac516joe",
  "categories": [
    "Developer Tools",
    "Productivity"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "generate-random-value",
      "title": "Generate Random Value",
      "description": "Generate dates, UUIDs, passwords, and other common values",
      "mode": "view"
    }
  ],
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint"
  },
  "dependencies": {
    "@raycast/api": "^1.100.3",
    "@raycast/utils": "^1.17.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.4",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "eslint": "^9.25.1",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3"
  }
}
