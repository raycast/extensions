{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "raynotes",
  "title": "Notes",
  "description": "Plain markdown notes in a folder you own",
  "icon": "icon.png",
  "author": "efekurucay",
  "categories": [
    "Productivity"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "quick-note",
      "title": "Quick Note",
      "subtitle": "Notes",
      "description": "Append a line to today's daily note",
      "mode": "no-view",
      "arguments": [
        {
          "name": "text",
          "placeholder": "Note",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "name": "new-note",
      "title": "New Note",
      "subtitle": "Notes",
      "description": "Write a new note",
      "mode": "view"
    },
    {
      "name": "notes",
      "title": "Notes",
      "description": "Browse and edit notes",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "notesDirectory",
      "title": "Notes Folder",
      "description": "Folder holding the markdown notes",
      "type": "directory",
      "required": false,
      "default": "~/notes"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.3"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.4",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "eslint": "^10.8.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "build": "ray build",
    "check": "npm run verify && npm run typecheck && npm run lint:code && npm run format:check && npm run build",
    "dev": "ray develop",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint:code && npm run format:check",
    "lint:code": "eslint src scripts --max-warnings 0",
    "lint:raycast": "ray lint",
    "typecheck": "tsc --noEmit",
    "verify": "node --experimental-strip-types --no-warnings scripts/verify.ts"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "jake": "12.10.1"
  }
}
