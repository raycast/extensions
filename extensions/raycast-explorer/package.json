{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "raycast-explorer",
  "title": "Raycast Explorer",
  "description": "Explore snippets, prompts, and custom themes from within Raycast.",
  "categories": [
    "Applications"
  ],
  "contributors": [
    "EvanZhouDev",
    "mil3na",
    "xilopaint",
    "samuelkraft",
    "abnershang",
    "zayadur",
    "0xdhrv"
  ],
  "icon": "extension-icon.png",
  "owner": "raycast",
  "access": "public",
  "author": "thomaslombart",
  "license": "MIT",
  "commands": [
    {
      "name": "explore-prompts",
      "title": "Explore Prompts",
      "icon": "prompts-icon.png",
      "description": "Find some inspiration in our AI prompts base.",
      "mode": "view"
    },
    {
      "name": "explore-presets",
      "title": "Explore Presets",
      "icon": "presets-icon.png",
      "description": "Find some inspiration in our AI Presets base.",
      "mode": "view"
    },
    {
      "name": "explore-quicklinks",
      "title": "Explore Quicklinks",
      "icon": "quicklinks-icon.png",
      "description": "Browse quicklinks",
      "mode": "view"
    },
    {
      "name": "explore-themes",
      "title": "Explore Themes",
      "icon": "themes-icon.png",
      "description": "Find some inspiration in our themes base.",
      "mode": "view"
    },
    {
      "name": "explore-snippets",
      "title": "Explore Snippets",
      "icon": "snippets-icon.png",
      "description": "Find some inspiration in our snippets base.",
      "mode": "view",
      "preferences": [
        {
          "name": "startModifier",
          "type": "dropdown",
          "data": [
            {
              "title": "!",
              "value": "!"
            },
            {
              "title": ":",
              "value": ":"
            },
            {
              "title": "_",
              "value": "_"
            },
            {
              "title": "__",
              "value": "__"
            },
            {
              "title": "-",
              "value": "-"
            },
            {
              "title": "@",
              "value": "@"
            },
            {
              "title": "@@",
              "value": "@@"
            },
            {
              "title": "$",
              "value": "$"
            },
            {
              "title": ";",
              "value": ";"
            },
            {
              "title": ";;",
              "value": ";;"
            },
            {
              "title": "/",
              "value": "/"
            },
            {
              "title": "//",
              "value": "//"
            },
            {
              "title": "none",
              "value": "none"
            }
          ],
          "default": "!",
          "required": false,
          "title": "Start Modifier",
          "description": "This modifiers is used as prefix for your snippets' keyword."
        },
        {
          "name": "endModifier",
          "type": "dropdown",
          "data": [
            {
              "title": "!",
              "value": "!"
            },
            {
              "title": ":",
              "value": ":"
            },
            {
              "title": "_",
              "value": "_"
            },
            {
              "title": "__",
              "value": "__"
            },
            {
              "title": "-",
              "value": "-"
            },
            {
              "title": "@",
              "value": "@"
            },
            {
              "title": "@@",
              "value": "@@"
            },
            {
              "title": "$",
              "value": "$"
            },
            {
              "title": ";",
              "value": ";"
            },
            {
              "title": ";;",
              "value": ";;"
            },
            {
              "title": "/",
              "value": "/"
            },
            {
              "title": "//",
              "value": "//"
            },
            {
              "title": "none",
              "value": "none"
            }
          ],
          "default": "none",
          "required": false,
          "title": "End Modifier",
          "description": "This modifiers is used as suffix for your snippets' keyword."
        }
      ]
    }
  ],
  "tools": [
    {
      "name": "search-library",
      "title": "Search Raycast Explorer",
      "description": "Search the public Raycast Explorer catalog for prompts, presets, Quicklinks, snippets, and themes. This tool is read-only and does not access the user's personal Raycast data."
    }
  ],
  "ai": {
    "instructions": "Use Search Raycast Explorer when the user wants a public prompt, preset, Quicklink template, snippet, or theme recommendation. It searches public ray.so catalog data only; never suggest that it can inspect, edit, delete, deduplicate, or replace the user's personal Quicklinks, Snippets, or Themes. Present relevant results with their importUrl as a Markdown link, and state when no suitable catalog result is found.",
    "evals": [
      {
        "input": "@raycast-explorer Find me a dark purple theme",
        "mocks": {
          "search-library": {
            "query": "dark purple",
            "contentType": "themes",
            "count": 1,
            "results": [
              {
                "type": "themes",
                "id": "example/purple-night",
                "title": "Purple Night",
                "summary": "dark theme by Example",
                "importUrl": "raycast://theme?name=Purple%20Night"
              }
            ]
          }
        },
        "expected": [
          {
            "callsTool": "search-library"
          },
          {
            "includes": "Purple Night"
          }
        ]
      },
      {
        "input": "@raycast-explorer Recommend a prompt template for release notes",
        "mocks": {
          "search-library": {
            "query": "release notes",
            "contentType": "prompts",
            "count": 1,
            "results": [
              {
                "type": "prompts",
                "id": "release-notes",
                "title": "Write Release Notes",
                "category": "Writing",
                "summary": "Create concise release notes from changes.",
                "importUrl": "raycast://prompts/import?prompts=example"
              }
            ]
          }
        },
        "expected": [
          {
            "callsTool": "search-library"
          },
          {
            "includes": "Write Release Notes"
          }
        ]
      }
    ]
  },
  "dependencies": {
    "@raycast/api": "^1.104.12",
    "@raycast/utils": "^2.2.3",
    "axios": "^1.15.1",
    "node-fetch": "^3.3.2",
    "remove-markdown": "^0.6.3"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.1.1",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/remove-markdown": "^0.3.4",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  },
  "platforms": [
    "macOS",
    "Windows"
  ]
}
