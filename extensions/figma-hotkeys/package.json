{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "figma-hotkeys",
  "title": "Figma Hotkeys",
  "description": "Search and view Figma keyboard shortcuts.",
  "icon": "icon.png",
  "author": "dylanjenkins",
  "platforms": [
    "Windows",
    "macOS"
  ],
  "categories": [
    "Productivity",
    "Documentation"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "index",
      "title": "Figma Hotkeys",
      "description": "Search and view Figma keyboard shortcuts",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.69.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.0",
    "@types/node": "20.10.0",
    "@types/react": "19.0.10",
    "eslint": "^8.56.0",
    "react": "19.0.0",
    "typescript": "^5.3.0",
    "sharp": "^0.33.0"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  },
  "keywords": [
    "figma",
    "shortcuts",
    "hotkeys",
    "keyboard",
    "reference"
  ]
}
