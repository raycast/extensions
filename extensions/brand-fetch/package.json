{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "brand-fetch",
  "title": "Brandfetch",
  "description": "⚡Get any websites brand logo in seconds (SVG, PNG)",
  "icon": "extension_icon.png",
  "author": "dilutedev",
  "contributors": [
    "muhammadrizo"
  ],
  "platforms": [
    "macOS",
    "Windows"
  ],
  "categories": [
    "Developer Tools",
    "Media"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "index",
      "title": "Fetch Brands",
      "subtitle": "Brandfetch",
      "description": "Fetch Images using BrandFetch API",
      "mode": "view",
      "preferences": [
        {
          "title": "BrandFetch API Key",
          "name": "bfApiKey",
          "description": "Key used to authenticate brand fetch api",
          "type": "password",
          "required": true
        },
        {
          "title": "Download Path",
          "name": "downloadPath",
          "description": "Choose where downloaded brand images are saved",
          "type": "directory",
          "required": false,
          "default": "~/Downloads"
        }
      ],
      "arguments": [
        {
          "name": "query",
          "required": true,
          "placeholder": "Type a brand name",
          "type": "text"
        }
      ]
    }
  ],
  "dependencies": {
    "@chrismessina/raycast-kit": "^0.2.0",
    "@raycast/api": "^2.8.2"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  },
  "allowScripts": {
    "esbuild": true
  }
}
