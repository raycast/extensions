      "mode": "no-view",
      "icon": "commands/transform.png",
      "keywords": [
        "transform",
        "instruction",
        "edit",
        "prompt",
        "rewrite"
      ],
      "arguments": [
        {
          "name": "instruction",
          "type": "text",
          "placeholder": "Instruction",
          "required": true
        }
      ]
    },
    {
      "name": "translate",
      "title": "Translate Selection",
      "description": "Open Translate with the selected text already translated, or empty when nothing is selected. Best with a hotkey.",
      "mode": "no-view",
      "icon": "commands/translate.png",
      "keywords": [
        "translate",
        "translator",
        "selection",
        "selected",
        "language"
      ]
    },
    {
      "name": "translator",
      "title": "Translate",
      "description": "Translate as you type, with dictionary entries for single words, text to speech and language suffixes such as “>de”.",
      "mode": "view",
      "icon": "commands/translator.png",
      "keywords": [
        "translate",
        "translator",
        "dictionary",
        "language"
      ],
      "arguments": [
        {
          "name": "text",
          "type": "text",
          "placeholder": "Text",
          "required": false
        }
      ]
    },
    {
      "name": "ask",
      "title": "Ask Claude",
      "description": "Chat with Claude; it searches the web when an answer needs current information.",
      "mode": "view",
      "icon": "commands/ask.png",
      "keywords": [
        "ask",
        "chat",
        "question",
        "claude",
        "ai"
      ],
      "arguments": [
        {
          "name": "question",
          "type": "text",
          "placeholder": "Question",
          "required": false
        }
      ]
    },
    {
      "name": "ask-selection",
      "title": "Ask About Selection",
      "description": "Ask a question about the selected text and keep chatting about it.",
      "mode": "view",
      "icon": "commands/ask-selection.png",
      "keywords": [
        "ask",
        "selection",
        "explain",
        "question"
      ],
      "arguments": [
        {
          "name": "question",
          "type": "text",
          "placeholder": "Question",
          "required": false
        }
      ]
    },
    {
      "name": "ai-commands",
      "title": "AI Commands",
      "description": "Run built-in and custom prompt commands on the selected text and add hotkeys to them with quicklinks.",
      "mode": "view",
      "icon": "commands/ai-commands.png",
      "keywords": [
        "commands",
        "prompts",
        "presets",
        "summarize",
        "custom"
      ]
    },
    {
      "name": "screen-translate",
      "title": "Translate Screen Area",
      "description": "Select an area of the screen and translate the text in it.",
      "mode": "no-view",
      "icon": "commands/screen-translate.png",
      "keywords": [
        "screenshot",
        "ocr",
        "translate",
        "screen",
        "image"
      ]
    },
    {
      "name": "screen-ask",
      "title": "Ask About Screen Area",
      "description": "Select an area of the screen and ask Claude about it.",
      "mode": "no-view",
      "icon": "commands/screen-ask.png",
      "keywords": [
        "screenshot",
        "vision",
        "image",
        "screen",
        "explain"
      ]
    },
    {
      "name": "screen-text",
      "title": "Copy Text from Screen",
      "description": "Select an area of the screen and copy the text in it.",
      "mode": "no-view",
      "icon": "commands/screen-text.png",
      "keywords": [
        "ocr",
        "screenshot",
        "text",
        "copy",
        "screen"
      ]
    },
    {
      "name": "page-summary",
      "title": "Summarize Web Page",
      "description": "Summarize the current browser tab and ask follow-up questions about it.",
      "mode": "view",
      "icon": "commands/page-summary.png",
      "keywords": [
        "browser",
        "page",
        "summarize",
        "tab",
        "web",
        "article"
      ]
    },
    {
      "name": "conversations",
      "title": "Search Conversations",
      "description": "Go back to earlier chats and continue where you left off.",
      "mode": "view",
      "icon": "commands/conversations.png",
      "keywords": [
        "history",
        "chats",
        "conversations"
      ]
    },
    {
      "name": "history",
      "title": "Search Edit History",
      "description": "Originals and results of your translations, fixes and AI commands.",
      "mode": "view",
      "icon": "commands/history.png",
      "keywords": [
        "history",
        "undo",
        "original",
        "edits"
      ]
    },
    {
      "name": "usage",
      "title": "Show Usage and Cost",
      "description": "Token usage and estimated spending by day, week, month and model.",
      "mode": "view",
      "icon": "commands/usage.png",
      "keywords": [
        "usage",
        "cost",
        "tokens",
        "billing",
        "spending"
      ]
    }
  ],
