{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "claude-writing-tools",
  "title": "Claude Writing Tools",
  "description": "Translate, fix and rewrite selected text in any app with Claude, plus chat, screenshot and web page tools, using your own Anthropic API key.",
  "icon": "icon.png",
  "author": "cofie",
  "categories": [
    "Productivity",
    "Developer Tools"
  ],
  "license": "MIT",
  "platforms": [
    "macOS"
  ],
  "commands": [
    {
      "name": "translate-replace",
      "title": "Translate and Replace",
      "description": "Translate the selected text in place: text in your primary language goes to your second language, anything else goes to your primary language.",
      "mode": "no-view",
      "icon": "commands/translate-replace.png",
      "keywords": [
        "translate",
        "replace",
        "selection",
        "language"
      ]
    },
