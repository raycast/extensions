{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "qrz-lookup",
  "title": "QRZ Lookup",
  "description": "Look up amateur radio callsigns on QRZ.com",
  "icon": "extension-icon.png",
  "author": "derJan",
  "platforms": [
    "macOS"
  ],
  "license": "MIT",
  "categories": [
    "Communication",
    "Web"
  ],
  "keywords": [
    "ham radio",
    "amateur radio",
    "callsign",
    "qrz",
    "qsl",
    "grid locator",
    "maidenhead"
  ],
  "commands": [
    {
      "name": "search-callsign",
      "title": "Search Callsign",
      "description": "Look up a callsign on QRZ.com",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "username",
      "type": "textfield",
      "required": true,
      "title": "QRZ Username",
      "description": "Your QRZ.com username (usually your callsign)"
    },
    {
      "name": "password",
      "type": "password",
      "required": true,
      "title": "QRZ Password",
      "description": "Your QRZ.com password"
    }
  ],
  "dependencies": {
    "@raycast/api": "^2.5.3",
    "@raycast/utils": "^2.3.2",
    "fast-xml-parser": "^5.11.2"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}
