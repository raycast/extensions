{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "dicelab",
  "title": "Dicelab",
  "description": "Roll dice with the Dicelab DSL. Full D&D 5e support with variables, probability charts, D&D Beyond import, and more.",
  "icon": "extension-icon.png",
  "author": "egeucak",
  "categories": [
    "Fun",
    "Productivity"
  ],
  "license": "MIT",
  "homepage": "https://try.dicelab.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/egeucak/raycast-dicelab-extension"
  },
  "commands": [
    {
      "name": "dicelab",
      "title": "Dicelab",
      "subtitle": "Dicelab",
      "description": "Roll dice or open the REPL - supports rolls and analysis",
      "mode": "view",
      "arguments": [
        {
          "name": "expression",
          "type": "text",
          "placeholder": "d20, 2d6+4, analyze 3d6, let str = 18",
          "required": false
        }
      ],
      "keywords": [
        "dice",
        "repl",
        "calculator",
        "roll",
        "analyze"
      ]
    },
    {
      "name": "aliases",
      "title": "View Aliases",
      "subtitle": "Dicelab",
      "description": "View and manage saved variables",
      "mode": "view",
      "keywords": [
        "variables",
        "aliases",
        "context"
      ]
    },
    {
      "name": "import-character",
      "title": "Import Character",
      "subtitle": "Dicelab",
      "description": "Import a D&D Beyond character",
      "mode": "view",
      "keywords": [
        "ddb",
        "dndbeyond",
        "character",
        "import"
      ]
    },
    {
      "name": "examples",
      "title": "Dicelab Examples",
      "subtitle": "Dicelab",
      "description": "Browse example dice expressions",
      "mode": "view",
      "keywords": [
        "examples",
        "help",
        "learn"
      ]
    },
    {
      "name": "history",
      "title": "Roll History",
      "subtitle": "Dicelab",
      "description": "View and re-roll past expressions",
      "mode": "view",
      "keywords": [
        "history",
        "recent"
      ]
    },
    {
      "name": "reset",
      "title": "Reset Context",
      "subtitle": "Dicelab",
      "description": "Clear all aliases and history",
      "mode": "no-view",
      "keywords": [
        "reset",
        "clear"
      ]
    },
    {
      "name": "fallback",
      "title": "Roll with Dicelab",
      "subtitle": "Dicelab",
      "description": "Roll dice or analyze expressions from root search",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.64.0",
    "@raycast/utils": "^1.10.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.8",
    "@types/node": "20.10.0",
    "@types/react": "19.0.10",
    "eslint": "^8.54.0",
    "typescript": "^5.3.2",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.11",
    "ts-jest": "^29.1.1"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "lint": "ray lint",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  }
}