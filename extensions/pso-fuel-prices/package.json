{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "pso-fuel-prices",
  "title": "PSO Fuel Prices",
  "description": "View today's PSO (Pakistan State Oil) fuel prices — Premier Euro 5, Hi-Cetane Diesel, Octane+, LPG and more.",
  "icon": "extension-icon.png",
  "author": "ahmad_daud",
  "categories": [
    "Finance",
    "Data"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "fuel-prices",
      "title": "Fuel Prices",
      "subtitle": "PSO",
      "description": "Show today's PSO fuel prices",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.83.1",
    "@raycast/utils": "^1.17.0",
    "cheerio": "^1.0.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.11",
    "@types/node": "22.19.17",
    "@types/react": "19.0.10",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "typescript": "^5.4.5"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}
