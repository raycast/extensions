{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "fainder",
  "title": "Fainder",
  "description": "Search and resume local AI agent conversations.",
  "icon": "icon.png",
  "author": "sat",
  "platforms": ["macOS"],
  "categories": ["Developer Tools"],
  "keywords": ["ai", "agents", "codex", "claude", "opencode", "search"],
  "license": "MIT",
  "commands": [
    {
      "name": "search-conversations",
      "title": "Search Conversations",
      "description": "Search local AI agent conversations with Fainder.",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.15"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.4",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}
