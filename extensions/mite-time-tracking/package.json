{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "mite-time-tracking",
  "title": "Mite Time Tracking",
  "description": "Advanced time tracking with mite: Start timers, create entries, manage favorites, and view weekly summaries.",
  "icon": "icon.png",
  "author": "christian_arenz",
  "license": "MIT",
  "categories": [
    "Productivity"
  ],
  "commands": [
    {
      "name": "start-timer",
      "title": "Start Timer",
      "description": "Create and start a new time entry",
      "mode": "view"
    },
    {
      "name": "create-entry",
      "title": "Create Entry",
      "description": "Create a completed time entry",
      "mode": "view"
    },
    {
      "name": "stop-timer",
      "title": "Stop Timer",
      "description": "Stop the currently running timer",
      "mode": "no-view"
    },
    {
      "name": "view-summary",
      "title": "View Summary",
      "description": "View today's entries and weekly summary",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "miteUrl",
      "type": "textfield",
      "required": true,
      "title": "mite URL",
      "description": "Your mite account URL (e.g., yourcompany.mite.yo.lk)",
      "placeholder": "yourcompany.mite.yo.lk"
    },
    {
      "name": "apiKey",
      "type": "password",
      "required": true,
      "title": "API Key",
      "description": "Your personal mite API key",
      "placeholder": "Enter your mite API key"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.103.10",
    "@raycast/utils": "^2.2.2"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.1.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "eslint": "^9.39.1",
    "prettier": "^3.0.3",
    "typescript": "^5.2.2"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}
