{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "airport-lookup",
  "title": "Airport Lookup",
  "description": "Search airports by ICAO or IATA code and see quick facts about them.",
  "icon": "icon.png",
  "author": "davisitofab99",
  "categories": [
    "Data"
  ],
  "license": "MIT",
  "platforms": [
    "Windows"
  ],
  "commands": [
    {
      "name": "search-airport",
      "title": "Search Airport",
      "description": "Search airports by ICAO or IATA code, or by name/city",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.103.3",
    "@raycast/utils": "^2.2.1"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.1.1",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "eslint": "^9.37.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}
