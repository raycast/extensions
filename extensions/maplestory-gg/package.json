{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "maplestory-gg",
  "title": "MapleStory",
  "type": "module",
  "description": "Look up Global MapleStory characters using Nexon rankings.",
  "icon": "maplestory-gg-icon.png",
  "author": "litomore",
  "contributors": [
    "pernielsentikaer"
  ],
  "platforms": [
    "macOS",
    "Windows"
  ],
  "categories": [
    "Data",
    "Fun",
    "Productivity"
  ],
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  },
  "license": "MIT",
  "commands": [
    {
      "name": "favorites",
      "title": "Favorite Characters",
      "description": "Quick access to your favorite characters.",
      "mode": "view"
    },
    {
      "name": "lookup",
      "title": "Lookup Character",
      "description": "Look up characters in Nexon’s North American and European rankings.",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.103.3",
    "@raycast/utils": "^2.2.1",
    "got": "^14.5.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.1.1",
    "@types/node": "^24.7.1",
    "@types/react": "^19.2.2",
    "eslint": "^9.37.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
