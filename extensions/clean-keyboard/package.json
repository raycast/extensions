{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "clean-keyboard",
  "title": "Clean Keyboard",
  "description": "Lock your keyboard to clean it easily",
  "icon": "extension_icon.png",
  "author": "ike-gg",
  "contributors": [
    "AndersDigital",
    "xilopaint",
    "ridemountainpig",
    "litomore",
    "yusifaliyevpro",
    "shivraj-roy",
    "alexi.build"
  ],
  "platforms": [
    "macOS",
    "Windows"
  ],
  "categories": [
    "Productivity",
    "Other",
    "System"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "clean-keyboard",
      "title": "Lock Keyboard",
      "description": "Lock your keyboard to clean it easily",
      "mode": "view",
      "keywords": [
        "keyboard",
        "clean",
        "lock",
        "freeze",
        "dirty"
      ],
      "preferences": [
        {
          "name": "defaultDuration",
          "title": "Default Duration",
          "description": "Lock the keyboard immediately for the chosen duration, or choose Always Ask to pick each time.",
          "type": "dropdown",
          "default": "always-ask",
          "required": false,
          "data": [
            {
              "title": "Always Ask",
              "value": "always-ask"
            },
            {
              "title": "15 seconds",
              "value": "15"
            },
            {
              "title": "30 seconds",
              "value": "30"
            },
            {
              "title": "1 minute",
              "value": "60"
            },
            {
              "title": "2 minutes",
              "value": "120"
            },
            {
              "title": "5 minutes",
              "value": "300"
            },
            {
              "title": "1 hour",
              "value": "3600"
            },
            {
              "title": "24 hours",
              "value": "86400"
            },
            {
              "title": "Forever",
              "value": "0"
            }
          ]
        },
        {
          "name": "lockFnKeys",
          "title": "Lock Function Row Keys",
          "description": "Also block function row keys while cleaning. Original setting is restored on unlock. macOS Tahoe (26+) only.",
          "type": "checkbox",
          "label": "Lock Fn / function row keys (macOS Tahoe only)",
          "default": false,
          "required": false
        }
      ]
    }
  ],
  "tools": [
    {
      "name": "lock-keyboard",
      "title": "Lock Keyboard",
      "description": "Lock the keyboard for cleaning for a chosen duration."
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.6"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.1.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "eslint": "^9.39.1",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}
