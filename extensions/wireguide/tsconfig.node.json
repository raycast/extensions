{
  "$schema": "https://json.schemastore.org/tsconfig",
  "include": ["eslint.config.js"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "lib": ["ES2023"],
    "module": "nodenext",
    "target": "ES2023",
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "allowJs": true,
    "noEmit": true,
    "types": ["node"]
  }
}
