{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "namecrane",
  "title": "NameCrane",
  "description": "Manage Domains in NameCrane",
  "icon": "namecrane.png",
  "author": "xmok",
  "platforms": [
    "macOS",
    "Windows"
  ],
  "categories": [
    "Web"
  ],
  "license": "MIT",
  "preferences": [
    {
      "name": "api_key",
      "title": "API Key",
      "placeholder": "crane_AbCdEf1234567890...",
      "type": "password",
      "required": true,
      "description": "NameCrane API Key"
    }
  ],
  "commands": [
    {
      "name": "get-balance",
      "title": "Get Balance",
      "description": "Get Current NameCrane Balance",
      "mode": "no-view"
    },
    {
      "name": "manage-domains",
      "title": "Manage Domains",  
      "description": "Manage Domains in NameCrane",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^2.12.1",
    "@raycast/utils": "^2.3.3"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.4",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/showdown": "^1.9.4",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "prepublishOnly": "echo \"\\n\\nIt seems like you are trying to publish the Raycast extension to npm.\\n\\nIf you did intend to publish it to npm, remove the \\`prepublishOnly\\` script and rerun \\`npm publish\\` again.\\nIf you wanted to publish it to the Raycast Store instead, use \\`npm run publish\\` instead.\\n\\n\" && exit 1",
    "publish": "npx @raycast/api@latest publish"
  }
}
