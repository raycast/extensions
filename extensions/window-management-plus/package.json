  },
  "dependencies": {
    "@raycast/api": "^2.11.1",
    "@raycast/utils": "^2.3.3"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "22.x",
    "@types/react": "19.x",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "^5.4.0"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/lib/*.test.ts",
    "lint": "ray lint",
    "fix-lint": "ray lint --fix",
    "publish": "npx @raycast/api@latest publish"
  }
}
