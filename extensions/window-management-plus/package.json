          {
            "includes": "Slack"
          }
        ]
      },
      {
        "input": "@window-management-plus put Slack and Spotify on my laptop screen and everything else on the big display",
        "mocks": {
          "get-windows": {
            "displays": [
              {
                "index": 0,
                "x": 0,
