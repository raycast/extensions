                "role": "work",
                "display": 1,
                "focused": true,
                "frame": {
                  "x": 0,
                  "y": 32,
                  "width": 756,
                  "height": 950
                }
              },
              {
                "id": "102_2",
                "app": "Safari",
                "title": "TypeScript Handbook",
                "role": "reference",
                "display": 0,
                "focused": false,
                "frame": {
                  "x": 0,
                  "y": 0,
                  "width": 1280,
                  "height": 1440
                }
              },
              {
                "id": "103_3",
                "app": "Slack",
                "title": "general",
                "role": "comms",
                "display": 0,
                "focused": false,
                "frame": {
                  "x": 1280,
                  "y": 0,
                  "width": 1280,
                  "height": 720
                }
              },
              {
                "id": "104_4",
                "app": "Spotify",
                "title": "Spotify",
                "role": "background",
                "display": 0,
                "focused": false,
                "frame": {
                  "x": 1280,
                  "y": 720,
                  "width": 1280,
