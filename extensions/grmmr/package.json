{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "grmmr",
  "title": "Grmmr",
  "description": "Fix grammar and spelling in selected text using AI (OpenAI, Anthropic, or Google Gemini)",
  "icon": "extension-icon.png",
  "author": "vladstudio",
  "repository": {
    "type": "git",
    "url": "https://github.com/vladstudio/grmmr.git"
  },
  "platforms": [
    "macOS",
    "Windows"
  ],
  "categories": [
    "Productivity"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "fix-grammar",
      "title": "Fix Grammar",
      "description": "Fix grammar in selected text",
      "mode": "no-view"
    }
  ],
  "preferences": [
    {
      "name": "provider",
      "type": "dropdown",
      "required": true,
      "title": "LLM Provider",
      "description": "Choose your LLM provider",
      "default": "openai",
      "data": [
        {
          "title": "OpenAI",
          "value": "openai"
        },
        {
          "title": "Anthropic",
          "value": "anthropic"
        },
        {
          "title": "Google Gemini",
          "value": "gemini"
        }
      ]
    },
    {
      "name": "openai_model",
      "type": "dropdown",
      "required": false,
      "title": "OpenAI Model",
      "description": "Select OpenAI model",
      "default": "gpt-4o",
      "data": [
        {
          "title": "GPT-4.1",
          "value": "gpt-4.1"
        },
        {
          "title": "GPT-4.1 Mini",
          "value": "gpt-4.1-mini"
        },
        {
          "title": "GPT-4.1 Nano",
          "value": "gpt-4.1-nano"
        },
        {
          "title": "GPT-4o",
          "value": "gpt-4o"
        },
        {
          "title": "GPT-4o Mini",
          "value": "gpt-4o-mini"
        },
        {
          "title": "ChatGPT-4o Latest",
          "value": "chatgpt-4o-latest"
        },
        {
          "title": "GPT-4 Turbo",
          "value": "gpt-4-turbo"
        },
        {
          "title": "GPT-4 Turbo (2024-04-09)",
          "value": "gpt-4-turbo-2024-04-09"
        },
        {
          "title": "GPT-3.5 Turbo",
          "value": "gpt-3.5-turbo"
        },
        {
          "title": "GPT-3.5 Turbo (0125)",
          "value": "gpt-3.5-turbo-0125"
        }
      ]
    },
    {
      "name": "anthropic_model",
      "type": "dropdown",
      "required": false,
      "title": "Anthropic Model",
      "description": "Select Anthropic model",
      "default": "claude-3-5-sonnet-20241022",
      "data": [
        {
          "title": "Claude Opus 4 (20250514)",
          "value": "claude-opus-4-20250514"
        },
        {
          "title": "Claude Sonnet 4 (20250514)",
          "value": "claude-sonnet-4-20250514"
        },
        {
          "title": "Claude 3.7 Sonnet (20250219)",
          "value": "claude-3-7-sonnet-20250219"
        },
        {
          "title": "Claude 3.7 Sonnet (Latest)",
          "value": "claude-3-7-sonnet-latest"
        },
        {
          "title": "Claude 3.5 Sonnet (20241022)",
          "value": "claude-3-5-sonnet-20241022"
        },
        {
          "title": "Claude 3.5 Sonnet (20240620)",
          "value": "claude-3-5-sonnet-20240620"
        },
        {
          "title": "Claude 3.5 Sonnet (Latest)",
          "value": "claude-3-5-sonnet-latest"
        },
        {
          "title": "Claude 3 Opus (20240229)",
          "value": "claude-3-opus-20240229"
        },
        {
          "title": "Claude 3 Sonnet (20240229)",
          "value": "claude-3-sonnet-20240229"
        },
        {
          "title": "Claude 3 Haiku (20240307)",
          "value": "claude-3-haiku-20240307"
        }
      ]
    },
    {
      "name": "gemini_model",
      "type": "dropdown",
      "required": false,
      "title": "Gemini Model",
      "description": "Select Gemini model",
      "default": "gemini-2.0-flash-exp",
      "data": [
        {
          "title": "Gemini 2.5 Pro",
          "value": "gemini-2.5-pro"
        },
        {
          "title": "Gemini 2.5 Flash",
          "value": "gemini-2.5-flash"
        },
        {
          "title": "Gemini 2.5 Flash Lite",
          "value": "gemini-2.5-flash-lite"
        },
        {
          "title": "Gemini 2.0 Flash",
          "value": "gemini-2.0-flash"
        },
        {
          "title": "Gemini 2.0 Flash Lite",
          "value": "gemini-2.0-flash-lite"
        },
        {
          "title": "Gemini 2.0 Flash (Experimental)",
          "value": "gemini-2.0-flash-exp"
        },
        {
          "title": "Gemini 1.5 Pro",
          "value": "gemini-1.5-pro"
        },
        {
          "title": "Gemini 1.5 Flash",
          "value": "gemini-1.5-flash"
        },
        {
          "title": "Gemini 1.5 Flash 8B",
          "value": "gemini-1.5-flash-8b"
        },
        {
          "title": "Gemini 1.0 Pro",
          "value": "gemini-1.0-pro"
        }
      ]
    },
    {
      "name": "apiKey",
      "type": "password",
      "required": true,
      "title": "API Key",
      "description": "Your API key for the selected provider",
      "placeholder": "Enter your API key"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.103.3",
    "@raycast/utils": "^1.17.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.4",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "prepublishOnly": "echo \"\\n\\nIt seems like you are trying to publish the Raycast extension to npm.\\n\\nIf you did intend to publish it to npm, remove the \\`prepublishOnly\\` script and rerun \\`npm publish\\` again.\\nIf you wanted to publish it to the Raycast Store instead, use \\`npm run publish\\` instead.\\n\\n\" && exit 1",
    "publish": "npx @raycast/api@latest publish"
  }
}