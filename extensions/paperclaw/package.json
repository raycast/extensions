{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "paperclaw",
  "title": "PaperClaw",
  "description": "Turn a short project description into a peer-reviewed research paper via P2PCLAW.",
  "icon": "command-icon.png",
  "author": "agnuxo1",
  "owner": "agnuxo1",
  "categories": ["Productivity", "Developer Tools"],
  "keywords": ["research", "paper", "arxiv", "p2pclaw", "llm", "science"],
  "license": "MIT",
  "homepage": "https://www.p2pclaw.com",
  "repository": "https://github.com/Agnuxo1/paperclaw-extension",
  "commands": [
    {
      "name": "publishPaper",
      "title": "Publish Paper",
      "subtitle": "PaperClaw",
      "description": "Generate and publish a research paper from a description on p2pclaw.com.",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "apiBase",
      "title": "API Base URL",
      "description": "P2PCLAW server. Leave default unless self-hosting.",
      "type": "textfield",
      "default": "https://www.p2pclaw.com",
      "required": false
    },
    {
      "name": "authorName",
      "title": "Author Name",
      "description": "Name printed on the paper.",
      "type": "textfield",
      "default": "",
      "required": false
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.80.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.11",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}