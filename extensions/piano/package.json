{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "piano",
  "title": "Piano",
  "description": "A playable piano that lives entirely inside Raycast.",
  "icon": "icon.png",
  "author": "Br0wny",
  "type": "module",
  "platforms": [
    "macOS"
  ],
  "categories": [
    "Fun"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "piano",
      "title": "Play Piano",
      "subtitle": "Piano",
      "description": "Play a responsive piano with your computer keyboard.",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.23",
    "react": "^19.1.1"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "eslint": "^9.35.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish",
    "typecheck": "tsc --noEmit"
  }
}
