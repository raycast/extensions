{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "glean-search",
  "title": "Glean Search",
  "description": "Search your company's knowledge base via Glean",
  "icon": "icon.png",
  "author": "faizhasim",
  "categories": [
    "Productivity",
    "Web"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "search-glean",
      "title": "Search Glean",
      "description": "Search company docs via Glean CLI",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.23"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "eslint": "^10.7.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "typescript": "^6.0.0",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "ray publish",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "platforms": [
    "macOS"
  ]
}
