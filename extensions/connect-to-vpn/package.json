{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "connect-to-vpn",
  "title": "Connect to VPN",
  "description": "Connect to/disconnect from VPN",
  "icon": "command-icon.png",
  "author": "rasmusbe",
  "contributors": [
    "sato11",
    "stonerl",
    "vyacheslav",
    "yshmeel",
    "borzov",
    "andrei_hudalla"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "toggle",
      "title": "Toggle Last Used",
      "subtitle": "VPN",
      "description": "Toggle your Last Used VPN",
      "mode": "no-view"
    },
    {
      "name": "index",
      "title": "Show Network Services",
      "subtitle": "VPN",
      "description": "Shortcut to your Network Preferences",
      "mode": "view"
    },
    {
      "name": "menu-bar",
      "title": "Network Services",
      "subtitle": "VPN",
      "description": "View your Network Services at a glance",
      "mode": "menu-bar",
      "interval": "30s"
    }
  ],
  "preferences": [
    {
      "name": "hideInvalidDevices",
      "title": "Filter Non-VPN Services",
      "description": "Tick this to hide non-VPN services from the list.",
      "label": "Hide non-VPN services",
      "type": "checkbox",
      "required": false,
      "default": true
    },
    {
      "name": "sortBy",
      "title": "Sort By",
      "description": "Choose how to sort the services",
      "type": "dropdown",
      "required": false,
      "default": "ascService",
      "data": [
        {
          "title": "Ascending by Name",
          "value": "ascService"
        },
        {
          "title": "Descending by Name",
          "value": "descService"
        },
        {
          "title": "Ascending by Type",
          "value": "ascType"
        },
        {
          "title": "Descending by Type",
          "value": "descType"
        }
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^2.4.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "22.19.17",
    "@types/react": "19.0.10",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  },
  "platforms": [
    "macOS"
  ]
}
