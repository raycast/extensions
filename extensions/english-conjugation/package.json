{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "english-conjugation",
  "title": "English Verb Conjugation",
  "description": "Look up English verb forms and common collocations in a clean, minimal interface.",
  "icon": "icon.png",
  "author": "younes_benallal",
  "platforms": [
    "macOS"
  ],
  "categories": [
    "Productivity"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "conjugate-verb",
      "title": "Conjugate Verb",
      "description": "Show English verb forms and collocations",
      "mode": "view",
      "keywords": [
        "english",
        "verb",
        "verbs",
        "grammar",
        "conjugation"
      ],
      "arguments": [
        {
          "name": "verb",
          "type": "text",
          "placeholder": "Enter an infinitive, e.g. go",
          "required": false
        }
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.12",
    "eng-verber": "^1.0.2",
    "react": "19.0.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.6",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "eslint": "^8.51.0",
    "prettier": "^3.0.3",
    "typescript": "^5.2.2"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "ray publish"
  }
}
