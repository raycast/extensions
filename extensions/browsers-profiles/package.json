{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "browsers-profiles",
  "version": "1.0.0",
  "description": "Access your browsers profiles from Raycast",
  "categories": [
    "Productivity"
  ],
  "license": "MIT",
  "author": "skydiver",
  "contributors": [
    "kytta",
    "emilshr",
    "chingweih",
    "matemolnar8"
  ],
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "prepublishOnly": "echo \"\\n\\nIt seems like you are trying to publish the Raycast extension to npm.\\n\\nIf you did intend to publish it to npm, remove the \\`prepublishOnly\\` script and rerun \\`npm publish\\` again.\\nIf you wanted to publish it to the Raycast Store instead, use \\`npm run publish\\` instead.\\n\\n\" && exit 1",
    "publish": "npx @raycast/api@latest publish"
  },
  "dependencies": {
    "@raycast/api": "^1.36.0",
    "ini": "^3.0.0"
  },
  "devDependencies": {
    "@types/ini": "^1.3.31",
    "@types/node": "~16.10.0",
    "@types/react": "^17.0.28",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.3.0",
    "prettier": "^2.5.1",
    "typescript": "^4.4.3"
  },
  "icon": "command-icon.png",
  "preferences": [
    {
      "name": "showGoogleChrome",
      "type": "checkbox",
      "label": "Google Chrome",
      "title": "Browsers",
      "description": "Show Google Chrome profiles",
      "required": false,
      "default": true
    },
    {
      "name": "showGoogleChromeDev",
      "type": "checkbox",
      "label": "Google Chrome Dev",
      "description": "Show Google Chrome Dev profiles",
      "required": false,
      "default": true
    },
    {
      "name": "showGoogleChromeCanary",
      "type": "checkbox",
      "label": "Google Chrome Canary",
      "description": "Show Google Chrome Canary profiles",
      "required": false,
      "default": true
    },
    {
      "name": "showChromium",
      "type": "checkbox",
      "label": "Chromium",
      "description": "Show Chromium profiles",
      "required": false,
      "default": true
    },
    {
      "name": "showBrave",
      "type": "checkbox",
      "label": "Brave",
      "description": "Show Brave profiles",
      "required": false,
      "default": true
    },
    {
      "name": "showMicrosoftEdge",
      "type": "checkbox",
      "label": "Microsoft Edge",
      "description": "Show Microsoft Edge profiles",
      "required": false,
      "default": true
    },
    {
      "name": "showMicrosoftEdgeDev",
      "type": "checkbox",
      "label": "Microsoft Edge Dev",
      "description": "Show Microsoft Edge Dev profiles",
      "required": false,
      "default": true
    },
    {
      "name": "showMicrosoftEdgeCanary",
      "type": "checkbox",
      "label": "Microsoft Edge Canary",
      "description": "Show Microsoft Edge Canary profiles",
      "required": false,
      "default": true
    },
    {
      "name": "showHelium",
      "type": "checkbox",
      "label": "Helium",
      "description": "Show Helium profiles",
      "required": false,
      "default": true
    },
    {
      "name": "showFirefox",
      "type": "checkbox",
      "label": "Firefox",
      "description": "Show Firefox profiles",
      "required": false,
      "default": true
    },
    {
      "name": "showFirefoxDeveloperEdition",
      "type": "checkbox",
      "label": "Firefox Developer Edition",
      "description": "Show Firefox Developer Edition profiles",
      "required": false,
      "default": true
    },
    {
      "name": "showFirefoxNightly",
      "type": "checkbox",
      "label": "Firefox Nightly",
      "description": "Show Firefox Nightly profiles",
      "required": false,
      "default": true
    }
  ],
  "commands": [
    {
      "name": "index",
      "title": "Open Browser Profile",
      "description": "Access your browsers profiles from Raycast",
      "mode": "view"
    }
  ],
  "title": "Open Browsers Profiles",
  "platforms": [
    "macOS"
  ]
}
