{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "devtools-launcher",
  "title": "DevTools Launcher",
  "description": "Open any DevTools tool, such as JSON Viewer, Hash Generator, or JWT Decoder, straight from Raycast.",
  "icon": "icon.png",
  "author": "ahmed_shamim",
  "categories": [
    "Developer Tools",
    "Productivity"
  ],
  "license": "MIT",
  "platforms": [
    "macOS"
  ],
  "commands": [
    {
      "name": "search-tools",
      "title": "Search Tools",
      "subtitle": "DevTools",
      "description": "Search the DevTools app's tools by name and open one.",
      "mode": "view"
    },
    {
      "name": "open-devtools",
      "title": "Open DevTools",
      "subtitle": "DevTools",
      "description": "Open the DevTools app, or its command palette with a search.",
      "mode": "no-view",
      "arguments": [
        {
          "name": "query",
          "placeholder": "Search (optional)",
          "type": "text",
          "required": false
        }
      ]
    },
    {
      "name": "tool-json-viewer",
