{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "passgen",
  "title": "PassGen",
  "description": "Generate cryptographically secure passwords with configurable length, character sets and symbols",
  "icon": "icon.png",
  "author": "chazzz287",
  "categories": [
    "Security"
  ],
  "platforms": [
    "macOS"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "generate-password",
      "title": "Generate Password",
      "description": "Generate a random password with custom settings",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^2.0.5"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "eslint": "^10.9.0",
    "prettier": "^3.9.6",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "lint": "ray lint",
    "fix-lint": "ray lint --fix",
    "publish": "npx @raycast/api@latest publish"
  }
}
