{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "local-time-tracker",
  "title": "Local Time Tracker",
  "description": "Track project work locally in Raycast",
  "icon": "extension-icon.png",
  "author": "yoshinyan",
  "platforms": [
    "macOS"
  ],
  "categories": [
    "Productivity"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "start-work",
      "title": "Start Work",
      "description": "Start tracking work",
      "mode": "view"
    },
    {
      "name": "stop-work",
      "title": "Stop Work",
      "description": "Stop the active timer",
      "mode": "no-view"
    },
    {
      "name": "menu-bar",
      "title": "Menu Bar Timer",
      "description": "Show the active timer in the menu bar",
      "mode": "menu-bar",
      "interval": "1m"
    },
    {
      "name": "work-logs",
      "title": "Work Logs",
      "description": "View and edit work logs",
      "mode": "view"
    },
    {
      "name": "reports",
      "title": "Reports",
      "description": "View work-time reports",
      "mode": "view"
    },
    {
      "name": "projects",
      "title": "Projects",
      "description": "Manage projects",
      "mode": "view"
    }
  ],
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "eslint 'src/**/*.{ts,tsx}' && prettier --check 'src/**/*.{ts,tsx}' 'tests/**/*.ts' README.md package.json tsconfig.json",
    "lint:ray": "ray lint",
    "publish": "ray publish",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@raycast/api": "2.4.1",
    "react": "19.3.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "2.2.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
