{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "resize",
  "title": "Resize",
  "description": "Viewport-accurate Chrome window presets for responsive dev. DevTools-parity device sizes, live chrome measurement, honest about what a window resize can't simulate.",
  "icon": "icon.png",
  "author": "ali_reza_mohammad_poor",
  "license": "MIT",
  "platforms": [
    "macOS"
  ],
  "categories": [
    "Developer Tools"
  ],
  "commands": [
    {
      "name": "resize-to-preset",
      "title": "Resize to Preset",
      "description": "Resize the front Chrome window so its viewport matches a device preset",
      "mode": "view"
    },
    {
      "name": "apply-preset",
      "title": "Apply Preset",
      "description": "Apply a preset directly by id or name (for Quicklink hotkeys)",
      "mode": "no-view",
      "arguments": [
        {
          "name": "preset",
          "placeholder": "Preset id or name",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "name": "cycle-breakpoints",
      "title": "Cycle Breakpoints",
      "description": "Step through your pinned breakpoint sequence — bind to a hotkey and hit repeatedly",
      "mode": "no-view"
    },
    {
      "name": "add-custom-preset",
      "title": "Add Custom Preset",
      "description": "Save a custom viewport preset to ~/.config/resize/presets.json",
      "mode": "view"
    },
    {
      "name": "measure-viewport",
      "title": "Measure Viewport",
      "description": "Show the current Chrome viewport, window bounds, chrome delta, and zoom state",
      "mode": "view"
    }
  ],
  "preferences": [
