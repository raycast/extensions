{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "dblp-search",
  "title": "DBLP Search",
  "description": "Search DBLP by author name and browse their publications.",
  "icon": "dblp-icon.png",
  "author": "michel_steuwer",
  "categories": [
    "Web"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "search-authors",
      "title": "Search Authors",
      "subtitle": "DBLP",
      "description": "Search DBLP for authors and list their publications.",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.83.0",
    "@raycast/utils": "^1.17.0",
    "fast-xml-parser": "^4.5.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.11",
    "@types/node": "^20.8.10",
    "@types/react": "^19.0.10",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "typescript": "^5.4.5"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}
