{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "cross-platform-process-manager",
  "title": "Process Manager & Task Killer",
  "description": "Secure, licensed cross-platform process enumeration and termination.",
  "icon": "assets/command-icon.png",
  "author": "Jshlks",
  "categories": ["System", "Productivity"],
  "license": "MIT",
  "commands": [
    {
      "name": "index",
      "title": "Manage Processes",
      "description": "View running processes and kill them (Premium feature requires subscription)",
      "mode": "view",
      "platforms": ["macOS", "Windows"]
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.77.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.8",
    "@types/node": "20.8.10",
    "@types/react": "18.2.27",
    "@types/react-dom": "18.2.18",
    "eslint": "^8.51.0",
    "prettier": "^3.0.3",
    "typescript": "^5.2.2"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint"
  },
  "overrides": {
    "@types/react": "18.2.27",
    "@types/react-dom": "18.2.18"
  }
}
