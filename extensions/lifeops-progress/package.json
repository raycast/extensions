{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "lifeops-progress",
  "title": "LifeOps Progress",
  "description": "Menubar progress trackers for weight (Home Assistant) and savings (Firefly III).",
  "icon": "icon.png",
  "author": "andre_hebben",
  "license": "MIT",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "commands": [
    {
      "name": "weight-menubar",
      "title": "Weight Progress (Menu Bar)",
      "description": "Shows weight progress from Home Assistant in the menu bar.",
      "mode": "menu-bar",
      "preferences": [
        {
          "name": "haBaseUrl",
          "type": "textfield",
          "title": "Home Assistant Base URL",
          "description": "Example: http://homeassistant.local:8123",
          "required": true
        },
        {
          "name": "haToken",
          "type": "password",
          "title": "Home Assistant Long-Lived Token",
          "description": "Home Assistant Long-Lived Access Token",
          "required": true
        },
        {
          "name": "haWeightEntityId",
          "type": "textfield",
          "title": "Weight Entity ID",
          "description": "Example: sensor.weight",
          "required": true,
          "default": "sensor.weight"
        },
        {
          "name": "weightStartKg",
          "type": "textfield",
          "title": "Start (kg)",
          "description": "Baseline weight used for progress calculation",
          "required": false,
          "default": "113"
        },
        {
          "name": "weightGoalKg",
          "type": "textfield",
          "title": "Goal (kg)",
          "description": "Target weight",
          "required": false,
          "default": "85"
        },
        {
          "name": "refreshSeconds",
          "type": "textfield",
          "title": "Refresh (seconds)",
          "description": "How often to refresh the menu bar",
          "required": false,
          "default": "900"
        }
      ]
    },
    {
      "name": "savings-menubar",
      "title": "Savings Progress (Menu Bar)",
      "description": "Shows savings progress from Firefly III in the menu bar.",
      "mode": "menu-bar",
      "preferences": [
        {
          "name": "fireflyBaseUrl",
          "type": "textfield",
          "title": "Firefly Base URL",
          "description": "Example: https://firefly.example.com",
          "required": true
        },
        {
          "name": "fireflyToken",
          "type": "password",
          "title": "Firefly Personal Access Token",
          "description": "Firefly III Personal Access Token",
          "required": true
        },
        {
          "name": "fireflyAccountIdsCsv",
          "type": "textfield",
          "title": "Account IDs (CSV)",
          "description": "Comma-separated asset account ids (e.g. 805)",
          "required": true,
          "default": "805"
        },
        {
          "name": "savingsStartEur",
          "type": "textfield",
          "title": "Start (€)",
          "description": "Baseline balance used for progress calculation",
          "required": false,
          "default": "0"
        },
        {
          "name": "savingsGoalEur",
          "type": "textfield",
          "title": "Goal (€)",
          "description": "Target balance",
          "required": false,
          "default": "20000"
        },
        {
          "name": "refreshSeconds",
          "type": "textfield",
          "title": "Refresh (seconds)",
          "description": "How often to refresh the menu bar",
          "required": false,
          "default": "900"
        }
      ]
    }
  ],
  "scripts": {
    "dev": "npx ray develop",
    "build": "npx ray build",
    "lint": "npx ray lint",
    "lint:fix": "npx ray lint --fix",
    "format": "prettier -w ."
  },
  "dependencies": {
    "@raycast/api": "^1.104.17",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.2.5",
    "typescript": "^5.6.3"
  }
}
