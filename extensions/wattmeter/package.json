{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "wattmeter",
  "title": "Wattmeter",
  "description": "Control Wattmeter from Raycast: refresh usage, open the dashboard, and export CSV reports.",
  "icon": "extension-icon.png",
  "author": "emreisik95",
  "platforms": ["macOS"],
  "categories": ["Developer Tools", "Productivity"],
  "keywords": ["claude", "usage", "tokens", "cost", "anthropic"],
  "license": "MIT",
  "commands": [
    {
      "name": "refresh",
      "title": "Refresh Wattmeter",
      "subtitle": "Wattmeter",
      "description": "Force Wattmeter to reparse Claude usage logs.",
      "mode": "no-view"
    },
    {
      "name": "dashboard",
      "title": "Open Wattmeter Dashboard",
      "subtitle": "Wattmeter",
      "description": "Open the Wattmeter dashboard window.",
      "mode": "no-view"
    },
    {
      "name": "export",
      "title": "Export Wattmeter CSV",
      "subtitle": "Wattmeter",
      "description": "Trigger Wattmeter's CSV export flow.",
      "mode": "no-view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.80.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.11",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.45",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "lint": "ray lint",
    "fix-lint": "ray lint --fix",
    "publish": "npx @raycast/api@latest publish"
  }
}
