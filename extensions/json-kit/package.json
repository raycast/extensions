{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "json-kit",
  "title": "JSON Kit",
  "description": "Inspect and transform JSON locally",
  "icon": "json-kit.png",
  "author": "lyonmu",
  "license": "MIT",
  "categories": [
    "Developer Tools"
  ],
  "commands": [
    {
      "name": "json-viewer",
      "title": "JSON Viewer",
      "description": "Inspect and transform JSON locally",
      "mode": "view"
    }
  ],
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "lint": "ray lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "publish": "npx @raycast/api@latest publish"
  },
  "dependencies": {
    "@raycast/api": "^2.10.1",
    "@raycast/utils": "^2.3.3",
    "jsonc-parser": "^3.3.1",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "eslint": "^9.39.5",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "platforms": [
    "macOS"
  ]
}
