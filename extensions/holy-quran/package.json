{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "holy-quran",
  "title": "Holy Quran",
  "description": "Experience the Holy Quran with beautiful recitations. Browse Surahs, select your favorite reciters, and listen to the divine verses in the background or with specialized memorization loops.",
  "icon": "extension_icon.png",
  "author": "abdullahnettoor",
  "platforms": [
    "macOS"
  ],
  "categories": [
    "Media",
    "Productivity",
    "Other"
  ],
  "license": "MIT",
