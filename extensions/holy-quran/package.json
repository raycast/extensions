      "default": "7"
    },
    {
      "name": "defaultReciterName",
      "type": "textfield",
      "required": false,
      "title": "Default Reciter Name",
      "description": "The name of the default reciter",
      "default": "Mishari Rashid al-`Afasy"
    }
  ],
