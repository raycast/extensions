{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Raycast Extension",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "lib": ["ES2021"],
    "module": "commonjs",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "strict": true,
    "strictNullChecks": true,
    "target": "ES2021",
    "jsx": "react-jsx",
    "skipLibCheck": true
  },
  "include": ["src/**/*", "raycast-env.d.ts"],
  "exclude": ["node_modules"]
}
