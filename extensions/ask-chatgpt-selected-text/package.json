{
  "name": "ask-chatgpt-selected-text",
  "title": "GPT 搜索",
  "version": "1.0.0",
  "description": "从 Raycast 向 ChatGPT 发送带联网搜索要求的问题或选中文字",
  "icon": "extension-icon.png",
  "author": "zl_h",
  "platforms": [
    "macOS"
  ],
  "categories": [
    "Productivity"
  ],
  "keywords": [
    "ChatGPT",
    "GPT",
    "Search",
    "搜索",
    "AI"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "ray develop",
    "build": "ray build -e dist",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  },
  "dependencies": {
    "@raycast/api": "^1.102.4"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.4",
    "@types/node": "^22.15.3",
    "eslint": "^9.25.1",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3"
  },
  "commands": [
    {
      "name": "ask-selected-text",
      "title": "GPT 搜索",
      "subtitle": "搜索选中文字或手动提问",
      "description": "直接搜索选中文字，或手动输入问题让 ChatGPT 联网搜索",
      "icon": "extension-icon.png",
      "mode": "no-view",
      "arguments": [
        {
          "name": "question",
          "placeholder": "可选：输入问题（留空则搜索选中文字）",
          "type": "text",
          "required": false
        }
      ]
    }
  ]
}
