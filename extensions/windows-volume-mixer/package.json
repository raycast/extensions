{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "windows-volume-mixer",
  "title": "Windows Volume Mixer",
  "description": "Control individual application volumes and manage audio devices on Windows",
  "icon": "extension-icon.png",
  "author": "Rafael",
  "platforms": [
    "Windows"
  ],
  "categories": [
    "System",
    "Productivity"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "volume-mixer",
      "title": "Volume Mixer",
      "description": "View and control volume levels for all audio applications",
      "mode": "view",
      "keywords": [
        "volume",
        "mixer",
        "audio",
        "sound"
      ]
    },
    {
      "name": "audio-devices",
      "title": "Audio Devices",
      "description": "Switch between audio output and input devices",
      "mode": "view",
      "keywords": [
        "audio",
        "device",
        "speaker",
        "microphone"
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.11",
    "@raycast/utils": "^2.2.3"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.11",
    "@types/node": "22.10.1",
    "@types/react": "18.3.12",
    "eslint": "^9.16.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.59.0"
  },
  "scripts": {
    "build": "ray build --skip-types -e dist -o dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}
