{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "dad-jokes",
  "title": "Dad Jokes",
  "description": "Get a random dad joke",
  "icon": "icon.png",
  "author": "pernielsentikaer",
  "contributors": [
    "aljadan",
    "xmok",
    "0xdhrv"
  ],
  "categories": [
    "Fun"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "index",
      "title": "Random Dad Joke",
      "description": "Get a random dad joke",
      "mode": "view"
    }
  ],
  "tools": [
    {
      "name": "get-random-joke",
      "title": "Get Random Dad Joke",
      "description": "Fetch a random dad joke to share with the user"
    },
    {
      "name": "search-jokes",
      "title": "Search Dad Jokes",
      "description": "Search for dad jokes matching a topic or keyword"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.24",
    "@raycast/utils": "^2.3.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "^22.19.17",
    "@types/react": "^19.0.10",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "typescript": "^5.8.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "ray publish"
  },
  "platforms": [
    "macOS",
    "Windows"
  ]
}
