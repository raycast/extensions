{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "caps-lock",
  "title": "Caps Lock",
  "description": "Toggle Caps Lock even when your Caps Lock key is remapped to Hyper, Escape, Control, or another key.",
  "icon": "extension-icon.png",
  "author": "itsdanielsultan",
  "platforms": [
    "macOS"
  ],
  "categories": [
    "System",
    "Productivity"
  ],
  "keywords": [
    "keyboard",
    "hyper",
    "remap",
    "uppercase"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "toggle-caps-lock",
      "title": "Toggle Caps Lock",
      "description": "Turn Caps Lock on or off without pressing the physical Caps Lock key.",
      "mode": "no-view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^2.6.2"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "build": "npm run build:native && ray build",
    "dev": "ray develop",
    "lint": "ray lint",
    "fix-lint": "ray lint --fix",
    "publish": "npx @raycast/api@latest publish",
    "build:native": "sh native/build.sh",
    "test": "node --test tests/*.test.cjs"
  }
}
