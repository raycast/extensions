{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "vision-ocr",
  "title": "Vision OCR",
  "description": "Copy text from any part of the screen, an image or a PDF with Apple's on-device Vision OCR. Keeps the layout, with no install and nothing running in the background.",
  "icon": "extension-icon.png",
  "author": "okgabe",
  "categories": [
    "Productivity",
    "Developer Tools"
  ],
  "license": "MIT",
  "platforms": [
    "macOS"
  ],
  "commands": [
    {
      "name": "recognize-text",
      "title": "Recognize Text",
      "subtitle": "Vision OCR",
      "description": "Select an area of the screen and copy its text. Press Space while selecting to capture a window.",
      "mode": "no-view",
      "keywords": [
        "ocr",
        "copy text",
        "screenshot",
        "live text",
        "scan"
      ]
    },
    {
      "name": "recognize-clipboard",
      "title": "Recognize Text in Clipboard",
      "subtitle": "Vision OCR",
      "description": "Copy the text from the image or PDF on the clipboard.",
      "mode": "no-view",
      "keywords": [
        "ocr",
        "image",
        "paste"
      ]
    },
    {
      "name": "recognize-selected-file",
      "title": "Recognize Text in Selected File",
      "subtitle": "Vision OCR",
      "description": "Copy the text from the images or PDFs selected in Finder.",
      "mode": "no-view",
      "keywords": [
        "ocr",
        "image",
        "pdf",
        "finder"
      ]
    }
  ],
  "preferences": [
    {
      "name": "format",
      "title": "Format",
      "description": "How the recognized text is laid out.",
      "type": "dropdown",
      "required": false,
      "default": "lines",
      "data": [
        {
          "title": "Keep Line Breaks",
          "value": "lines"
        },
        {
          "title": "Join Lines into Paragraphs",
          "value": "paragraphs"
        },
        {
          "title": "Single Line",
          "value": "single"
        },
        {
          "title": "No Spaces",
          "value": "compact"
        },
        {
          "title": "Links Only",
          "value": "links"
        },
        {
          "title": "Email Addresses Only",
          "value": "emails"
        }
      ]
    },
    {
      "name": "afterRecognition",
      "title": "After Recognition",
      "description": "What to do with the text.",
      "type": "dropdown",
      "required": false,
      "default": "copy",
      "data": [
        {
          "title": "Copy to Clipboard",
          "value": "copy"
        },
        {
          "title": "Append to Clipboard",
          "value": "append"
        },
        {
          "title": "Paste into Active App",
          "value": "paste"
        }
      ]
    },
