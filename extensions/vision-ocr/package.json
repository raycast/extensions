    {
      "name": "accuracy",
      "title": "Recognition",
      "description": "Accurate handles small print, symbols and every language. Fast is about 3× quicker and supports Latin-script languages only.",
      "type": "dropdown",
      "required": false,
      "default": "accurate",
      "data": [
        {
          "title": "Accurate",
          "value": "accurate"
        },
        {
          "title": "Fast",
          "value": "fast"
        }
      ]
    },
    {
      "name": "customWords",
      "title": "Custom Words",
      "description": "Comma-separated names, jargon or product terms to prefer when recognizing.",
      "type": "textfield",
      "required": false,
      "placeholder": "Raycast, Kubernetes, SwiftUI"
    },
    {
      "name": "languageCorrection",
      "label": "Correct spelling with a language model",
      "description": "Turn off for code, serial numbers and random strings, so they are copied exactly as shown.",
      "type": "checkbox",
      "required": false,
      "default": true,
      "title": "Options"
    },
    {
      "name": "keepIndentation",
      "label": "Keep indentation",
      "description": "Recreate leading spaces for indented lines, such as code.",
      "type": "checkbox",
      "required": false,
      "default": true
    },
    {
      "name": "plainPunctuation",
      "label": "Use plain punctuation",
      "description": "Replace smart quotes, dashes, ellipses and non-breaking spaces with plain ASCII, for terminals and code editors.",
      "type": "checkbox",
      "required": false,
      "default": false
    },
    {
      "name": "detectBarcodes",
      "label": "Read QR codes and barcodes",
      "description": "Include the contents of QR codes and barcodes in the selection.",
      "type": "checkbox",
      "required": false,
      "default": true
    }
  ],
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "prepublishOnly": "echo \"\\n\\nIt seems like you are trying to publish the Raycast extension to npm.\\n\\nIf you did intend to publish it to npm, remove the \\`prepublishOnly\\` script and rerun \\`npm publish\\` again.\\nIf you wanted to publish it to the Raycast Store instead, use \\`npm run publish\\` instead.\\n\\n\" && exit 1",
    "publish": "npx @raycast/api@latest publish"
  },
  "dependencies": {
    "@raycast/api": "2.14.1"
  },
  "devDependencies": {
    "@raycast/eslint-config": "2.2.0",
    "@types/node": "22.20.7",
    "@types/react": "19.3.3",
    "eslint": "9.39.5",
    "prettier": "3.10.1",
    "typescript": "5.9.3"
  }
}
