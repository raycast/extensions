{
    "$schema": "https://www.raycast.com/schemas/extension.json",
    "name": "klank",
    "description": "Search and navigate your Klank workspace - tracks, albums, playlists, teams, and more",
    "categories": [
        "Applications",
        "Productivity"
    ],
    "license": "MIT",
    "author": "klankstudio",
    "scripts": {
        "build": "ray build -e dist",
        "dev": "ray develop",
        "fix-lint": "ray lint --fix",
        "lint": "ray lint",
        "publish": "npx @raycast/api@latest publish"
    },
    "dependencies": {
        "@raycast/api": "^1.64.0",
        "@raycast/utils": "^1.10.0",
        "node-fetch": "^3.3.2"
    },
    "devDependencies": {
        "@raycast/eslint-config": "^1.0.8",
        "@types/node": "20.8.10",
        "@types/react": "18.2.27",
        "eslint": "^8.51.0",
        "prettier": "^3.0.3",
        "typescript": "^5.2.2"
    },
    "icon": "extension-icon.png",
    "commands": [
        {
            "name": "search",
            "title": "Search",
            "subtitle": "Klank",
            "description": "Search your tracks, albums, playlists, teams, and more",
            "mode": "view"
        },
        {
            "name": "quick-upload",
            "title": "Upload",
            "subtitle": "Klank",
            "description": "Quickly navigate to upload a new track",
            "mode": "no-view"
        },
        {
            "name": "tracks",
            "title": "Tracks",
            "subtitle": "Klank",
            "description": "View your tracks in Klank",
            "mode": "no-view"
        },
        {
            "name": "albums",
            "title": "Albums",
            "subtitle": "Klank",
            "description": "View your albums in Klank",
            "mode": "no-view"
        }
    ],
    "preferences": [
        {
            "name": "apiUrl",
            "title": "API URL",
            "description": "The URL of your Klank instance",
            "type": "textfield",
            "required": false,
            "default": "https://klank.studio"
        },
        {
            "name": "accessToken",
            "title": "Access Token",
            "description": "Your Klank access token (get it from Settings > Integrations)",
            "type": "password",
            "required": true
        }
    ],
    "title": "Klank"
}
