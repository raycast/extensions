{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "easyverein",
  "title": "easyVerein",
  "description": "Seiten, Einstellungen und Datensätze in easyVerein finden und öffnen",
  "icon": "icon.png",
  "author": "software-design",
  "license": "MIT",
  "commands": [
    {
      "name": "search",
      "title": "easyVerein durchsuchen",
      "description": "Seiten, Einstellungen, Aktionen und Datensätze durchsuchen",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "apiToken",
      "title": "API-Schlüssel",
      "description": "API-Schlüssel aus easyVerein (Einstellungen → API)",
      "type": "password",
      "required": true
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.83.0",
    "@raycast/utils": "^1.17.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.11",
    "@types/node": "^22.0.0",
    "@types/react": "19.0.10",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "typescript": "^5.4.5",
    "vitest": "^3.2.7"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish",
    "fix-lint": "ray lint --fix",
    "test": "vitest run"
  },
  "overrides": {
    "@types/react": "19.0.10"
  }
}
