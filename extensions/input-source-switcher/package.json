{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "input-source-switcher",
  "title": "Input Source Switcher",
  "description": "Switch keyboard layouts and input methods by name — no cycling required.",
  "icon": "extension-icon.png",
  "author": "digitalby",
  "categories": ["System"],
  "license": "MIT",
  "commands": [
    {
      "name": "switch-input-source",
      "title": "Switch Input Source",
      "subtitle": "Input Source Switcher",
      "description": "List and switch keyboard layouts and input methods by name.",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.93.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.11",
    "@types/jest": "^29.5.12",
    "@types/node": "20.8.10",
    "@types/react": "18.3.3",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.0",
    "typescript": "^5.4.5"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish",
    "test": "jest",
    "test:unit": "jest tests/sources.test.ts",
    "test:integration": "jest tests/helper.integration.test.ts"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.ts"],
    "transform": {
      "^.+\\.tsx?$": ["ts-jest", { "tsconfig": "tsconfig.test.json" }]
    }
  }
}
