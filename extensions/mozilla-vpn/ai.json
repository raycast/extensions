{
  "instructions": "Use explicit action parameters when controlling Mozilla VPN:\n\n• action='connect' - Connect to VPN (optionally with country/city)\n• action='disconnect' - Disconnect VPN\n• action='status' - Show VPN status and IP\n• action='list' - List all available countries\n• action='list_cities' - List cities in a country (requires country parameter)\n• action='list_servers' - List servers (requires country, optionally city)\n• action='change_server' - Change server without connecting\n• action='open_account' - Open Mozilla account portal (use for 'Open Account', 'Open My Account', 'Account', 'Manage subscription')\n\nWhen users specify country and/or city with connect, pass those parameters to connect to that location.",
  "evals": [
    {
      "input": "@mozilla-vpn Connect to VPN",
      "mocks": {
        "mozilla-vpn-control": "VPN connected using your last configuration.\nServer: Seattle, WA, USA\nNew IP address: 24.113.186.164"
      },
      "expected": [
        { "callsTool": { "name": "mozilla-vpn-control", "arguments": { "action": "connect" } } }
      ],
      "usedAsExample": true
    },
    {
      "input": "@mozilla-vpn Disconnect VPN",
      "mocks": {
        "mozilla-vpn-control": "Mozilla VPN disconnected successfully."
      },
      "expected": [
        { "callsTool": { "name": "mozilla-vpn-control", "arguments": { "action": "disconnect" } } }
      ],
      "usedAsExample": true
    },
