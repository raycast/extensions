{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "proton-pass",
  "title": "Proton Pass",
  "description": "Search and manage your Proton Pass items, generate passwords, and get TOTP codes.",
  "icon": "extension-icon.png",
  "author": "izyuumi",
  "contributors": [
    "FeernandoOFF"
  ],
  "platforms": [
    "macOS",
    "Windows"
  ],
  "categories": [
    "Security",
    "Productivity"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "search-items",
      "title": "Search Items",
      "subtitle": "Proton Pass",
      "description": "Search all items across vaults",
      "mode": "view"
    },
    {
      "name": "list-vaults",
      "title": "List Vaults",
      "subtitle": "Proton Pass",
      "description": "View all your Proton Pass vaults",
      "mode": "view"
    },
    {
      "name": "generate-password",
      "title": "Generate Password",
      "subtitle": "Proton Pass",
      "description": "Generate secure passwords or passphrases",
      "mode": "view",
      "preferences": [
        {
          "name": "defaultPasswordType",
          "type": "dropdown",
          "title": "Password Type",
          "description": "Type generated by default.",
          "default": "random",
          "required": false,
          "data": [
            {
              "title": "Random",
              "value": "random"
            },
            {
              "title": "Passphrase",
              "value": "passphrase"
            }
          ]
        },
        {
          "name": "defaultPasswordLength",
          "type": "textfield",
          "title": "Password Length",
          "description": "Characters in random passwords, from 8 to 128.",
          "default": "20",
          "required": false
        },
        {
          "name": "includeUppercase",
          "type": "checkbox",
          "title": "Uppercase",
          "label": "Use uppercase letters",
          "description": "In random passwords.",
          "default": true,
          "required": false
        },
        {
          "name": "includeSymbols",
          "type": "checkbox",
          "title": "Symbols",
          "label": "Use symbols",
          "description": "In random passwords.",
          "default": true,
          "required": false
        },
        {
          "name": "includeNumbers",
          "type": "checkbox",
          "title": "Numbers",
          "label": "Use numbers",
          "description": "In random passwords and passphrases.",
          "default": true,
          "required": false
        },
        {
          "name": "defaultPassphraseWords",
          "type": "dropdown",
          "title": "Passphrase Words",
          "description": "Number of words in passphrases.",
          "default": "4",
          "required": false,
          "data": [
            {
              "title": "3",
              "value": "3"
            },
            {
              "title": "4",
              "value": "4"
            },
            {
              "title": "5",
              "value": "5"
            },
            {
              "title": "6",
              "value": "6"
            },
            {
              "title": "7",
              "value": "7"
            },
            {
              "title": "8",
              "value": "8"
            },
            {
              "title": "9",
              "value": "9"
            },
            {
              "title": "10",
              "value": "10"
            }
          ]
        },
        {
          "name": "passphraseSeparator",
          "type": "dropdown",
          "title": "Passphrase Separator",
          "description": "Between the words of passphrases.",
          "default": "hyphens",
          "required": false,
          "data": [
            {
              "title": "Hyphens",
              "value": "hyphens"
            },
            {
              "title": "Spaces",
              "value": "spaces"
            },
            {
              "title": "Periods",
              "value": "periods"
            },
            {
              "title": "Commas",
              "value": "commas"
            },
            {
              "title": "Underscores",
              "value": "underscores"
            },
            {
              "title": "Numbers",
              "value": "numbers"
            },
            {
              "title": "Numbers and Symbols",
              "value": "numbers-and-symbols"
            }
          ]
        },
        {
          "name": "capitalizeWords",
          "type": "checkbox",
          "title": "Capitalization",
          "label": "Capitalize words",
          "description": "In passphrases.",
          "default": true,
          "required": false
        }
      ]
    },
    {
      "name": "get-totp",
      "title": "Get TOTP Code",
      "subtitle": "Proton Pass",
      "description": "Get TOTP codes for your accounts",
      "mode": "view"
    },
    {
      "name": "login",
      "title": "Login to Proton Pass",
      "subtitle": "Proton Pass",
      "description": "Check authentication status and login",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "cliPath",
      "type": "textfield",
      "title": "CLI Path",
      "description": "Path to pass-cli executable",
      "default": "pass-cli",
      "required": false
    },
    {
      "name": "copyPasswordTransient",
      "type": "checkbox",
      "title": "Transient Clipboard",
      "label": "Clear password from clipboard after paste",
      "description": "When enabled, passwords will be cleared from clipboard after pasting",
      "default": true,
      "required": false
    },
    {
      "name": "enableBackgroundRefresh",
      "type": "checkbox",
      "title": "Background Refresh",
      "label": "Automatically refresh cached vault and item data",
      "description": "When enabled, cached results will refresh in the background",
      "default": true,
      "required": false
    },
    {
      "name": "cacheExpiration",
      "type": "dropdown",
      "title": "Cache Expiration",
      "description": "How long cached metadata is considered fresh. Older data is still shown instantly while it refreshes in the background.",
      "default": "5",
      "required": false,
      "data": [
        {
          "title": "5 minutes",
          "value": "5"
        },
        {
          "title": "1 hour",
          "value": "60"
        },
        {
          "title": "5 hours",
          "value": "300"
        },
        {
          "title": "1 day",
          "value": "1440"
        },
        {
          "title": "7 days",
          "value": "10080"
        },
        {
          "title": "30 days",
          "value": "43200"
        }
      ]
    },
    {
      "name": "enableWebIntegration",
      "type": "checkbox",
      "title": "Web Integration",
      "label": "Match active browser tab URL in Search Items",
      "description": "When enabled, Search Items auto-selects logins matching the active tab URL (Raycast web extension required)",
      "default": true,
      "required": false
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.103.10",
    "@raycast/utils": "^1.17.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.4",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "test": "node -e \"require('node:fs').rmSync('.test-build',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && node -e \"const{readdirSync}=require('node:fs'),{join}=require('node:path'),{spawnSync}=require('node:child_process');const tests=readdirSync('.test-build',{recursive:true}).filter(f=>f.endsWith('.test.js')).map(f=>join('.test-build',f));process.exit(spawnSync(process.execPath,['--test',...tests],{stdio:'inherit'}).status??1)\"",
    "prepublishOnly": "echo \"\\n\\nIt seems like you are trying to publish the Raycast extension to npm.\\n\\nIf you did intend to publish it to npm, remove the \\`prepublishOnly\\` script and rerun \\`npm publish\\` again.\\nIf you wanted to publish it to the Raycast Store instead, use \\`npm run publish\\` instead.\\n\\n\" && exit 1",
    "publish": "npx @raycast/api@latest publish"
  }
}
