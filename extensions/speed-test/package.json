{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "speed-test",
  "title": "Instant Speed Test",
  "description": "Minimal fast.com-style internet speed test that shows your download speed live, then upload and latency.",
  "icon": "icon.png",
  "author": "colin_grob",
  "platforms": [
    "macOS"
  ],
  "categories": [
    "System",
    "Developer Tools"
  ],
  "keywords": [
    "speed test",
    "speedtest",
    "internet",
    "bandwidth",
    "fast.com",
    "download",
    "upload",
    "latency",
    "wifi"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "speed-test",
      "title": "Run Speed Test",
      "subtitle": "Instant Speed Test",
      "description": "Measure your download speed live, then upload speed and latency.",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^2.10.1"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "~5.9.0"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}
