{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "pulse",
  "title": "Pulse",
  "description": "Search stocks, indices and crypto across US, Hong Kong, China, Japan, Korea and Taiwan in five languages, with live prices, today's chart, favorites in the menu bar and AI tools.",
  "icon": "extension-icon.png",
  "author": "fatwang266",
  "categories": [
    "Finance"
  ],
  "license": "MIT",
  "platforms": [
    "macOS"
  ],
  "commands": [
    {
      "name": "search-symbol",
      "title": "Search Symbol",
      "subtitle": "Pulse",
      "description": "Find a stock, index or crypto pair by ticker or by name in English, Chinese, Japanese or Korean, and see its price and today's chart.",
      "mode": "view",
      "keywords": [
        "stock",
        "quote",
        "ticker",
        "crypto",
        "market",
        "股票",
        "行情",
        "株価",
        "주식"
      ]
    },
    {
      "name": "menu-bar-favorites",
      "title": "Favorites in Menu Bar",
      "subtitle": "Pulse",
      "description": "Show your favorite symbols' prices and changes in the menu bar. The first favorite leads the menu bar title.",
      "mode": "menu-bar",
      "interval": "5m",
      "keywords": [
        "favorites",
        "watchlist",
        "menu bar",
        "stock",
        "crypto"
      ],
      "preferences": [
        {
          "name": "titleStyle",
          "title": "Menu Bar Title",
          "description": "What the menu bar shows for your first favorite.",
          "type": "dropdown",
          "required": false,
          "default": "change",
          "data": [
            {
              "title": "Symbol and Change",
              "value": "change"
            },
            {
              "title": "Symbol, Price and Change",
              "value": "full"
            },
            {
              "title": "Symbol and Price",
              "value": "price"
            },
            {
              "title": "Icon Only",
              "value": "icon"
            }
          ]
        }
      ]
    }
  ],
  "tools": [
    {
      "name": "search-symbols",
      "title": "Search Symbols",
      "description": "Find stocks, ETFs, indices and Binance Spot crypto pairs by ticker or by name in English, Chinese, Japanese or Korean, and get the exact symbols the other Pulse tools take."
    },
    {
      "name": "get-quotes",
      "title": "Get Quotes",
      "description": "Get the latest price, today's change, open, high, low, previous close, market session and quote delay for up to 10 symbols."
    },
    {
      "name": "get-favorites",
      "title": "Get Favorites",
      "description": "List the person's favorite symbols in Pulse, in order, with each one's latest price and change."
    },
    {
      "name": "add-favorites",
      "title": "Add Favorites",
      "description": "Add symbols to the person's Pulse favorites, which Search Symbol and the menu bar show first."
    },
    {
      "name": "remove-favorites",
      "title": "Remove Favorites",
      "description": "Remove symbols from the person's Pulse favorites."
    }
  ],
  "ai": {
    "instructions": "Pulse prices stocks, ETFs and indices from Yahoo Finance and crypto from Binance Spot. It covers the US, Hong Kong, China A-shares, Japan, Korea and Taiwan.\nWhen the person names a company, index or coin instead of giving a ticker, call search-symbols first and use the symbol it returns. Never guess a ticker suffix: Taiwan has .TW and .TWO, Korea .KS and .KQ.\nCrypto symbols are Binance pairs written BASE/QUOTE, like BTC/USDT. Their change is over the last 24 hours, not since a close.\nAlways give the currency with a price, and say when a quote is delayed or the market is closed, using the session and delay the tool returns.\n\"My stocks\", \"my watchlist\" and \"my favorites\" mean the person's Pulse favorites: use get-favorites, then get-quotes for the ones you discuss when you need their session or delay.\nAnswer in the language the person writes in, and keep company names as search-symbols returns them.\nDo not give investment advice; report the numbers.",
    "evals": [
      {
        "input": "@pulse how is Apple doing today?",
        "mocks": {
          "search-symbols": {
            "results": [
              {
                "symbol": "AAPL",
                "name": "Apple Inc.",
                "type": "equity",
                "market": "US",
                "exchange": "NASDAQ",
                "url": "https://finance.yahoo.com/quote/AAPL"
              }
            ]
          },
          "get-quotes": {
            "quotes": [
              {
                "symbol": "AAPL",
                "name": "Apple Inc.",
                "price": 229.5,
                "currency": "USD",
                "changePercent": 1.23,
                "changeMeasuredAgainst": "the previous close",
                "open": 227.1,
                "high": 230.2,
                "low": 226.8,
                "previousClose": 226.71,
                "session": "Market open",
                "lastTradeAt": "2026-11-12T15:30:00.000Z",
                "delay": "No exchange delay",
                "exchange": "NasdaqGS",
                "source": "Yahoo Finance",
                "url": "https://finance.yahoo.com/quote/AAPL"
              }
            ]
          }
        },
        "expected": [
          {
            "callsTool": {
              "name": "search-symbols",
              "arguments": {
                "query": {
                  "includes": "Apple"
                }
              }
            }
          },
          {
            "callsTool": {
              "name": "get-quotes",
              "arguments": {
                "symbols": [
                  "AAPL"
                ]
              }
            }
          }
        ]
      },
      {
        "input": "@pulse 台積電現在多少錢？",
        "mocks": {
          "search-symbols": {
            "results": [
              {
                "symbol": "2330.TW",
                "name": "台積電",
                "type": "equity",
                "market": "Taiwan",
                "exchange": "TWSE",
                "url": "https://finance.yahoo.com/quote/2330.TW"
              }
            ]
          },
          "get-quotes": {
            "quotes": [
              {
                "symbol": "2330.TW",
                "name": "Taiwan Semiconductor Manufacturing Company Limited",
                "price": 1085,
                "currency": "TWD",
                "changePercent": -0.91,
                "changeMeasuredAgainst": "the previous close",
                "open": 1095,
                "high": 1100,
                "low": 1080,
                "previousClose": 1095,
                "session": "Market closed",
                "lastTradeAt": "2026-11-12T05:30:00.000Z",
                "delay": "Delayed 20 min",
                "exchange": "Taiwan",
                "source": "Yahoo Finance",
                "url": "https://finance.yahoo.com/quote/2330.TW"
              }
            ]
          }
        },
        "expected": [
          {
            "callsTool": {
              "name": "search-symbols",
              "arguments": {
                "query": {
                  "includes": "台積電"
                }
              }
            }
          },
          {
            "callsTool": {
              "name": "get-quotes",
              "arguments": {
                "symbols": [
                  "2330.TW"
                ]
              }
            }
          }
        ]
      },
      {
        "input": "@pulse how are my favorites doing?",
        "mocks": {
          "get-favorites": {
            "favorites": [
              {
                "symbol": "NVDA",
                "name": "NVIDIA Corporation",
                "type": "equity",
                "market": "US",
                "exchange": "NASDAQ",
                "url": "https://finance.yahoo.com/quote/NVDA",
                "price": 182.4,
                "currency": "USD",
                "changePercent": 2.1
              },
              {
                "symbol": "BTC/USDT",
                "name": "Bitcoin",
                "type": "crypto",
                "market": "Crypto",
                "exchange": "Binance Spot",
                "url": "https://www.binance.com/en/trade/BTC_USDT?type=spot",
                "price": 104250.5,
                "currency": "USDT",
                "changePercent": -0.4
              }
            ]
          }
        },
        "expected": [
          {
            "callsTool": "get-favorites"
          }
        ]
      },
      {
        "input": "@pulse add Bitcoin and Tencent to my favorites",
        "mocks": {
          "search-symbols": {
            "results": [
              {
                "symbol": "BTC/USDT",
                "name": "Bitcoin",
                "type": "crypto",
                "market": "Crypto",
                "exchange": "Binance Spot",
                "url": "https://www.binance.com/en/trade/BTC_USDT?type=spot"
              }
            ]
          },
          "add-favorites": {
            "added": [
              {
                "symbol": "BTC/USDT",
                "name": "Bitcoin",
                "type": "crypto",
                "market": "Crypto",
                "exchange": "Binance Spot",
                "url": "https://www.binance.com/en/trade/BTC_USDT?type=spot"
              },
              {
                "symbol": "0700.HK",
                "name": "Tencent Holdings",
                "type": "equity",
                "market": "Hong Kong",
                "exchange": "HKEX",
                "url": "https://finance.yahoo.com/quote/0700.HK"
              }
            ],
            "alreadyFavorites": [],
            "notFound": [],
            "favoriteCount": 2,
            "limit": 50
          }
        },
        "expected": [
          {
            "callsTool": "search-symbols"
          },
          {
            "callsTool": "add-favorites"
          }
        ]
      },
      {
        "input": "@pulse remove NVDA from my favorites",
        "mocks": {
          "remove-favorites": {
            "removed": [
              "NVDA"
            ],
            "notFavorites": [],
            "remaining": [
              "BTC/USDT"
            ]
          }
        },
        "expected": [
          {
            "callsTool": {
              "name": "remove-favorites",
              "arguments": {
                "symbols": [
                  "NVDA"
                ]
              }
            }
          }
        ]
      }
    ]
  },
  "preferences": [
    {
      "name": "nameLanguage",
      "title": "Name Language",
      "description": "The language company names are shown in. Search always matches every language.",
      "type": "dropdown",
      "required": false,
      "default": "auto",
      "data": [
        {
          "title": "Match System",
          "value": "auto"
        },
        {
          "title": "English",
          "value": "en"
        },
        {
          "title": "简体中文",
          "value": "zh-Hans"
        },
        {
          "title": "繁體中文",
          "value": "zh-Hant"
        },
        {
          "title": "日本語",
          "value": "ja"
        },
        {
          "title": "한국어",
          "value": "ko"
        }
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^2.10.1",
    "@raycast/utils": "^2.3.3",
    "opencc-js": "^1.4.2"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "echo \"\\n\\nIt seems like you are trying to publish the Raycast extension to npm.\\n\\nIf you did intend to publish it to npm, remove the \\`prepublishOnly\\` script and rerun \\`npm publish\\` again.\\nIf you wanted to publish it to the Raycast Store instead, use \\`npm run publish\\` instead.\\n\\n\" && exit 1",
    "publish": "npx @raycast/api@latest publish"
  },
  "contributors": [
    "1weiho"
  ]
}
