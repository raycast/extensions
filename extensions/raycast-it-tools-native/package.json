{
  "name": "raycast-it-tools-native",
  "version": "0.1.0",
  "description": "Native Raycast tools for date/time, JSON, and text hashing",
  "private": true,
  "scripts": {
    "dev": "ray develop",
    "build": "ray build -e dist",
    "lint": "ray lint",
    "fix-lint": "ray lint --fix"
  },
  "dependencies": {
    "@raycast/api": "^1.99.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.0",
    "@types/node": "^20.17.24",
    "@types/react": "^19.0.10",
    "eslint": "^8.57.1",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "title": "IT Tools Native",
  "icon": "icon.png",
  "author": "CrazyCollin",
  "categories": [
    "Developer Tools"
  ],
  "keywords": [
    "date",
    "time",
    "json",
    "hash",
    "developer"
  ],
  "license": "MIT",
  "platforms": [
    "macOS"
  ],
  "commands": [
    {
      "name": "tools",
