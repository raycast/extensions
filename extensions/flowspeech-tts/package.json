{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "flowspeech-tts",
  "version": "1.0.0",
  "title": "FlowSpeech TTS",
  "description": "Turn selected or copied text into natural speech with FlowSpeech",
  "icon": "extension-icon.png",
  "author": "waeckerlinfederowicz66-sketch",
  "categories": [
    "Productivity",
    "Other"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "speak-selected",
      "title": "Speak Selected Text",
      "description": "Read the currently selected text with FlowSpeech",
      "mode": "no-view"
    },
    {
      "name": "speak-copied",
      "title": "Speak Copied Text",
      "description": "Read text from the clipboard with FlowSpeech",
      "mode": "no-view"
    }
  ],
  "preferences": [
    {
      "name": "apiKey",
      "title": "FlowSpeech API Key",
      "description": "Create an API key in your FlowSpeech settings",
      "type": "password",
      "required": true
    },
    {
      "name": "voiceName",
      "title": "Voice",
      "description": "Voice used for speech generation",
      "type": "dropdown",
      "required": true,
      "default": "Kore",
      "data": [
        {
          "title": "Kore",
          "value": "Kore"
        },
        {
          "title": "Puck",
          "value": "Puck"
        },
        {
          "title": "Charon",
          "value": "Charon"
        },
        {
          "title": "Aoede",
          "value": "Aoede"
        },
        {
          "title": "Fenrir",
          "value": "Fenrir"
        }
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "2.1.2"
  },
  "devDependencies": {
    "@raycast/eslint-config": "2.2.0",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "eslint": "10.0.2",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  },
  "platforms": [
    "macOS"
  ]
}
