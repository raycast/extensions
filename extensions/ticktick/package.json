{
  "name": "ticktick",
  "title": "TickTick",
  "description": "Full-featured TickTick integration — tasks, projects, tags, habits, Pomodoro, smart lists, Eisenhower matrix, menu bar, and more.",
  "icon": "tick-logo.png",
  "author": "appest",
  "contributors": [
    "viduycheung",
    "Alireza",
    "yakitrak",
    "ridemountainpig",
    "ysrazsingh"
  ],
  "license": "MIT",
  "categories": [
    "Productivity"
  ],
  "preferences": [
    {
      "name": "defaultTitle",
      "description": "Default title for new task.",
      "defaultValue": "none",
      "title": "Default Title",
      "required": false,
      "type": "dropdown",
      "data": [
        {
          "title": "None",
          "value": "none"
        },
        {
          "title": "Clipboard",
          "value": "clipboard"
        },
        {
          "title": "Selection",
          "value": "selection"
        }
      ]
    },
    {
      "name": "defaultDate",
      "type": "dropdown",
      "data": [
        {
          "title": "None",
          "value": "none"
        },
        {
          "title": "Today",
          "value": "today"
        },
        {
          "title": "Tomorrow",
          "value": "tomorrow"
        },
        {
          "title": "Day after Tomorrow",
          "value": "dayAfterTomorrow"
        },
        {
          "title": "Next Week",
          "value": "nextWeek"
        }
      ],
      "default": "none",
      "required": false,
      "title": "Default Date",
      "description": "Default date for new task."
    }
  ],
  "commands": [
    {
      "name": "today",
      "title": "Today",
      "subtitle": "TickTick",
      "description": "View tasks due today",
      "mode": "view",
      "icon": "tick-logo.png"
    },
    {
      "name": "inbox",
      "title": "Inbox",
      "subtitle": "TickTick",
      "description": "View tasks in your inbox",
      "mode": "view",
      "icon": "tick-logo.png"
    },
    {
      "name": "next7days",
      "title": "Next 7 Days",
      "subtitle": "TickTick",
      "description": "View upcoming tasks for the next 7 days",
      "mode": "view",
      "icon": "tick-logo.png"
    },
    {
      "name": "projects",
      "title": "Projects",
      "subtitle": "TickTick",
      "description": "Browse tasks by project",
      "mode": "view",
      "icon": "tick-logo.png"
    },
    {
      "name": "eisenhower",
      "title": "Eisenhower Matrix",
      "subtitle": "TickTick",
      "description": "View tasks by urgency and importance",
      "mode": "view",
      "icon": "tick-logo.png"
    },
    {
      "name": "habits",
      "title": "Habits",
      "subtitle": "TickTick",
      "description": "Track and check in your habits",
      "mode": "view",
      "icon": "tick-logo.png"
    },
    {
      "name": "pomodoro",
      "title": "Pomodoro",
      "subtitle": "TickTick",
      "description": "Focus timer with TickTick integration",
      "mode": "view",
      "icon": "tick-logo.png"
    },
    {
      "name": "search",
      "title": "Search Tasks",
      "subtitle": "TickTick",
      "description": "Search all your TickTick tasks",
      "mode": "view",
      "icon": "tick-logo.png"
    },
    {
      "name": "quick-add",
      "title": "Quick Add Task",
      "subtitle": "TickTick",
      "description": "Quickly add a task to TickTick",
      "mode": "view",
      "icon": "tick-logo.png"
    },
    {
      "name": "overdue",
      "title": "Overdue",
      "subtitle": "TickTick",
      "description": "View overdue tasks",
      "mode": "view",
      "icon": "tick-logo.png"
    },
    {
      "name": "tags",
      "title": "Tags",
      "subtitle": "TickTick",
      "description": "Browse tasks by tag",
      "mode": "view",
      "icon": "tick-logo.png"
    },
    {
      "name": "completed",
      "title": "Completed",
      "subtitle": "TickTick",
      "description": "View recently completed tasks",
      "mode": "view",
      "icon": "tick-logo.png"
    },
    {
      "name": "filters",
      "title": "Smart Lists",
      "subtitle": "TickTick",
      "description": "View tasks from your TickTick smart lists / filters",
      "mode": "view",
      "icon": "tick-logo.png"
    },
    {
      "name": "templates",
      "title": "Templates",
      "subtitle": "TickTick",
      "description": "Create tasks from TickTick templates",
      "mode": "view",
      "icon": "tick-logo.png"
    },
    {
      "name": "manage-projects",
      "title": "Manage Projects",
      "subtitle": "TickTick",
      "description": "Create, rename, archive, or delete projects",
      "mode": "view",
      "icon": "tick-logo.png"
    },
    {
      "name": "focus-stats",
      "title": "Focus Stats",
      "subtitle": "TickTick",
      "description": "View Pomodoro and focus statistics",
      "mode": "view",
      "icon": "tick-logo.png"
    },
    {
      "name": "trash",
      "title": "Trash",
      "subtitle": "TickTick",
      "description": "View and restore deleted tasks",
      "mode": "view",
      "icon": "tick-logo.png"
    },
    {
      "name": "manage-tags",
      "title": "Manage Tags",
      "subtitle": "TickTick",
      "description": "Create, rename, and delete tags",
      "mode": "view",
      "icon": "tick-logo.png"
    },
    {
      "name": "menu-bar",
      "title": "Menu Bar",
      "subtitle": "TickTick",
      "description": "TickTick status in your menu bar — timer, overdue count, quick actions",
      "mode": "menu-bar",
      "interval": "10s",
      "icon": "tick-logo.png"
    },
    {
      "name": "background-check",
      "title": "Background Alerts",
      "subtitle": "TickTick",
      "description": "Checks for overdue tasks and Pomodoro completion in the background",
      "mode": "no-view",
      "interval": "5m",
      "icon": "tick-logo.png"
    },
    {
      "name": "logout",
      "title": "Disconnect TickTick Account",
      "subtitle": "TickTick",
      "description": "Remove stored OAuth tokens and re-authenticate",
      "mode": "no-view",
      "icon": "tick-logo.png"
    }
  ],
  "tools": [
    {
      "name": "get-tasks",
      "title": "Get Tasks",
      "description": "Get tasks in smart list"
    },
    {
      "name": "add-task",
      "title": "Add Task",
      "description": "Add task to TickTick"
    },
    {
      "name": "get-lists",
      "title": "Get Lists",
      "description": "Get Lists in TickTick"
    }
  ],
  "ai": {
    "instructions": "",
    "evals": [
      {
        "input": "@ticktick get tasks in today",
        "mocks": {
          "get-tasks": [
            {
              "id": "6821491f8e31d12726fb9992",
              "title": "Buy oat milk",
              "content": "",
              "desc": "",
              "priority": 3,
              "projectId": "6821491f8e31d12726fb9993",
              "kind": "TEXT",
              "startDate": "2025-05-11T16:00:00+0000",
              "dueDate": "",
              "isAllDay": true,
              "isFloating": false,
              "timeZone": "Asia/Shanghai",
              "items": [],
              "tags": []
            }
          ]
        },
        "expected": [
          {
            "callsTool": {
              "name": "get-tasks",
              "arguments": {
                "smartProjectId": "today"
              }
            }
          }
        ]
      },
      {
        "input": "@ticktick get tasks in next 7 days",
        "mocks": {
          "get-tasks": [
            {
              "id": "6821491f8e31d12726fb9992",
              "title": "Buy oat milk",
              "content": "",
              "desc": "",
              "priority": 3,
              "projectId": "6821491f8e31d12726fb9993",
              "kind": "TEXT",
              "startDate": "2025-05-11T16:00:00+0000",
              "dueDate": "",
              "isAllDay": true,
              "isFloating": false,
              "timeZone": "Asia/Shanghai",
              "items": [],
              "tags": []
            }
          ]
        },
        "expected": [
          {
            "callsTool": {
              "name": "get-tasks",
              "arguments": {
                "smartProjectId": "next7Days"
              }
            }
          }
        ]
      }
    ]
  },
  "dependencies": {
    "@raycast/api": "^1.104.19",
    "@raycast/utils": "^1.19.0",
    "date-fns": "^3.6.0",
    "lodash": "^4.17.21",
    "moment": "^2.29.1",
    "moment-timezone": "^0.5.44",
    "similarity": "^1.2.1"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.11",
    "@types/lodash": "^4.14.194",
    "@types/node": "22.19.17",
    "@types/react": "19.0.10",
    "@types/similarity": "^1.2.1",
    "eslint": "^7.32.0",
    "prettier": "^2.8.7",
    "typescript": "^5.4.0"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "ray publish"
  }
}
