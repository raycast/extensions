  "preferences": [
    {
      "name": "delivery",
      "title": "After Generating",
      "description": "Copy the new value, optionally close Raycast, or paste it into the previously focused app.",
      "type": "dropdown",
      "required": true,
      "default": "copy-and-close",
      "data": [
        {
          "title": "Copy and Close Raycast",
          "value": "copy-and-close"
        },
        {
          "title": "Copy to Clipboard",
          "value": "copy"
        },
        {
          "title": "Paste into Previous App",
          "value": "paste"
        }
      ]
    },
    {
      "name": "easyToRead",
      "title": "Character Set",
      "description": "Avoid look-alike characters such as O, 0, I, l, and 1. This makes secrets easier to read and type manually.",
      "type": "checkbox",
      "label": "Use easy-to-read characters only",
      "required": false,
      "default": false
    }
  ],
  "commands": [
