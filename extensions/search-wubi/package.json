{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "search-wubi",
  "title": "Search Wubi",
  "description": "五笔拆解查询工具，支持 86 版五笔字根图解显示。",
  "icon": "command-icon.png",
  "author": "androidcn",
  "categories": [
    "Productivity",
    "Data"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "index",
      "title": "Search Wubi",
      "subtitle": "五笔拆解查询",
      "description": "查询汉字的五笔 86 版编码及字根拆解图解",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.72.1",
    "@raycast/utils": "^1.10.1",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.8",
    "@types/node": "20.8.10",
    "@types/node-fetch": "^2.6.9",
    "@types/react": "18.2.27",
    "eslint": "^8.51.0",
    "prettier": "^3.0.3",
    "react": "18.2.0",
    "typescript": "^5.2.2"
  },
  "overrides": {
    "@types/react": "18.2.27"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}
