{
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "target": "ES2021",
    "useDefineForClassFields": true,
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2021"],
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": ["src"]
}
