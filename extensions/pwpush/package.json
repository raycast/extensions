{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "pwpush",
  "title": "PwPush",
  "description": "Create secure, expiring password pushes with PwPush. Supports the public service and self-hosted instances.",
  "icon": "extension-icon.png",
  "author": "mouxy",
  "categories": [
    "Productivity"
  ],
  "keywords": [
    "password",
    "security",
    "secrets",
    "share",
    "pwpush"
  ],
  "platforms": [
    "macOS"
  ],
  "license": "MIT",
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "lint": "ray lint",
    "fix": "ray lint --fix",
    "typecheck": "npx tsc --noEmit",
    "test": "node --test --require tsx test/*.test.ts"
  },
  "preferences": [
    {
      "name": "serverUrl",
      "title": "Server URL",
      "description": "The URL of your PwPush server. Leave empty to use the public https://eu.pwpush.com service.",
      "type": "textfield",
      "required": false,
      "placeholder": "https://eu.pwpush.com"
    },
    {
      "name": "apiKey",
      "title": "API Key",
      "description": "Your PwPush API key. Required for paid or self-hosted instances with authentication.",
      "type": "password",
      "required": false,
      "placeholder": "Enter your API key"
    }
  ],
  "commands": [
    {
      "name": "create-push",
      "title": "Create Push",
      "description": "Create a new PwPush secret link.",
      "mode": "view",
      "icon": "command-icon.png"
    },
    {
      "name": "push-history",
      "title": "Push History",
      "description": "View recent PwPush secret links.",
      "mode": "view",
      "icon": "command-icon.png"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.23",
    "@raycast/utils": "^2.2.7"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "prettier": "^3.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.6.3"
  }
}
