{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "insert-date",
  "title": "Insert Date",
  "description": "Insert the current date at the cursor in any app",
  "icon": "extension-icon.png",
  "author": "dustinchambers",
  "categories": ["Productivity"],
  "version": "1.0.0",
  "license": "MIT",
  "commands": [
    {
      "name": "insert-date",
      "title": "Insert Date at Cursor",
      "description": "Silently inserts the formatted current date at the cursor",
      "mode": "no-view",
      "preferences": [
        {
          "name": "dateFormat",
          "title": "Date Format",
          "description": "Choose a preset or select Custom to use the field below",
          "type": "dropdown",
          "required": false,
          "default": "%Y%m%d",
          "data": [
            { "title": "20260507 (ISO default)", "value": "%Y%m%d" },
            { "title": "05/07/2026 (US)", "value": "%m/%d/%Y" },
            { "title": "07/05/2026 (EU)", "value": "%d/%m/%Y" },
            { "title": "May 7, 2026 (long form)", "value": "%B %-d, %Y" },
            { "title": "Thu, May 7 (abbreviated)", "value": "%a, %b %-d" },
            { "title": "2026-05-07 21:07 (date + time)", "value": "%Y-%m-%d %H:%M" },
            { "title": "21:07 (time only)", "value": "%H:%M" },
            { "title": "Custom (use field below)", "value": "custom" }
          ]
        },
        {
          "name": "customFormat",
          "title": "Custom Format",
          "description": "Tokens: YYYY (year), MM (month), DD (day), HH (hour), mm (minute), ss (second). e.g. YYYY-MM-DD or MM/DD/YYYY",
          "type": "textfield",
          "required": false,
          "default": "",
          "placeholder": "YYYY-MM-DD"
        }
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.11",
    "@types/jest": "^29.5.14",
    "@types/node": "22.13.4",
    "@types/react": "19.0.8",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.3.2",
    "typescript": "^5.7.3"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "test": "jest"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/src/__tests__/**/*.test.ts"]
  }
}
