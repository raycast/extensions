{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "keyboard-layout-search",
  "title": "Keyboard Layout Search",
  "description": "Find apps and search the web after typing a query with the wrong keyboard layout.",
  "icon": "extension-icon.png",
  "author": "rogovk",
  "platforms": ["macOS"],
  "categories": ["Productivity"],
  "license": "MIT",
  "preferences": [
    {
      "name": "layoutMode",
      "title": "Source Keyboard Layout",
      "description": "Automatically detect the source layout or always convert from a specific layout to US English.",
      "type": "dropdown",
      "required": true,
      "default": "auto",
      "data": [
        { "title": "Automatic (Recommended)", "value": "auto" },
        { "title": "Russian — ЙЦУКЕН", "value": "russian" },
        { "title": "Ukrainian — ЙЦУКЕН", "value": "ukrainian" },
        { "title": "French — AZERTY", "value": "french" },
        { "title": "German — QWERTZ", "value": "german" },
        { "title": "Greek", "value": "greek" }
      ]
    }
  ],
  "commands": [
    {
      "name": "fix-layout",
      "title": "Fix Keyboard Layout",
      "description": "Convert a query to US English and find applications or search the web.",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^2.0.4"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "tsx": "^4.23.12",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "dev": "ray develop",
    "build": "ray build -e dist",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts",
    "lint": "ray lint",
    "fix-lint": "ray lint --fix",
    "format": "prettier --write src",
    "publish": "npx @raycast/api@latest publish"
  }
}
