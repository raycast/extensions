{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "json-tree",
  "title": "JSON Tree",
  "description": "Browse clipboard JSON as a searchable, collapsible tree",
  "icon": "icon.png",
  "author": "enjisene",
  "platforms": [
    "macOS"
  ],
  "categories": [
    "Developer Tools"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "json-tree",
      "title": "JSON Tree",
      "description": "View JSON from the clipboard as a tree",
      "mode": "view"
    }
  ],
  "scripts": {
    "dev": "ray develop",
    "build": "ray build -e dist",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@raycast/api": "^1.103.4",
    "react": "^19.1.1"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.4",
    "@types/node": "22.18.3",
    "@types/react": "19.1.13",
    "eslint": "^9.35.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
