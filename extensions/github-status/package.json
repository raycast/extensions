{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "github-status",
  "title": "GitHub Status",
  "description": "Quickly check why GitHub is down today",
  "icon": "command-icon.png",
  "author": "FezVrasta",
  "contributors": [
    "j3lte"
  ],
  "license": "MIT",
  "platforms": [
    "macOS",
    "Windows"
  ],
  "keywords": [
    "Productivity"
  ],
  "commands": [
    {
      "name": "index",
      "title": "Summary",
      "subtitle": "GitHub Status",
      "description": "Show the GitHub status summary",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.8",
    "@raycast/utils": "^2.2.3"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.1.1",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "eslint": "^10.0.2",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint"
  }
}
