{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "search-on-discogs",
  "title": "Search on Discogs",
  "description": "Search the currently playing track from the Music app on Discogs",
  "icon": "icon.png",
  "author": "FL0R1AN",
  "categories": [
    "Media",
    "Web"
  ],
  "license": "MIT",
  "platforms": [
    "macOS"
  ],
  "commands": [
    {
      "name": "search-on-discogs",
      "title": "Search on Discogs",
      "description": "Opens a Discogs search for the currently playing track in the Music app",
      "mode": "no-view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.98.0",
    "@raycast/utils": "^1.19.1"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.11",
    "@types/node": "20.8.10",
    "@types/react": "18.3.3",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "typescript": "^5.4.5"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}

