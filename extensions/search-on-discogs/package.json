{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "search-on-discogs",
  "title": "Search on Discogs",
  "description": "Search the currently playing track from the Music app on Discogs",
  "icon": "icon.png",
  "author": "FL0R1AN",
  "categories": [
    "Media",
    "Web"
  ],
  "license": "MIT",
  "platforms": [
    "macOS"
  ],
  "commands": [
    {
      "name": "search-on-discogs",
      "title": "Search on Discogs",
      "description": "Opens a Discogs search for the currently playing track in the Music app",
      "mode": "no-view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^2.6.2",
    "@raycast/utils": "^2.3.2"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}
