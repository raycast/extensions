{
  "name": "gantry",
  "title": "Gantry",
  "description": "Manage macOS launchd services — view, run, edit schedules, and tail logs",
  "icon": "extension-icon.png",
  "author": "eli_collinson",
  "categories": ["Developer Tools", "System"],
  "license": "MIT",
  "platforms": ["macOS"],
  "commands": [
    {
      "name": "search-jobs",
      "title": "Gantry",
      "description": "Browse and manage launchd services",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "showAppleServices",
      "type": "checkbox",
      "title": "Show Apple Services",
      "description": "Show Apple (com.apple.*) services in the job list",
      "default": false,
      "required": false,
      "label": "Show Apple Services"
    },
    {
      "name": "llmModel",
      "type": "dropdown",
      "title": "AI Model",
      "description": "AI model for log summaries and natural language schedule parsing",
      "required": false,
      "data": [
        { "title": "None", "value": "" },
        { "title": "Claude Haiku 4.5", "value": "claude-haiku-4-5-20251001" },
        { "title": "Gemini 3 Flash", "value": "gemini-3-flash-preview" },
        { "title": "GPT-5 Nano", "value": "gpt-5-nano" }
      ]
    },
    {
      "name": "anthropicApiKey",
      "type": "password",
      "title": "Anthropic API Key",
      "description": "API key for Claude models",
      "required": false
    },
    {
      "name": "googleApiKey",
      "type": "password",
      "title": "Google API Key",
      "description": "API key for Gemini models",
      "required": false
    },
    {
      "name": "openaiApiKey",
      "type": "password",
      "title": "OpenAI API Key",
      "description": "API key for GPT models",
      "required": false
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.93.3",
    "@raycast/utils": "^1.19.1"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.11",
    "@types/node": "22.x",
    "@types/react": "19.x",
    "eslint": "^8.57.0",
    "typescript": "^5.8.3"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}
