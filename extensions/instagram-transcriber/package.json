{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "instagram-transcriber",
  "title": "Instagram Video Transcriber",
  "description": "Transcribe Instagram videos using OpenAI Whisper API",
  "version": "1.0.0",
  "author": "jgfall",
  "license": "MIT",
  "icon": "icon.png",
  "categories": [
    "Media",
    "Productivity"
  ],
  "keywords": [
    "instagram",
    "transcription",
    "video",
    "whisper",
    "ai",
    "speech-to-text",
    "reel",
    "igtv"
  ],
  "commands": [
    {
      "name": "transcribe",
      "title": "Transcribe Instagram Video",
      "subtitle": "Instagram",
      "description": "Get transcript from Instagram video URL",
      "mode": "view",
      "icon": "icon.png"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.64.0",
    "@raycast/utils": "^1.10.0",
    "axios": "^1.6.2",
    "form-data": "^4.0.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.8",
    "@types/node": "20.8.10",
    "@types/react": "18.2.27",
    "eslint": "^8.51.0",
    "prettier": "^3.0.3",
    "typescript": "^5.2.2"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  },
  "preferences": [
    {
      "name": "whisperApiKey",
      "type": "password",
      "required": true,
      "title": "OpenAI API Key",
      "description": "Your OpenAI API key for Whisper transcription",
      "placeholder": "sk-..."
    }
  ]
}
