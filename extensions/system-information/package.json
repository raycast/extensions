{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "system-information",
  "title": "System Information",
  "description": "Quick access to your system information so you never have to open System Settings",
  "icon": "command-icon.png",
  "author": "Visual-Studio-Coder",
  "contributors": [
    "nagauta",
    "muhammadrizo"
  ],
  "platforms": [
    "macOS",
    "Windows"
  ],
  "categories": [
    "Developer Tools",
    "System"
  ],
  "keywords": [
    "system",
    "information",
    "macOS",
    "Windows",
    "tools",
    "productivity",
    "storage",
    "network",
    "processes",
    "system information",
    "system info"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "index",
      "title": "View System Information",
      "description": "View your system information",
      "mode": "view"
    }
  ],
  "tools": [
    {
      "name": "check-storage",
      "title": "Check Storage",
      "description": "See storage information"
    },
    {
      "name": "check-system-info",
      "title": "Check System Info",
      "description": "Get basic system information including hostname, chip/processor, memory, OS version, and serial number"
    },
    {
      "name": "check-network",
      "title": "Check Network",
      "description": "Get network devices and their IP addresses"
    },
    {
      "name": "list-processes",
      "title": "List Processes",
      "description": "List all running processes with their details"
    },
    {
      "name": "kill-process",
      "title": "Kill Process",
      "description": "Kill a specific process by its PID"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.24",
    "macos-release": "^3.5.1",
    "macos-version": "^6.0.0",
    "systeminformation": "^5.33.1"
  },
  "devDependencies": {
    "@raycast/eslint-config": "2.2.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.0"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "prepublishOnly": "echo \"\\n\\nIt seems like you are trying to publish the Raycast extension to npm.\\n\\nIf you did intend to publish it to npm, remove the \\`prepublishOnly\\` script and rerun \\`npm publish\\` again.\\nIf you wanted to publish it to the Raycast Store instead, use \\`npm run publish\\` instead.\\n\\n\" && exit 1",
    "publish": "npx @raycast/api@latest publish"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  },
  "ai": {
    "tools": [
      {
        "name": "check-system-info",
        "description": "Get basic system information including hostname, chip/processor, memory, OS version, and serial number",
        "parameters": {}
      },
      {
        "name": "check-storage",
        "description": "Get storage information including total, used, and free space",
        "parameters": {}
      },
      {
        "name": "check-network",
        "description": "Get network devices and their IP addresses",
        "parameters": {}
      },
      {
        "name": "list-processes",
        "description": "List all running processes with their details",
        "parameters": {}
      },
      {
        "name": "kill-process",
        "description": "Kill a specific process by its PID",
        "parameters": {
          "type": "object",
          "required": [
            "pid"
          ],
          "properties": {
            "pid": {
              "type": "number",
              "description": "The Process ID (PID) of the process to kill"
            }
          }
        }
      }
    ],
    "evals": [
      {
        "input": "@system-information What's the storage available on my computer?",
        "expected": [
          {
            "callsTool": "check-storage"
          }
        ],
        "mocks": {
          "check-storage": {
            "output": {
              "total": "500.00 GB",
              "used": "250.00 GB",
              "free": "250.00 GB",
              "percentUsed": "50.00%",
              "summary": "250.00 GB used of 500.00 GB (250.00 GB available)"
            }
          }
        }
      },
      {
        "input": "@system-information Show me information about my system",
        "expected": [
          {
            "callsTool": "check-system-info"
          }
        ],
        "mocks": {
          "check-system-info": {
            "output": {
              "hostname": "My-Computer",
              "chip": "AMD Ryzen 7 7730U with Radeon Graphics",
              "memory": "16.00 GB",
              "os": "Windows 11 Pro 25H2 (Build 26200.8973)",
              "kernel": "10.0.26200",
              "serialNumber": "C02XG0FDJGH7"
            }
          }
        }
      },
      {
        "input": "@system-information What network devices are connected?",
        "expected": [
          {
            "callsTool": "check-network"
          }
        ],
        "mocks": {
          "check-network": {
            "output": {
              "devices": [
                {
                  "name": "Ethernet",
                  "ip": "192.168.1.10"
                },
                {
                  "name": "Wi-Fi",
                  "ip": "192.168.1.11"
                }
              ],
              "count": 2
            }
          }
        }
      },
      {
        "input": "@system-information Show me all running processes",
        "expected": [
          {
            "callsTool": "list-processes"
          }
        ],
        "mocks": {
          "list-processes": {
            "output": {
              "processes": [
                {
                  "pid": 1234,
                  "name": "explorer",
                  "cpu": 0.5,
                  "mem": 1.2
                },
                {
                  "pid": 5678,
                  "name": "chrome",
                  "cpu": 3.2,
                  "mem": 5.7
                },
                {
                  "pid": 9012,
                  "name": "terminal",
                  "cpu": 0.1,
                  "mem": 0.8
                }
              ],
              "count": 3
            }
          }
        }
      },
      {
        "input": "@system-information Kill process with PID 1234",
        "expected": [
          {
            "callsTool": "kill-process"
          }
        ],
        "mocks": {
          "kill-process": {
            "input": {
              "pid": "1234"
            },
            "output": {
              "success": true,
              "message": "Process with PID 1234 has been terminated successfully."
            }
          }
        }
      }
    ]
  }
}
