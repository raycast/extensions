{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "number-to-stacks",
  "title": "Number to Stacks",
  "description": "Convert Minecraft item counts into stacks and back, with exact results for 64- and 16-item stacks.",
  "icon": "icon.png",
  "author": "sergi",
  "license": "MIT",
  "platforms": [
    "macOS",
    "Windows"
  ],
  "categories": [
    "Fun",
    "Productivity"
  ],
  "keywords": [
    "minecraft",
    "stack",
    "items",
    "calculator",
    "converter"
  ],
  "commands": [
    {
      "name": "number-to-stacks",
      "title": "Convert Minecraft Stacks",
      "description": "Convert expressions such as 144 to stacks or 1.5 stacks to items.",
      "mode": "view",
      "keywords": [
        "stacks",
        "minecraft",
        "items"
      ],
      "arguments": [
        {
          "name": "query",
          "type": "text",
          "placeholder": "144 to stacks or 2 stacks to items",
          "required": false
        }
      ]
    }
  ],
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "ray develop",
    "build": "ray build",
    "publish": "npx @raycast/api@latest publish",
    "lint": "ray lint"
  },
  "dependencies": {
    "@raycast/api": "^2.9.0",
    "@raycast/utils": "^2.3.3",
    "react": "19.0.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "^22.19.17",
    "@types/react": "19.0.10",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
