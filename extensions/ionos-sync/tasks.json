{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build",
      "type": "shell",
      "command": "npm run build",
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always" }
    },
    {
      "label": "Lint",
      "type": "shell",
      "command": "npm run lint",
      "group": "test"
    },
    {
      "label": "Dev Mode",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Fix Lint",
      "type": "shell",
      "command": "npm run fix-lint"
    }
  ]
}
