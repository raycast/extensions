{
    "$schema": "https://www.raycast.com/schemas/extension.json",
    "name": "ide-recents",
    "title": "IDE Recents",
    "description": "Search and open recent projects from VS Code, Trae, and Antigravity in one list",
    "icon": "icon.png",
    "author": "huid",
    "platforms": [
        "macOS"
    ],
    "categories": [
        "Developer Tools"
    ],
    "license": "MIT",
    "commands": [
        {
            "name": "index",
            "title": "Search Recent Projects",
            "subtitle": "VS Code / Trae / Antigravity",
            "description": "Search and open recent projects across all supported IDEs",
            "icon": "icon.png",
            "keywords": [
                "vsc",
                "vscode",
                "code",
                "trae",
                "antigravity",
                "agy",
                "ide",
                "recents",
                "recent"
            ],
            "mode": "view"
        }
    ],
    "dependencies": {
        "@raycast/api": "^1.104.24"
    },
    "devDependencies": {
        "@raycast/eslint-config": "^2.2.0",
        "@types/node": "22.13.10",
        "@types/react": "19.0.10",
        "eslint": "^9.22.0",
        "prettier": "^3.5.3",
        "typescript": "^5.8.2"
    },
    "scripts": {
        "build": "ray build",
        "dev": "ray develop",
        "fix-lint": "ray lint --fix",
        "lint": "ray lint",
        "publish": "npx @raycast/api@latest publish"
    }
}
