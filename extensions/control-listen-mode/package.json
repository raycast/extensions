{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "control-listen-mode",
  "title": "AirPods Listening Mode",
  "description": "Switch between Transparency and Noise Cancellation while wearing your AirPods.",
  "icon": "extension-icon.png",
  "author": "agility6",
  "categories": ["System"],
  "platforms": ["macOS"],
  "license": "MIT",
  "access": "public",
  "private": true,
  "commands": [
    {
      "name": "toggle-listening-mode",
      "title": "Toggle AirPods Listening Mode",
      "description": "Switch between Transparency and Noise Cancellation on the AirPods you are wearing.",
      "mode": "no-view",
      "keywords": ["AirPods", "ANC", "通透", "降噪"]
    }
  ],
  "dependencies": {
    "@raycast/api": "2.13.1"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.3"
  },
  "scripts": {
    "build:native": "swiftc -module-cache-path .swift-module-cache -O -o .airpods-listening-mode swift/Sources/AirPodsControl/ListeningModeController.swift swift/Sources/AirPodsControl/CoreAudioBackend.swift swift/Sources/AirPodsControl/ToggleRunner.swift native/main.swift",
    "dev": "ray develop",
    "build": "ray build -e dist -o dist",
    "lint": "ray lint",
    "typecheck": "tsc --noEmit",
    "probe": "npm run build:native --silent && ./.airpods-listening-mode probe",
    "test": "swiftc -module-cache-path .swift-module-cache -warnings-as-errors -o .native-tests swift/Sources/AirPodsControl/ListeningModeController.swift swift/Sources/AirPodsControl/CoreAudioBackend.swift tests/ListeningModeControllerTests.swift && ./.native-tests",
    "publish": "ray publish"
  }
}
