# CNB (cnb.cool) CI config for this source repo. It stays tracked here so the CNB
# pipeline keeps running, but the Raycast publish flow copies the whole directory
# into the fork and stages it with `git add` — where this file is still untracked,
# so listing it here keeps it out of the Store PR.
.cnb.yml
