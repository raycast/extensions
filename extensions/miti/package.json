{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "miti",
  "title": "Miti",
  "description": "Nepali calendar for macOS — Bikram Sambat dates, AD/BS conversion, Tithi, holidays, and reminders",
  "icon": "extension-icon.png",
  "author": "pratik_thaiba",
  "platforms": [
    "macOS"
  ],
  "categories": [
    "Productivity"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "index",
      "title": "Miti",
      "subtitle": "Bikram Sambat Calendar",
      "description": "Bikram Sambat calendar with date conversion, Tithi, and reminders",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.18",
    "@raycast/utils": "^2.2.5"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.1.1",
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "eslint": "^10.4.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "prepublishOnly": "echo \"Error: no publish\" && exit 1",
    "publish": "npx @raycast/api@latest publish"
  }
}
