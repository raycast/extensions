{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "json-workbench",
  "title": "JSON Workbench",
  "description": "Edit, preview, transform, and convert JSON locally in a dedicated macOS window.",
  "icon": "extension-icon.png",
  "author": "tang_xiangrun",
  "license": "MIT",
  "categories": [
    "Developer Tools"
  ],
  "platforms": [
    "macOS"
  ],
  "commands": [
    {
      "name": "open-json-editor",
      "title": "Open JSON Editor",
      "subtitle": "JSON Workbench",
      "description": "Open a local macOS split editor with JSON formatting and JavaScript transforms.",
      "mode": "no-view",
      "arguments": [
        {
          "name": "input",
          "placeholder": "JSON or file path (optional)",
          "type": "text",
          "required": false
        }
      ]
    },
    {
      "name": "preview-json",
      "title": "Preview JSON",
      "subtitle": "JSON Workbench",
      "description": "Preview selected text, clipboard text, or a local JSON, YAML or XML file.",
      "mode": "view",
      "arguments": [
        {
          "name": "input",
          "placeholder": "JSON or file path (optional)",
          "type": "text",
          "required": false
        }
      ]
    }
  ],
  "preferences": [
    {
      "name": "indent",
      "title": "Indentation",
      "description": "Spaces used when formatting JSON",
      "type": "dropdown",
      "required": false,
      "default": "2",
      "data": [
        {
          "title": "2 spaces",
          "value": "2"
        },
        {
          "title": "4 spaces",
          "value": "4"
        }
      ]
    },
    {
      "name": "preferSelection",
      "title": "Input",
      "label": "Use selected text before the clipboard",
      "description": "Read selected text when available, then fall back to the clipboard",
      "type": "checkbox",
      "required": false,
      "default": true
    }
  ],
  "scripts": {
    "build": "ray build -e dist -o dist",
    "dev": "ray develop",
    "lint": "ray lint",
    "lint:fix": "ray lint --fix",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "publish": "ray publish"
  },
  "dependencies": {
    "@jitl/quickjs-singlefile-browser-release-sync": "^0.32.0",
    "@raycast/api": "^2.6.3",
    "fast-xml-parser": "^5.11.2",
    "json5": "^2.2.3",
    "lossless-json": "^4.3.1",
    "quickjs-emscripten-core": "^0.32.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5"
  },
  "keywords": [
    "json",
    "json5",
    "yaml",
    "xml",
    "formatter",
    "editor",
    "transform"
  ]
}
