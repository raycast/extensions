{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "tibia-npc-prices",
  "title": "Tibia NPC Prices",
  "description": "Find the highest NPC sell price for Tibia items",
  "icon": "command-icon.png",
  "author": "kjbakke",
  "categories": [
    "Fun",
    "Data"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "search-item-prices",
      "title": "Search Item Prices",
      "description": "Search for Tibia items and see which NPC pays the most",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.11",
    "@raycast/utils": "^2.2.3"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.1.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "eslint": "^9.39.4",
    "prettier": "^3.0.3",
    "typescript": "^6.0.2"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}
