{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "zush-ai-renamer",
  "title": "Zush AI Renamer",
  "description": "Batch rename files by their content with AI. Images, screenshots, PDFs, Office documents, text and code get clear, searchable names from Google Gemini.",
  "icon": "extension-icon.png",
  "author": "lirik",
  "categories": [
    "Productivity",
    "System"
  ],
  "keywords": [
    "rename",
    "renaming",
    "filename",
    "finder",
    "ai",
    "zush",
    "bulk rename",
    "auto rename",
    "photos"
  ],
  "license": "MIT",
  "platforms": [
    "macOS"
  ],
  "commands": [
    {
      "name": "rename-files",
      "title": "Rename Files with AI",
      "subtitle": "Zush",
      "description": "Batch rename the files you selected in Finder by their content.",
      "mode": "view",
      "keywords": [
        "smart rename",
        "batch rename"
      ]
    }
  ],
  "preferences": [
    {
      "name": "apiKey",
      "title": "Gemini API Key",
      "description": "Get one at aistudio.google.com/apikey. Sent only to Google.",
      "placeholder": "Paste your key from aistudio.google.com/apikey",
      "type": "password",
      "required": true
    },
    {
      "name": "model",
      "title": "Model",
      "description": "Gemini model used for title generation. Leave empty to use gemini-3.1-flash-lite.",
      "type": "textfield",
      "required": false,
      "default": "gemini-3.1-flash-lite",
      "placeholder": "gemini-3.1-flash-lite"
    },
    {
      "name": "filenameStyle",
      "title": "Filename Style",
      "description": "How the generated title is written to disk.",
      "type": "dropdown",
      "required": false,
      "default": "title",
      "data": [
        {
          "title": "Title Case With Spaces",
          "value": "title"
        },
        {
          "title": "kebab-case",
          "value": "kebab"
        },
        {
          "title": "snake_case",
          "value": "snake"
        }
      ]
    },
