{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "venue-rank",
  "title": "Venue Rank",
  "description": "Search computer science conferences and journals across versioned ranking lists, offline.",
  "icon": "icon.png",
  "author": "ViGeng",
  "license": "MIT",
  "categories": [
    "Developer Tools",
    "Data"
  ],
  "platforms": [
    "macOS"
  ],
  "commands": [
    {
      "name": "search-venues",
      "title": "Search Venues",
      "description": "Look up venue grades and their sources.",
      "mode": "view"
    }
  ],
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  },
  "dependencies": {
    "@raycast/api": "2.11.1",
    "react": "19.3.1",
    "fuse.js": "7.5.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "2.2.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  },
  "keywords": [
    "conference",
    "journal",
    "CCF",
    "CORE",
    "ICORE",
    "ranking",
    "research"
  ]
}
