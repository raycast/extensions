{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "value-vault",
  "title": "Value Vault",
  "description": "Store values by label, search them, and copy them to your clipboard instantly.",
  "icon": "icon.png",
  "author": "ringtail",
  "platforms": ["macOS"],
  "categories": [
    "Productivity",
    "Data"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "browse-values",
      "title": "Browse Values",
      "description": "Search your saved values and copy them to the clipboard",
      "mode": "view",
      "arguments": [
        {
          "name": "query",
          "type": "text",
          "placeholder": "Search values…",
          "required": false
        }
      ]
    },
    {
      "name": "add-value",
      "title": "Add Value",
      "description": "Save a new value to your vault",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.19",
    "@raycast/utils": "^2.2.5",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.1.1",
    "@types/node": "22.13.0",
    "@types/react": "19.0.0",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.22.0",
    "prettier": "^3.5.0",
    "typescript": "^5.8.0"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}
