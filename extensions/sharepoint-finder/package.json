{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "sharepoint-finder",
  "title": "SharePoint Finder",
  "description": "Open the current SharePoint file or folder in its synced Finder location",
  "icon": "icon.png",
  "author": "andrew_slabbert",
  "platforms": [
    "macOS"
  ],
  "categories": [
    "Productivity",
    "System"
  ],
  "license": "MIT",
  "type": "module",
  "commands": [
    {
      "name": "open-sharepoint-link",
      "title": "Open SharePoint in Finder",
      "description": "Open the current SharePoint file or folder in its synced Finder location",
      "mode": "no-view",
      "keywords": [
        "onedrive",
        "sharepoint",
        "folder",
        "finder"
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.1"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.1.1",
    "@types/node": "^22.13.10",
    "eslint": "^9.39.2",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "lint": "ray lint",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "publish": "npx @raycast/api@latest publish"
  }
}
