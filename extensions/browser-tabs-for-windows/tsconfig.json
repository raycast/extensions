{
    "$schema": "https://json.schemastore.org/tsconfig",
    "compilerOptions": {
        "lib": [
            "ES2022"
        ],
        "module": "commonjs",
        "target": "ES2022",
        "strict": true,
        "declaration": true,
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "moduleResolution": "node",
        "jsx": "react-jsx",
        "outDir": "dist"
    },
    "include": [
        "src/**/*"
    ]
}