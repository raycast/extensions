{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "flowferry",
  "title": "FlowFerry",
  "description": "Save articles to your FlowFerry library from Raycast.",
  "icon": "icon.png",
  "author": "rene_wang",
  "categories": [
    "Productivity",
    "Web"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "save-active-tab",
      "title": "Save Active Tab",
      "subtitle": "FlowFerry",
      "description": "Save the article in the active browser tab to your FlowFerry library.",
      "mode": "no-view"
    },
    {
      "name": "save-url",
      "title": "Save URL",
      "subtitle": "FlowFerry",
      "description": "Save an article URL to your FlowFerry library.",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "apiKey",
      "title": "API Key",
      "description": "Generate this at https://flowferry.app/account.",
      "type": "password",
      "required": true,
      "placeholder": "ff_..."
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.84.0",
    "defuddle": "^0.17.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.11",
    "@types/node": "^20.8.10",
    "@types/react": "^18.3.3",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "typescript": "^5.4.5"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  },
  "overrides": {
    "@types/react": "$@types/react"
  }
}
