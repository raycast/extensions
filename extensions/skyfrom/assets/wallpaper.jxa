ObjC.import("AppKit");
ObjC.import("ImageIO");
ObjC.import("CoreGraphics");

function run(args) {
  const screens = $.NSScreen.screens;
  const count = Number(screens.count);
  if (!count) throw new Error("NO_SCREEN");
  const screen = screens.objectAtIndex(0);
  const workspace = $.NSWorkspace.sharedWorkspace;
  const displayId = Number(screen.deviceDescription.objectForKey("NSScreenNumber").js);

  if (args[0] === "inspect") {
    return JSON.stringify({
      width: Math.round(Number(screen.frame.size.width) * Number(screen.backingScaleFactor)),
      height: Math.round(Number(screen.frame.size.height) * Number(screen.backingScaleFactor)),
      displayId,
    });
  }
  if (args[0] !== "apply" || args.length !== 3) throw new Error("INVALID_ARGUMENTS");
  if (displayId !== Number(args[2])) throw new Error("DISPLAY_CHANGED");

  const image = $.NSURL.fileURLWithPath(args[1]);
  const source = $.CGImageSourceCreateWithURL(image, $());
  if (!source || Number($.CGImageSourceGetStatus(source)) !== 0) throw new Error("INVALID_IMAGE");
  const decoded = $.CGImageSourceCreateImageAtIndex(source, 0, $());
  if (!decoded) throw new Error("INVALID_IMAGE");
  const pixels = $.CGDataProviderCopyData($.CGImageGetDataProvider(decoded));
  if (!pixels || !Number($.CFDataGetLength(pixels)) || Number($.CGImageSourceGetStatusAtIndex(source, 0)) !== 0) {
    throw new Error("INVALID_IMAGE");
  }

  const error = Ref();
  const applied = workspace.setDesktopImageURLForScreenOptionsError(
    image,
    screen,
    $({
      [ObjC.unwrap($.NSWorkspaceDesktopImageScalingKey)]: $.NSImageScaleProportionallyUpOrDown,
      [ObjC.unwrap($.NSWorkspaceDesktopImageAllowClippingKey)]: true,
    }),
    error,
  );
  if (!applied) {
    const code = Number(error[0].code);
    if (code === -1743 || code === 13 || code === 257) throw new Error("PERMISSION_DENIED");
    throw new Error("APPLY_FAILED");
  }
  return JSON.stringify({ screens: count });
}
