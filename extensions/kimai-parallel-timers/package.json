{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "kimai-parallel-timers",
  "title": "Kimai",
  "description": "Track time in Kimai with parallel timers, recent entries and menu bar controls.",
  "icon": "extension-icon.png",
  "author": "mateusz",
  "license": "MIT",
  "platforms": [
    "macOS"
  ],
  "categories": [
    "Productivity"
  ],
  "commands": [
    {
      "name": "index",
      "title": "Start / Stop Timers",
      "description": "Start / Stop Timers in Kimai",
      "mode": "view",
      "icon": "extension-icon.png"
    },
    {
      "name": "create-timer",
      "title": "Quickstart New Timer",
      "description": "Quickstart New Timer in Kimai",
      "mode": "view",
      "icon": "extension-icon.png"
    },
    {
      "name": "stop-timer",
      "title": "Quickstop Timer",
      "description": "Quickstop Timer in Kimai",
      "mode": "view",
      "icon": "extension-icon.png"
    },
    {
      "name": "stop-all",
      "title": "Stop All Timers",
      "description": "Stop All Timers in Kimai",
      "mode": "no-view",
      "icon": "extension-icon.png"
    },
    {
      "name": "edit-entry",
      "title": "Update Time Entry",
      "description": "Update Time Entry in Kimai",
      "mode": "view",
      "icon": "extension-icon.png"
    },
    {
      "name": "menu-bar",
      "title": "Kimai Menu Bar",
      "description": "Kimai Menu Bar in Kimai",
      "mode": "menu-bar",
      "interval": "30s",
      "icon": "extension-icon.png"
    },
    {
      "name": "customers",
      "title": "Manage Customers",
      "description": "Manage Customers in Kimai",
      "mode": "view",
      "icon": "extension-icon.png"
    },
    {
      "name": "projects",
      "title": "Manage Projects",
      "description": "Manage Projects in Kimai",
      "mode": "view",
      "icon": "extension-icon.png"
    },
    {
      "name": "activities",
      "title": "Manage Activities",
      "description": "Manage Activities in Kimai",
      "mode": "view",
      "icon": "extension-icon.png"
    },
    {
      "name": "tags",
      "title": "Manage Tags",
      "description": "Manage Tags in Kimai",
      "mode": "view",
      "icon": "extension-icon.png"
    },
    {
      "name": "connection",
      "title": "Connection and Parallel Timer Settings",
      "description": "Connection and Parallel Timer Settings in Kimai",
      "mode": "view",
      "icon": "extension-icon.png"
    }
  ],
  "preferences": [
    {
      "name": "baseUrl",
      "title": "Kimai URL",
      "description": "Base URL, including a subdirectory if applicable. HTTPS recommended.",
      "type": "textfield",
      "required": true,
      "placeholder": "https://kimai.example.com"
    },
    {
      "name": "apiToken",
      "title": "Kimai API Token",
      "description": "Create an API token in your Kimai profile.",
      "type": "password",
      "required": true
    },
    {
      "name": "recentDateFormat",
      "title": "Recent Entry Date Format",
      "description": "Show dates as DD/MM/YYYY or use Today and Yesterday for recent entries. Uses your computer’s local timezone.",
      "type": "dropdown",
      "required": false,
      "default": "date",
      "data": [
        {
          "title": "Date (19/10/2026)",
          "value": "date"
        },
        {
          "title": "Today / Yesterday / Date",
          "value": "relative"
        }
      ]
    },
    {
      "name": "showTimerSummary",
      "title": "Show Summary in Start / Stop Timers",
      "description": "Show Today, Yesterday, Week and Month totals above the timer list.",
      "type": "checkbox",
      "label": "Show time summary",
      "required": false,
      "default": true
    }
  ],
  "scripts": {
    "dev": "ray develop",
    "build": "ray build -e dist -o dist",
    "lint": "ray lint",
    "format": "prettier --write .",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "publish": "npx @raycast/api@latest publish",
    "lint:code": "eslint ."
  },
  "dependencies": {
    "@raycast/api": "^2.8.2",
    "@raycast/utils": "^2.3.3"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.4",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "tsx": "^4.20.0",
    "typescript": "^5.8.2"
  }
}
