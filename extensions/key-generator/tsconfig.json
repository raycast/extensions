{
    "compilerOptions": {
        "target": "es2021",
        "lib": [
            "es2021",
            "dom"
        ],
        "jsx": "react-jsx",
        "module": "commonjs",
        "moduleResolution": "node",
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "outDir": "dist"
    },
    "include": [
        "src/**/*"
    ]
}
