{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "cool-text",
  "title": "CoolText",
  "description": "Turn text, emoji, and images into alphabet emoji, ASCII art, or Unicode dot art.",
  "icon": "cooltext-pencil-transparent.png",
  "author": "pho_huynh",
  "platforms": [
    "macOS",
    "Windows"
  ],
  "categories": [
    "Fun",
    "Communication"
  ],
  "license": "MIT",
  "version": "1.0.0",
  "private": true,
  "commands": [
    {
      "name": "cool-text",
      "title": "Quick Copy CoolText",
      "description": "Choose a style, transform your text, and automatically copy the result.",
      "mode": "no-view",
      "keywords": [
        "emoji",
        "ascii",
        "alphabet",
        "clipboard"
      ],
      "arguments": [
        {
          "name": "text",
          "type": "text",
          "placeholder": "Type your cool text",
          "required": true
        },
        {
          "name": "variant",
          "type": "dropdown",
          "placeholder": "Alphabet Emoji",
          "required": false,
          "data": [
            {
              "title": "Alphabet Emoji",
              "value": "alphabet"
            },
            {
              "title": "ASCII Art",
              "value": "ascii"
            },
            {
              "title": "Unicode Dots",
              "value": "dots"
            }
          ]
        },
        {
          "name": "font",
          "type": "dropdown",
          "placeholder": "Small",
          "required": false,
          "data": [
            {
              "title": "Small",
              "value": "Small"
            },
            {
              "title": "Standard",
              "value": "Standard"
            },
            {
              "title": "Slant",
              "value": "Slant"
            },
            {
              "title": "Big",
              "value": "Big"
            }
          ]
        }
      ]
    },
    {
      "name": "preview",
      "title": "CoolText",
      "description": "Preview alphabet emoji, ASCII art, or Unicode dots as you type, then press Enter to copy.",
      "mode": "view",
      "keywords": [
        "emoji",
        "ascii",
        "preview",
        "alphabet"
      ]
    },
    {
      "name": "image",
      "title": "Image to Text Art",
      "description": "Turn an image into ASCII or Unicode dot art with size and contrast controls.",
      "mode": "view",
      "keywords": [
        "image",
        "photo",
        "ascii",
        "picture",
        "unicode",
        "dots"
      ]
    }
  ],
  "scripts": {
    "dev": "ray develop",
    "build": "ray build -e dist",
    "lint": "ray lint",
    "publish": "ray publish",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@raycast/api": "^2.2.1",
    "figlet": "^1.11.4",
    "jimp": "^1.6.1",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.22.2"
  }
}
