{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "simpletexocr",
  "title": "SimpleTexOCR",
  "description": "A LaTeX OCR by Simpletex",
  "icon": "command-icon.png",
  "author": "Arthals",
  "contributors": [
    "FrankMao",
    "zzh"
  ],
  "categories": [
    "Developer Tools"
  ],
  "license": "MIT",
  "preferences": [
    {
      "required": true,
      "name": "token",
      "title": "API Key",
      "description": "API Key from SimpleTex",
      "type": "password"
    },
    {
      "name": "model",
      "type": "dropdown",
      "required": true,
      "title": "Model Selection",
      "description": "Choose SimpleTex OCR Model(latex_ocr, latex_ocr_turbo)",
      "default": "latex_ocr",
      "data": [
        {
          "title": "Turbo (cheaper and faster)",
          "value": "latex_ocr_turbo"
        },
        {
          "title": "LaTeX OCR (more accurate)",
          "value": "latex_ocr"
        }
      ]
    },
    {
      "required": true,
      "name": "server_suffix",
      "title": "Server Location",
      "description": "Server Location",
      "type": "dropdown",
      "data": [
        {
          "title": "China",
          "value": "cn"
        },
        {
          "title": "Global",
          "value": "net"
        }
      ],
      "default": "China"
    }
  ],
  "commands": [
    {
      "name": "index",
      "title": "LaTeX OCR",
      "description": "LaTeX OCR by SimpleTex",
      "mode": "no-view"
    },
    {
      "name": "config",
      "title": "LaTeX OCR Config",
      "description": "Config for SimpleTex OCR",
      "mode": "view",
      "icon": "command-icon.png"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.22",
    "@raycast/utils": "^2.2.7",
    "axios": "^1.18.1",
    "copy-paste": "^2.2.0",
    "form-data": "^4.0.6"
  },
  "devDependencies": {
    "@raycast/eslint-config": "2.2.0",
    "@types/copy-paste": "^2.1.0",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "eslint": "^10.7.0",
    "prettier": "^3.9.5",
    "typescript": "^6.0.0"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  },
  "platforms": [
    "macOS"
  ]
}
