{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "raycast-skill-cmd",
  "version": "0.1.0",
  "private": true,
  "title": "Paste Pi Skill",
  "description": "Search and paste local skills in Pi's skill format",
  "icon": "icon.png",
  "author": "guillem",
  "categories": ["Developer Tools"],
  "license": "MIT",
  "platforms": ["macOS"],
  "commands": [
    {
      "name": "paste-agent-skill",
      "title": "Paste Pi Skill",
      "description": "Search a local skill and paste it in Pi's skill format",
      "mode": "view"
    }
  ],
  "scripts": {
    "dev": "ray develop",
    "build": "ray build",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  },
  "dependencies": {
    "@raycast/api": "^1.104.24"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "typescript": "^5.9.3"
  }
}
