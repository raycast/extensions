{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "localhost",
  "title": "Localhost",
  "description": "view locally running servers and open them.",
  "icon": "extension-icon.png",
  "license": "MIT",
  "screenshots": ["metadata/featurephoto.png", "metadata/featurephoto2.png"],
  "version": "1.0.0",
  "commands": [
    {
      "name": "servers",
      "title": "Servers",
      "description": "view locally running servers",
      "mode": "view",
      "subtitle": "localhost"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.103.0",
    "@raycast/utils": "^2.2.1",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.4",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "dev": "ray develop",
    "lint": "ray lint",
    "fix-lint": "ray lint --fix",
    "build": "ray build",
    "publish": "npx @raycast/api@latest publish",
    "prepublishOnly": "echo \"\\n\\nIt seems like you are trying to publish the Raycast extension to npm.\\n\\nIf you did intend to publish it to npm, remove the \\`prepublishOnly\\` script and rerun \\`npm publish\\` again.\\nIf you wanted to publish it to the Raycast Store instead, use \\`npm run publish\\` instead.\\n\\n\" && exit 1"
  },
  "author": "ehan_chowdhury",
  "platforms": [
    "Windows"
  ],
  "categories": [
    "Developer Tools"
  ]
}
