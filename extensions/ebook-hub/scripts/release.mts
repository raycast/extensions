/**
 * Cut a release: add a Raycast-formatted CHANGELOG entry generated by git-cliff, commit it, and tag
 * the version. See ADR-0009.
 *
 *   npm run release -- [--dry-run] [--title "Readable Title"]
 */
import { execFileSync } from "node:child_process";
import { readFileSync, writeFileSync } from "node:fs";
import { resolve } from "node:path";
import { fileURLToPath } from "node:url";

export const CHANGELOG_FILE = "CHANGELOG.md";
export const CHANGELOG_TITLE = "# Ebook Hub Changelog";
export const INITIAL_HEADING = "## [Initial Version]";
export const INITIAL_TAG = "v1.0.0";
export const USAGE = 'Usage: npm run release -- [--dry-run] [--title "Readable Title"]';

const ENTRY_HEADING = /^## \[[^\]]+\] - \{PR_MERGE_DATE\}$/;

export class ReleaseError extends Error {
  constructor(message: string) {
    super(message);
    this.name = "ReleaseError";
  }
}

export interface ReleaseOptions {
  dryRun: boolean;
  title: string | null;
}

/** Runs a command and returns its trimmed stdout. */
export type Run = (command: string, args: readonly string[]) => string;

export interface ReleaseDeps {
  run: Run;
  readChangelog: () => string;
  writeChangelog: (content: string) => void;
  log: (message: string) => void;
  error: (message: string) => void;
}

export function parseArgs(argv: readonly string[]): ReleaseOptions {
  const options: ReleaseOptions = { dryRun: false, title: null };
  for (let index = 0; index < argv.length; index += 1) {
    const arg = argv[index];
    if (arg === "--dry-run") {
      options.dryRun = true;
    } else if (arg === "--title") {
      const title = argv[index + 1]?.trim();
      if (!title || title.startsWith("--")) {
        throw new ReleaseError(`--title needs a value.\n${USAGE}`);
      }
      if (/[[\]]/.test(title)) {
        throw new ReleaseError("--title cannot contain square brackets.");
      }
      options.title = title;
      index += 1;
    } else {
      throw new ReleaseError(`Unknown option: ${arg}\n${USAGE}`);
    }
  }
  return options;
}

export function hasChanges(entry: string): boolean {
  return entry.split("\n").some((line) => line.startsWith("- "));
}

/** Replace the version in the entry heading with a readable title when one is given. */
export function retitle(entry: string, title: string | null): string {
  const [heading, ...rest] = entry.trim().split("\n");
  if (!ENTRY_HEADING.test(heading)) {
    throw new ReleaseError(`Unexpected git-cliff heading: ${heading}`);
  }
  return title === null ? entry.trim() : [`## [${title}] - {PR_MERGE_DATE}`, ...rest].join("\n");
}

/** Insert the newest entry directly below the changelog title, as the Raycast Store expects. */
export function insertEntry(changelog: string, entry: string): string {
  const normalized = changelog.replace(/\r\n/g, "\n");
  if (!normalized.startsWith(`${CHANGELOG_TITLE}\n`) && normalized.trim() !== CHANGELOG_TITLE) {
    throw new ReleaseError(`${CHANGELOG_FILE} must start with "${CHANGELOG_TITLE}".`);
  }
  const previous = normalized.slice(CHANGELOG_TITLE.length).trim();
  return previous === ""
    ? `${CHANGELOG_TITLE}\n\n${entry.trim()}\n`
    : `${CHANGELOG_TITLE}\n\n${entry.trim()}\n\n${previous}\n`;
}

export function release(options: ReleaseOptions, deps: ReleaseDeps): void {
  const { run, log } = deps;
  if (!options.dryRun && run("git", ["status", "--porcelain"]) !== "") {
    throw new ReleaseError("Commit or stash your changes before releasing.");
  }

  const changelog = deps.readChangelog();
  const latestTag = run("git", ["tag", "--list", "v*", "--sort=-v:refname"]).split("\n")[0];

  if (latestTag === "") {
    // First Store submission: the CHANGELOG already carries the "[Initial Version]" entry.
    if (!changelog.includes(INITIAL_HEADING)) {
      throw new ReleaseError(`No release tags yet and ${CHANGELOG_FILE} has no "${INITIAL_HEADING}" entry.`);
    }
    if (options.title !== null) {
      throw new ReleaseError("--title is not used for the initial version.");
    }
    if (options.dryRun) {
      log(`Dry run: would tag ${INITIAL_TAG} for the initial version.`);
      return;
    }
    run("git", ["tag", "-a", INITIAL_TAG, "-m", `Release ${INITIAL_TAG}`]);
    log(`Tagged ${INITIAL_TAG} for the initial version. Run npm run publish to open the Raycast Store pull request.`);
    return;
  }

  const version = run("git-cliff", ["--bumped-version"]);
  const entry = run("git-cliff", ["--unreleased", "--tag", version, "--strip", "all"]);
  if (version === latestTag || !hasChanges(entry)) {
    throw new ReleaseError(`No user-facing changes (feat, fix, perf) since ${latestTag}.`);
  }
  const titled = retitle(entry, options.title);

  if (options.dryRun) {
    log(`Dry run: ${version}\n\n${titled}`);
    return;
  }
  deps.writeChangelog(insertEntry(changelog, titled));
  run("git", ["add", CHANGELOG_FILE]);
  run("git", ["commit", "-m", `chore(release): ${version}`]);
  run("git", ["tag", "-a", version, "-m", `Release ${version}`]);
  log(`Released ${version}. Run npm run publish to open the Raycast Store pull request.`);
}

export function main(argv: readonly string[], deps: ReleaseDeps): number {
  try {
    release(parseArgs(argv), deps);
    return 0;
  } catch (error) {
    deps.error(error instanceof Error ? error.message : String(error));
    return 1;
  }
}

function runCommand(command: string, args: readonly string[]): string {
  // git-cliff prints warnings on stderr; let them reach the terminal.
  return execFileSync(command, args, { encoding: "utf8", stdio: ["ignore", "pipe", "inherit"] }).trim();
}

const invokedDirectly = process.argv[1] !== undefined && resolve(process.argv[1]) === fileURLToPath(import.meta.url);

if (invokedDirectly) {
  const changelogPath = resolve(process.cwd(), CHANGELOG_FILE);
  process.exitCode = main(process.argv.slice(2), {
    run: runCommand,
    readChangelog: () => readFileSync(changelogPath, "utf8"),
    writeChangelog: (content) => writeFileSync(changelogPath, content, "utf8"),
    log: console.log,
    error: console.error,
  });
}
