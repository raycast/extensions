{
	"$schema": "https://www.raycast.com/schemas/extension.json",
	"name": "brave-fuzzy",
	"title": "Brave Fuzzy",
	"description": "Unified search for Brave Browser tabs, history, and web with smart tab focusing",
	"icon": "extension-icon.png",
	"author": "adam",
	"categories": [
		"Web",
		"Productivity"
	],
	"license": "MIT",
	"commands": [
		{
			"name": "brave-search",
			"title": "Brave Fuzzy",
			"description": "Search tabs, history and web with smart tab focusing",
			"mode": "view"
		}
	],
	"preferences": [
		{
			"name": "searchEngine",
			"type": "dropdown",
			"required": false,
			"title": "Search Engine",
			"description": "Choose your preferred search engine",
			"default": "google",
			"data": [
				{
					"title": "Google",
					"value": "google"
				},
				{
					"title": "DuckDuckGo",
					"value": "duckduckgo"
				},
				{
					"title": "Bing",
					"value": "bing"
				}
			]
		}
	],
	"dependencies": {
		"@raycast/api": "^1.60.0"
	},
	"devDependencies": {
		"@raycast/eslint-config": "^2.1.1",
		"@types/jest": "^29.5.14",
		"@types/node": "18.8.3",
		"@types/react": "18.0.9",
		"@typescript-eslint/eslint-plugin": "^5.0.0",
		"@typescript-eslint/parser": "^5.0.0",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^8.3.0",
		"jest": "^29.5.0",
		"prettier": "^2.5.1",
		"ts-jest": "^29.1.0",
		"typescript": "^4.4.3"
	},
	"scripts": {
		"build": "ray build -e dist",
		"dev": "ray develop",
		"fix-lint": "ray lint --fix",
		"lint": "ray lint",
		"publish": "ray publish",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage"
	}
}
