{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "lid-light",
  "title": "Lid Light",
  "description": "Control the illuminated Apple logo on MacBook Pro directly from Raycast.",
  "icon": "extension-icon.png",
  "author": "eshanagarwal",
  "license": "MIT",
  "platforms": [
    "macOS"
  ],
  "categories": [
    "System"
  ],
  "commands": [
    {
      "name": "control-lid-light",
      "title": "Control Lid Light",
      "description": "Adjust the lid logo brightness, effects, and power settings.",
      "mode": "view",
      "keywords": [
        "logo",
        "logolight",
        "Apple",
        "brightness",
        "backlight"
      ]
    },
    {
      "name": "toggle-lid-light",
      "title": "Toggle Lid Light",
      "description": "Turn the Apple lid logo on or off.",
      "mode": "no-view",
      "keywords": [
        "logo",
        "logolight",
        "Apple",
        "backlight"
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "2.13.1"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "scripts": {
    "build:helper": "bash scripts/build-helper.sh",
    "postinstall": "bash scripts/build-helper.sh",
    "build": "ray build -e dist -o dist",
    "build:local": "ray build -e dev",
    "dev": "ray develop",
    "lint": "ray lint",
    "typecheck": "tsc --noEmit",
    "publish": "ray publish"
  }
}
