{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "cronitor",
  "title": "Cronitor",
  "description": "View Monitors in Cronitor",
  "icon": "cronitor.png",
  "author": "xmok",
  "license": "MIT",
  "preferences": [
    {
      "name": "api_key",
      "title": "API Key",
      "placeholder": "Cronitor API Key",
      "type": "password",
      "required": true,
      "description": "Cronitor API Key"
    }
  ],
  "commands": [
    {
      "name": "search-monitors",
      "title": "Search Monitors",
      "description": "Search Monitors in Cronitor",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^2.5.0",
    "@raycast/utils": "^1.17.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.4",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "prepublishOnly": "echo \"\\n\\nIt seems like you are trying to publish the Raycast extension to npm.\\n\\nIf you did intend to publish it to npm, remove the \\`prepublishOnly\\` script and rerun \\`npm publish\\` again.\\nIf you wanted to publish it to the Raycast Store instead, use \\`npm run publish\\` instead.\\n\\n\" && exit 1",
    "publish": "npx @raycast/api@latest publish"
  },
  "platforms": [
    "macOS"
  ]
}
