{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "zoo",
  "title": "Zoo - AI Prompt Library with Your Own Key",
  "description": "Run GitHub Gist prompts on selected text with your own OpenAI, Gemini, Claude, or DeepSeek API key. No Raycast Pro is required.",
  "icon": "zoo.png",
  "author": "ViGeng",
  "categories": [
    "Developer Tools",
    "Productivity"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "search-gists",
      "title": "Search Gist Prompt",
      "description": "Search and display your prompt from GitHub gists",
      "mode": "view",
      "preferences": [
        {
          "name": "perPage",
          "type": "dropdown",
          "description": "Number of gist loaded per page.",
          "required": false,
          "title": "Per Page",
          "default": "30",
          "data": [
            {
              "title": "30",
              "value": "30"
            },
            {
              "title": "50",
              "value": "50"
            },
            {
              "title": "80",
              "value": "80"
            },
            {
              "title": "100",
              "value": "100"
            }
          ]
        },
        {
          "name": "remember-tag",
          "type": "checkbox",
          "required": false,
          "title": "Preferences",
          "label": "Remember Filter Tag",
          "description": "Remember gist filter tag.",
          "default": false
        },
        {
          "name": "detail",
          "type": "checkbox",
          "required": false,
          "label": "Show Gist Content",
          "description": "Show gist content details.",
          "default": true
        },
        {
          "name": "primaryAction",
          "type": "dropdown",
          "description": "Primary action for gist item.",
          "required": false,
          "title": "Primary Action",
          "default": "paste",
          "data": [
            {
              "title": "Paste to Active App",
              "value": "paste"
            },
            {
              "title": "Copy to Clipboard",
              "value": "copy"
            }
          ]
        }
      ]
    },
    {
      "name": "ask-gist",
      "title": "Ask by Prompt on Selected Text",
      "description": "Apply a reusable Gist prompt to selected text using your own AI API key.",
      "mode": "view",
      "preferences": [
        {
          "name": "perPage",
          "type": "dropdown",
          "description": "Number of gist loaded per page.",
          "required": false,
          "title": "Per Page",
          "default": "30",
          "data": [
            {
              "title": "30",
              "value": "30"
            },
            {
              "title": "50",
              "value": "50"
            },
            {
              "title": "80",
              "value": "80"
            },
            {
              "title": "100",
              "value": "100"
            }
          ]
        },
        {
          "name": "remember-tag",
          "type": "checkbox",
          "required": false,
          "title": "Preferences",
          "label": "Remember Filter Tag",
          "description": "Remember gist filter tag.",
          "default": false
        },
        {
          "name": "detail",
          "type": "checkbox",
          "required": false,
          "label": "Show Gist Content",
          "description": "Show gist content details.",
          "default": true
        },
        {
          "name": "primaryAction",
          "type": "dropdown",
          "description": "Primary action for gist item.",
          "required": false,
          "title": "Primary Action",
          "default": "paste",
          "data": [
            {
              "title": "Paste to Active App",
              "value": "paste"
            },
            {
              "title": "Copy to Clipboard",
              "value": "copy"
            }
          ]
        }
      ],
      "keywords": [
        "AI",
        "prompt",
        "BYOK",
        "translate",
        "summarize",
        "rewrite"
      ]
    },
    {
      "name": "create-gist",
      "title": "Create Gist Prompt",
      "description": "Create GitHub gist from selection or clipboard.",
      "mode": "view"
    },
    {
      "name": "check-ai-connection",
      "title": "Check AI Connection",
      "description": "Check API access and model availability without sending a prompt or input text.",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@octokit/core": "^6.1.0",
    "@raycast/api": "^2.11.1",
    "@raycast/utils": "^2.3.3",
    "js-base64": "^3.7.2",
    "openai": "^7.55.0"
  },
  "preferences": [
    {
      "name": "provider",
      "type": "dropdown",
      "title": "AI Provider",
      "description": "Choose a service. Automatic detects it from the model or existing endpoint. Named providers use their official endpoints.",
      "required": true,
      "default": "auto",
      "data": [
        {
          "title": "Automatic (from Model or Endpoint)",
          "value": "auto"
        },
        {
          "title": "OpenAI",
          "value": "openai"
        },
        {
          "title": "Google Gemini",
          "value": "gemini"
        },
        {
          "title": "Anthropic Claude",
          "value": "anthropic"
        },
        {
          "title": "DeepSeek",
          "value": "deepseek"
        },
        {
          "title": "Custom OpenAI-Compatible API",
          "value": "custom"
        }
      ]
    },
    {
      "name": "apikey",
      "description": "Enter the API key issued by the selected AI service.",
      "type": "password",
      "required": true,
      "title": "LLM API Key"
    },
    {
      "name": "baseurl",
      "description": "Set the API base URL for Automatic or Custom mode. Leave it empty to use the official endpoint.",
      "type": "textfield",
      "required": false,
      "title": "LLM API Endpoint"
    },
    {
      "name": "priceinput",
      "description": "Optional USD price per million input tokens. Set both prices to show an estimate.",
      "type": "textfield",
      "required": false,
      "title": "Custom Model Input Price"
    },
    {
      "name": "priceoutput",
      "description": "Optional USD price per million output tokens. Set both prices to show an estimate.",
      "type": "textfield",
      "required": false,
      "title": "Custom Model Output Price"
    },
    {
      "name": "model",
      "description": "Choose a model from the selected provider, or use its default. A custom model ID overrides this choice.",
      "type": "dropdown",
      "data": [
        {
          "title": "Provider Default",
          "value": "default"
        },
        {
          "title": "OpenAI GPT-6 Luna",
          "value": "gpt-6-luna"
        },
        {
          "title": "OpenAI GPT-6.1 Sol",
          "value": "gpt-6.1-sol"
        },
        {
          "title": "OpenAI GPT-6 Astra",
          "value": "gpt-6-astra"
        },
        {
          "title": "Gemini 3.8 Flash",
          "value": "gemini-3.8-flash"
        },
        {
          "title": "Gemini 3.5 Flash-Lite",
          "value": "gemini-3.5-flash-lite"
        },
        {
          "title": "Claude Sonnet 5.5",
          "value": "claude-sonnet-5-5"
        },
        {
          "title": "Claude Haiku 5.5",
          "value": "claude-haiku-5-5"
        },
        {
          "title": "Claude Opus 5.5",
          "value": "claude-opus-5-5"
        },
        {
          "title": "DeepSeek Flash",
          "value": "deepseek-flash"
        },
        {
          "title": "DeepSeek V4 Pro",
          "value": "deepseek-v4-pro"
        }
      ],
      "required": true,
      "default": "default",
      "title": "LLM Model Name"
    },
    {
      "name": "custom_model",
      "description": "Custom model ID for your API endpoint, will override the model selection",
      "type": "textfield",
      "required": false,
      "title": "Custom Model ID"
    }
  ],
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.4.5"
  },
  "scripts": {
    "build": "ray build -e dist",
    "build:local": "ray build -e dev",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "ray publish",
    "test": "tsx --test tests/*.test.ts"
  },
  "overrides": {
    "brace-expansion": "5.0.9"
  },
  "platforms": [
    "macOS"
  ],
  "keywords": [
    "AI",
    "BYOK",
    "prompt library",
    "GitHub Gist",
    "OpenAI",
    "Gemini",
    "Claude",
    "DeepSeek",
    "translation",
    "summarize"
  ]
}
