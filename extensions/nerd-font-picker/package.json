{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "version": "1.0.0",
  "name": "nerd-font-picker",
  "title": "Nerd Font Picker",
  "description": "Browse and copy Nerd Font glyphs from your installed fonts",
  "icon": "extension-icon.png",
  "author": "kud",
  "license": "MIT",
  "categories": [
    "Developer Tools",
    "Design Tools"
  ],
  "commands": [
    {
      "name": "list",
      "title": "Nerd Font Glyphs",
      "description": "Browse and copy Nerd Font glyphs with detailed metadata",
      "mode": "view",
      "preferences": [
        {
          "name": "iconColor",
          "title": "Icon Colour",
          "description": "Hex colour used to render each glyph (e.g. #ffffff)",
          "type": "textfield",
          "required": false,
          "default": "#ffffff"
        }
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.9",
    "@raycast/utils": "^2.2.2",
    "opentype.js": "1.3.4"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.4",
    "@types/node": "^20.12.12",
    "@types/opentype.js": "1.3.9",
    "eslint": "^9.22.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}
