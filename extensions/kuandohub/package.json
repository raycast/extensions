{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "kuandohub",
  "title": "KuandoHUB",
  "description": "Control your Kuando Busylight through the kuandoHUB HTTP API",
  "icon": "extension-icon.png",
  "author": "lyager",
  "categories": [
    "Communication"
  ],
  "keywords": [
    "busylight",
    "kuando",
    "plenom",
    "presence",
    "status"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "set-busy",
      "title": "Set Busy",
      "description": "Turn the Busylight red (busy)",
      "icon": "busy.png",
      "mode": "no-view"
    },
    {
      "name": "set-available",
      "title": "Set Available",
      "description": "Turn the Busylight green (available)",
      "icon": "available.png",
      "mode": "no-view"
    },
    {
      "name": "turn-off",
      "title": "Turn Off Light",
      "description": "Turn the Busylight off",
      "icon": "off.png",
      "mode": "no-view"
    }
  ],
  "preferences": [
    {
      "name": "baseUrl",
      "type": "textfield",
      "required": false,
      "title": "KuandoHUB URL",
      "description": "Base URL of the kuandoHUB HTTP server (Advanced Settings in kuandoHUB)",
      "default": "http://localhost:8989",
      "placeholder": "http://localhost:8989"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.85.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "typescript": "^5.6.0"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "lint": "ray lint"
  }
}
