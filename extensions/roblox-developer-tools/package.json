{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "roblox-developer-tools",
  "title": "Roblox Developer Tools",
  "description": "Launch Roblox, open Studio, and restart servers",
  "icon": "extension-icon.png",
  "author": "zw1ce",
  "license": "MIT",
  "platforms": [
    "macOS"
  ],
  "categories": [
    "Developer Tools"
  ],
  "keywords": [
    "roblox",
    "studio",
    "universe",
    "place",
    "restart"
  ],
  "commands": [
    {
      "name": "launch",
      "title": "Launch Game",
      "subtitle": "Roblox",
      "description": "Play your place",
      "mode": "no-view"
    },
    {
      "name": "studio",
      "title": "Open in Studio",
      "subtitle": "Roblox",
      "description": "Edit your place in Studio",
      "mode": "no-view"
    },
    {
      "name": "restart",
      "title": "Restart Servers",
      "subtitle": "Roblox",
      "description": "Restart servers in your universe",
      "mode": "no-view",
      "preferences": [
        {
          "name": "closeAllVersions",
          "type": "checkbox",
          "title": "Restart",
          "label": "Restart all versions",
          "description": "Turn off to restart outdated servers only",
          "required": false,
          "default": true
        },
        {
          "name": "confirmRestart",
          "type": "checkbox",
          "title": "Confirmation",
          "label": "Ask before restarting",
          "description": "Confirm each restart",
          "required": false,
          "default": true
        }
      ]
    }
  ],
  "preferences": [
    {
      "name": "placeId",
      "type": "textfield",
      "title": "Place ID",
      "description": "Required for Launch and Studio",
      "required": false
    },
    {
      "name": "universeId",
      "type": "textfield",
      "title": "Universe ID",
      "description": "Required for Studio and Restart",
      "required": false
    },
    {
      "name": "apiKey",
      "type": "password",
      "title": "API Key",
      "description": "Required for Restart, Roblox Open Cloud key with universe:write access",
      "required": false
    }
  ],
  "scripts": {
    "dev": "ray develop",
    "build": "ray build -e dist",
    "lint": "ray lint",
    "fix-lint": "ray lint --fix",
    "publish": "npx @raycast/api@latest publish"
  },
  "dependencies": {
    "@raycast/api": "^2.7.3"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.22.2"
  }
}
