{
    "$schema": "https://www.raycast.com/downloads/extension.schema.json",
    "name": "nvidia-ai-chat",
    "title": "NVIDIA AI Chat",
    "description": "Chat with an AI using your NVIDIA API keys.",
    "icon": "extension-icon.png",
    "author": "excentrex",
    "categories": [
        "Developer Tools"
    ],
    "license": "MIT",
    "commands": [
        {
            "name": "index",
            "title": "NVIDIA AI Chat",
            "subtitle": "NVIDIA NIM",
            "description": "Chat with Nvidia AI",
            "mode": "view"
        }
    ],
    "preferences": [
        {
            "name": "apiKey",
            "type": "password",
            "required": true,
            "title": "NVIDIA API Key",
            "description": "Your NVIDIA NIM API key"
        }
    ],
    "dependencies": {
        "@raycast/api": "^1.81.0",
        "@raycast/utils": "^1.16.3",
        "openai": "^4.56.0"
    },
    "devDependencies": {
        "@raycast/eslint-config": "^1.0.8",
        "@types/node": "20.8.10",
        "@types/react": "18.2.0",
        "eslint": "^8.57.0",
        "prettier": "^3.3.3",
        "typescript": "^5.4.5"
    },
    "scripts": {
        "build": "ray build -e dist",
        "dev": "ray develop",
        "fix-lint": "ray lint --fix",
        "lint": "ray lint"
    }
}