{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "andromeld",
  "title": "AndroMeld",
  "description": "Search and open the apps on your Android device.",
  "icon": "extension-icon.png",
  "author": "catchingnow",
  "platforms": [
    "macOS"
  ],
  "categories": [
    "Applications"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "search-android-apps",
      "title": "Search Android Apps",
      "subtitle": "AndroMeld",
      "description": "Search the apps on your connected Android device and open them on the Mac.",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.24",
    "@raycast/utils": "^2.2.1"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.4",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  },
  "keywords": [
    "android",
    "phone",
    "mirror",
    "apps",
    "andromeld"
  ]
}
