{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "holt",
  "title": "Holt",
  "description": "Search your Holt clipboard history and paste from it.",
  "icon": "extension-icon.png",
  "author": "lucasnevespereira",
  "categories": ["Productivity"],
  "license": "MIT",
  "platforms": ["macOS"],
  "commands": [
    {
      "name": "search-clips",
      "title": "Search Clipboard History",
      "description": "Find a clip in Holt and paste it.",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^2.9.0",
    "@raycast/utils": "^2.3.3"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "22.19.17",
    "@types/react": "19.0.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "test": "node --test src/*.test.ts",
    "publish": "npx @raycast/api@latest publish"
  }
}
