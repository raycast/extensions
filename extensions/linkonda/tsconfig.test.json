{
  "$schema": "https://json.schemastore.org/tsconfig",
  "include": ["test/**/*", "src/**/*"],
  "compilerOptions": {
    "lib": ["es2023"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "target": "es2023",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx"
  }
}
