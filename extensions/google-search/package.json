{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "google-search",
  "title": "Google Search",
  "description": "Google search with autosuggestions",
  "icon": "command-icon.png",
  "author": "mblode",
  "contributors": [
    "VBenny42",
    "ridemountainpig",
    "jlokos",
    "YourMCGeek",
    "alexi.build",
    "tofrankie",
    "chrismessina"
  ],
  "license": "MIT",
  "categories": [
    "Web"
  ],
  "commands": [
    {
      "name": "index",
      "title": "Google Search",
      "description": "Google search with autosuggestions",
      "mode": "view",
      "arguments": [
        {
          "name": "query",
          "placeholder": "Query",
          "type": "text",
          "required": false
        }
      ]
    },
    {
      "name": "searchSelectText",
      "title": "Google Search Selected Text",
      "description": "Google search with selected text",
      "mode": "no-view",
      "preferences": [
        {
          "name": "useClipboardFallback",
          "type": "checkbox",
          "required": false,
          "default": false,
          "label": "Use Clipboard Fallback",
          "description": "When no text is selected, fall back to using clipboard content for search."
        }
      ]
    }
  ],
  "preferences": [
    {
      "name": "rememberSearchHistory",
      "type": "checkbox",
      "required": false,
      "default": true,
      "label": "Remember Search History",
      "description": "Enable this checkbox to locally store Google search history."
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.25",
    "nanoid": "^5.1.6"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "ray publish"
  },
  "platforms": [
    "macOS",
    "Windows"
  ]
}
