{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "bbcag-renamer",
  "title": "Renamer",
  "description": "Lernenden-Files automatisch umbenennen – für Coaches am BBCAG",
  "icon": "icon.png",
  "author": "melvinlauber",
  "categories": ["Productivity"],
  "license": "MIT",
  "commands": [
    {
      "name": "rename-files",
      "title": "Files Umbenennen",
      "description": "Schritt-für-Schritt: Lernende, Files und Bezeichnung festlegen",
      "icon": "rename-files.png",
      "mode": "view"
    },
    {
      "name": "manage-students",
      "title": "Listen Verwalten",
      "description": "Lernende hinzufügen, entfernen und sortieren",
      "icon": "manage-students.png",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.79.0",
    "@raycast/utils": "^1.17.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.11",
    "@types/node": "^20.8.10",
    "@types/react": "^19.0.10",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "typescript": "^5.4.5"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}
