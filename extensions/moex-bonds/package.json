{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "moex-bonds",
  "title": "MOEX Bonds",
  "description": "Search Russian bonds on the Moscow Exchange by name, ticker or ISIN: price, yield, coupons, offer and maturity.",
  "icon": "extension-icon.png",
  "author": "andrey_tolstikov",
  "categories": [
    "Finance"
  ],
  "platforms": [
    "macOS"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "search-bond",
      "title": "Search Bonds",
      "description": "Find a bond by name, ticker or ISIN and open its card.",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.0",
    "@raycast/utils": "^2.0.1"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.4",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "lint": "ray lint",
    "fix-lint": "ray lint --fix",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/test/*.test.js"
  }
}
