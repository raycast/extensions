{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "lucide-icons",
  "title": "Lucide Icons Search",
  "description": "Search the Lucide icon set",
  "icon": "command-icon.png",
  "author": "Sn0wye",
  "categories": [
    "Design Tools",
    "Developer Tools"
  ],
  "license": "MIT",
  "contributors": [
    "lin",
    "xilopaint",
    "ridemountainpig",
    "j3lte",
    "muhammadrizo"
  ],
  "platforms": [
    "macOS",
    "Windows"
  ],
  "commands": [
    {
      "name": "index",
      "title": "Search Icons",
      "subtitle": "Lucide",
      "description": "Grid view of Lucide icons",
      "mode": "view",
      "preferences": [
        {
          "name": "primaryAction",
          "type": "dropdown",
          "required": false,
          "title": "Primary Action",
          "description": "Primary action to use",
          "default": "copy-name",
          "data": [
            {
              "title": "Copy Name",
              "value": "copy-name"
            },
            {
              "title": "Copy SVG",
              "value": "copy-svg"
            },
            {
              "title": "Paste SVG",
              "value": "paste-svg"
            },
            {
              "title": "Copy Component",
              "value": "copy-component"
            },
            {
              "title": "Open In Browser",
              "value": "open-in-browser"
            }
          ]
        },
        {
          "name": "pascalCaseName",
          "title": "Copy Icon Name",
          "label": "Copy name in Pascal Case",
          "description": "Copy the icon name using Pascal case (e.g., 'LucideIconName').",
          "type": "checkbox",
          "required": false,
          "default": false
        }
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.24",
    "@raycast/utils": "^2.3.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.0"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "prepublishOnly": "echo \"\\n\\nIt seems like you are trying to publish the Raycast extension to npm.\\n\\nIf you did intend to publish it to npm, remove the \\`prepublishOnly\\` script and rerun \\`npm publish\\` again.\\nIf you wanted to publish it to the Raycast Store instead, use \\`npm run publish\\` instead.\\n\\n\" && exit 1",
    "publish": "npx @raycast/api@latest publish"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}
