{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "appsolutely",
  "type": "module",
  "title": "Appsolutely",
  "description": "A Launchpad-inspired app launcher. Browse installed macOS apps in a clean grid and organize them into folders and nested subfolders.",
  "icon": "extension-icon.png",
  "author": "cyan",
  "license": "MIT",
  "platforms": [
    "macOS"
  ],
  "categories": [
    "Applications",
    "Productivity"
  ],
  "keywords": [
    "app launcher",
    "launchpad",
    "applications",
    "app grid",
    "folders",
    "productivity"
  ],
  "commands": [
    {
      "name": "launcher",
      "title": "Open Appsolutely",
      "description": "All your apps. Appsolutely organized.",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^2.11.1",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/pngjs": "^6.0.5",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "dev": "ray develop",
    "build": "ray build",
    "publish": "npx @raycast/api@latest publish",
    "lint": "ray lint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/__tests__/*.test.ts",
    "benchmark": "node scripts/benchmark.mjs",
    "format": "prettier --write ."
  }
}
