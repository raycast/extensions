{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "calendly",
  "title": "Calendly Share Meeting Links",
  "description": "Quickly share your Calendly meeting links",
  "icon": "logo.png",
  "author": "eluce2",
  "contributors": [
    "eric_dumesnil",
    "0xdhrv"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "calendly",
      "title": "Share Meeting Link",
      "subtitle": "Calendly",
      "description": "Copy Meeting URL",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^2.1.2",
    "@raycast/utils": "^2.3.0",
    "axios": "^1.20.0",
    "moment": "^2.30.1"
  },
  "preferences": [
    {
      "name": "defaultAction",
      "type": "dropdown",
      "data": [
        {
          "title": "Copy Meeting Link",
          "value": "meeting"
        },
        {
          "title": "Copy Single Use Link",
          "value": "one-time"
        }
      ],
      "title": "Default Action",
      "description": "The action to use by default",
      "required": false,
      "default": "meeting",
      "value": "meeting"
    }
  ],
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/lodash": "^4.17.25",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "prepublishOnly": "echo \"\\n\\nIt seems like you are trying to publish the Raycast extension to npm.\\n\\nIf you did intend to publish it to npm, remove the \\`prepublishOnly\\` script and rerun \\`npm publish\\` again.\\nIf you wanted to publish it to the Raycast Store instead, use \\`npm run publish\\` instead.\\n\\n\" && exit 1",
    "publish": "npx @raycast/api@latest publish"
  },
  "platforms": [
    "macOS",
    "Windows"
  ]
}
