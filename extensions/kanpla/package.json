{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "kanpla",
  "title": "Kanpla",
  "description": "See what's for lunch at your Kanpla canteen",
  "icon": "kanpla-icon.png",
  "author": "taulo",
  "platforms": [
    "macOS",
    "Windows"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "menu",
      "title": "Menu",
      "description": "Get today's menu or get the menu for a specific date",
      "mode": "view",
      "arguments": [
        {
          "name": "date",
          "placeholder": "YYYY-MM-DD",
          "type": "text",
          "required": false
        }
      ]
    }
  ],
  "preferences": [
    {
      "name": "email",
      "title": "Email",
      "description": "Your Kanpla email",
      "type": "textfield",
      "required": true
    },
    {
      "name": "password",
      "title": "Password",
      "description": "Your Kanpla password",
      "type": "password",
      "required": true
    },
    {
      "name": "firebaseAPIKey",
      "title": "Firebase API Key",
      "description": "Firebase API Key for Kanpla",
      "type": "password",
      "required": true
    },
    {
      "name": "firebaseModuleId",
      "title": "Firebase Module ID",
      "description": "Firebase Module ID for Kanpla",
      "type": "textfield",
      "required": true
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.11",
    "@raycast/utils": "^1.17.0",
    "@taulo1999/kanpla-api": "^1.0.3"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.4",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "prepublishOnly": "echo \"\\n\\nIt seems like you are trying to publish the Raycast extension to npm.\\n\\nIf you did intend to publish it to npm, remove the \\`prepublishOnly\\` script and rerun \\`npm publish\\` again.\\nIf you wanted to publish it to the Raycast Store instead, use \\`npm run publish\\` instead.\\n\\n\" && exit 1",
    "publish": "npx @raycast/api@latest publish"
  }
}
