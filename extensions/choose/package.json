{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "choose",
  "title": "Choose Item from Stdin to Stdout",
  "description": "Opens picker from stdin and pipes selection to stdout. Comes with cli to do so.",
  "icon": "extension-icon.png",
  "author": "anaritus",
  "platforms": [
    "macOS"
  ],
  "categories": [
    "Developer Tools"
  ],
  "preferences": [
    {
      "name": "selectKey",
      "type": "dropdown",
      "required": false,
      "title": "Selection Key",
      "description": "Choose a key to use when selecting item",
      "default": "return",
      "data": [
        {
          "title": "Tab",
          "value": "tab"
        },
        {
          "title": "Space",
          "value": "space"
        },
        {
          "title": "Return / Enter",
          "value": "return"
        }
      ]
    }
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "choose",
      "title": "Choose Item",
      "subtitle": "Selection menu",
      "description": "Triggered via CLI",
      "mode": "view",
      "arguments": [
        {
          "name": "host",
          "type": "text",
          "placeholder": "127.0.0.1",
          "required": true
        },
        {
          "name": "port",
          "type": "text",
          "placeholder": "12345",
          "required": true
        }
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.18"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.4",
    "@types/node": "22.19.17",
    "@types/react": "19.0.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "prepublishOnly": "echo \"\\n\\nIt seems like you are trying to publish the Raycast extension to npm.\\n\\nIf you did intend to publish it to npm, remove the \\`prepublishOnly\\` script and rerun \\`npm publish\\` again.\\nIf you wanted to publish it to the Raycast Store instead, use \\`npm run publish\\` instead.\\n\\n\" && exit 1",
    "publish": "npx @raycast/api@latest publish"
  }
}
