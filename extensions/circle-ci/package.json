{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "circle-ci",
  "title": "CircleCI Workflows",
  "description": "Search your CircleCI projects and view the status of their latest pipelines, workflows and jobs. Requires a CircleCI API token.",
  "icon": "circle-logo.png",
  "author": "qeude",
  "contributors": [
    "bgnfu7re",
    "jns"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "command-project-search",
      "title": "Project Search",
      "subtitle": "CircleCI",
      "description": "List CircleCI projects and quickly navigate to them.",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "description": "Get it on https://app.circleci.com/settings/user/tokens",
      "name": "apiKey",
      "required": true,
      "title": "CircleCI API token",
      "type": "password"
    },
    {
      "name": "myPipelines",
      "required": false,
      "title": "Pipeline filtering",
      "type": "checkbox",
      "default": false,
      "description": "Only my pipelines",
      "label": "Only my pipelines"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.25.0",
    "node-fetch": "^3.0.0",
    "prettier": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "~16.10.0",
    "@types/react": "^17.0.28",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.3.0",
    "typescript": "^4.4.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop"
  }
}
