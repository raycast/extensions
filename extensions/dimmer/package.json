{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "dimmer",
  "title": "Dimmer",
  "description": "Dim every Mac display beyond its minimum brightness.",
  "icon": "icon.png",
  "author": "nachotafalla",
  "platforms": [
    "macOS"
  ],
  "categories": [
    "System"
  ],
  "keywords": [
    "screen",
    "display",
    "brightness",
    "dimmer",
    "night"
  ],
  "license": "MIT",
  "preferences": [
    {
      "name": "defaultLevel",
      "title": "Default Dim Level",
      "description": "The dim level used when Dimmer is turned on.",
      "type": "dropdown",
      "required": true,
      "default": "40",
      "data": [
        {
          "title": "10%",
          "value": "10"
        },
        {
          "title": "20%",
          "value": "20"
        },
        {
          "title": "30%",
          "value": "30"
        },
        {
          "title": "40%",
          "value": "40"
        },
        {
          "title": "50%",
          "value": "50"
        },
        {
          "title": "60%",
          "value": "60"
        },
        {
          "title": "70%",
          "value": "70"
        },
        {
          "title": "80%",
          "value": "80"
        },
        {
          "title": "90%",
          "value": "90"
        }
      ]
    },
    {
      "name": "step",
      "title": "Adjustment Step",
      "description": "How much Dim More and Dim Less change the dim level.",
      "type": "dropdown",
      "required": true,
      "default": "10",
      "data": [
        {
          "title": "5%",
          "value": "5"
        },
        {
          "title": "10%",
          "value": "10"
        },
        {
          "title": "15%",
          "value": "15"
        },
        {
          "title": "20%",
          "value": "20"
        }
      ]
    },
    {
      "name": "showPercentage",
      "title": "Menu Bar",
      "description": "Show the active dim percentage beside the menu bar icon.",
      "type": "checkbox",
      "required": false,
      "default": true,
      "label": "Show dim percentage"
    }
  ],
  "commands": [
    {
      "name": "toggle-dimming",
      "title": "Toggle Dimmer",
      "subtitle": "Dimmer",
      "description": "Turn extra screen dimming on or off.",
      "mode": "no-view"
    },
    {
      "name": "dim-more",
      "title": "Dim More",
      "subtitle": "Dimmer",
      "description": "Increase extra screen dimming.",
      "mode": "no-view"
    },
    {
      "name": "dim-less",
      "title": "Dim Less",
      "subtitle": "Dimmer",
      "description": "Decrease extra screen dimming.",
      "mode": "no-view"
    },
    {
      "name": "set-dim-level",
      "title": "Set Dim Level",
      "subtitle": "Dimmer",
      "description": "Set an exact extra dim level.",
      "mode": "no-view",
      "arguments": [
        {
          "name": "level",
          "type": "dropdown",
          "placeholder": "Dim level",
          "required": true,
          "data": [
            {
              "title": "Off",
              "value": "0"
            },
            {
              "title": "10%",
              "value": "10"
            },
            {
              "title": "20%",
              "value": "20"
            },
            {
              "title": "30%",
              "value": "30"
            },
            {
              "title": "40%",
              "value": "40"
            },
            {
              "title": "50%",
              "value": "50"
            },
            {
              "title": "60%",
              "value": "60"
            },
            {
              "title": "70%",
              "value": "70"
            },
            {
              "title": "80%",
              "value": "80"
            },
            {
              "title": "90%",
              "value": "90"
            }
          ]
        }
      ]
    },
    {
      "name": "reset-dimming",
      "title": "Reset Dimmer",
      "subtitle": "Dimmer",
      "description": "Immediately remove all Dimmer overlays.",
      "mode": "no-view"
    },
    {
      "name": "dimmer-menu",
      "title": "Dimmer Menu Bar",
      "subtitle": "Dimmer",
      "description": "Control Dimmer and see its current level from the menu bar.",
      "mode": "menu-bar"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.23",
    "@raycast/utils": "^2.2.7"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "22.19.17",
    "@types/react": "19.0.10",
    "eslint": "^9.39.2",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "prepublishOnly": "echo \"Use npm run publish to publish Dimmer to the Raycast Store.\" && exit 1",
    "publish": "npx @raycast/api@latest publish",
    "test:review": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types tests/file-lock.test.mjs",
    "verify": "npm run test:review && npm run lint && npm run build"
  }
}
