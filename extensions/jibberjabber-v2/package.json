{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "jibberjabber-v2",
  "title": "JibberJabber",
  "description": "A quick scratchpad right inside Raycast",
  "icon": "extension_icon.png",
  "author": "JJJJJJJJ",
  "categories": ["Productivity"],
  "license": "MIT",
  "commands": [
    {
      "name": "jotnow",
      "title": "Jot Now",
      "description": "Open a blank scratchpad and start typing",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.79.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.11",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.10",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "typescript": "^5.4.5"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}
