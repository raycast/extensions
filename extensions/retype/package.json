{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "retype",
  "title": "Retype",
  "description": "Fix text that you typed in a wrong keyboard layout and switch to the correct layout.",
  "icon": "extension_icon.png",
  "author": "pavel_shut",
  "categories": [
    "Productivity"
  ],
  "license": "MIT",
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "commands": [
    {
      "name": "index",
      "title": "Retype text typed in wrong keyboard layout",
      "description": "Fix text that you typed in a wrong keyboard layout and switch to the correct layout.",
      "mode": "no-view",
      "keywords": [
        "punto switcher",
        "keyboard layout",
        "wrong layout",
        "switch language",
        "convert layout"
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^2.6.2",
    "@raycast/utils": "^2.3.2"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "^22.19.17",
    "@types/react": "^19.0.10",
    "eslint": "^9.39.2",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "platforms": [
    "macOS"
  ]
}
