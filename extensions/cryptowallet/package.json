{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "cryptowallet",
  "title": "CryptoWallet",
  "description": "Track simulated crypto portfolios with CoinMarketCap prices.",
  "icon": "wallet-icon.png",
  "author": "andrea_cipriani",
  "platforms": [
    "macOS"
  ],
  "categories": [
    "Finance"
  ],
  "keywords": [
    "crypto",
    "portfolio",
    "wallet",
    "coinmarketcap",
    "bitcoin"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "cryptowallet",
      "title": "CryptoWallet",
      "description": "Manage crypto portfolios, transactions, and live performance.",
      "mode": "view"
    },
    {
      "name": "add-transaction",
      "title": "Add Transaction",
      "description": "Quickly add a crypto transaction to a portfolio.",
      "mode": "view"
    },
    {
      "name": "search-asset",
      "title": "Search Asset",
      "description": "Search CoinMarketCap assets and see live prices.",
      "mode": "view"
    },
    {
      "name": "portfolio-snapshot",
      "title": "Portfolio Snapshot",
      "description": "View a compact read-only snapshot of all portfolios.",
      "mode": "view"
    },
    {
      "name": "daily-report",
      "title": "Daily Report",
      "description": "Copy today's CryptoWallet report as Markdown.",
      "mode": "no-view"
    },
    {
      "name": "portfolio-menu-bar",
      "title": "Portfolio Value",
      "description": "Show total CryptoWallet value in the menu bar.",
      "mode": "menu-bar",
      "interval": "5m"
    }
  ],
  "tools": [
    {
      "name": "ask-ai",
      "title": "Ask AI",
      "description": "Answer free-form questions using CryptoWallet portfolio overviews, holdings, performance, and recent transactions."
    }
  ],
  "preferences": [
    {
      "name": "coinMarketCapApiKey",
      "title": "CoinMarketCap API Key",
      "description": "Used locally to fetch live cryptocurrency prices.",
      "type": "password",
      "required": true
    },
