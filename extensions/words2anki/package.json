{
    "$schema": "https://www.raycast.com/schemas/extension.json",
    "name": "words2anki",
    "title": "Words to Anki",
    "description": "Capture words from text selection and create Anki cards with AI-generated definitions",
    "icon": "command-icon.png",
    "author": "kevinyu_world",
    "access": "public",
    "categories": [
        "Productivity",
        "Developer Tools"
    ],
    "license": "MIT",
    "commands": [
        {
            "name": "ankicard",
            "title": "Create Anki Card",
            "description": "Create an Anki card from selected word with context from clipboard",
            "mode": "no-view",
            "script": "src/ankicard.tsx"
        }
    ],
    "preferences": [
        {
            "name": "deepseekApiKey",
            "type": "password",
            "required": true,
            "title": "DeepSeek API Key",
            "description": "Your DeepSeek API key for AI-powered definitions",
            "placeholder": "sk-..."
        },
        {
            "name": "ankiDeck",
            "type": "textfield",
            "required": false,
            "title": "Anki Deck Name",
            "description": "The deck to add cards to (default: 'Default')",
            "default": "Default",
            "placeholder": "Default"
        },
        {
            "name": "ankiConnectUrl",
            "type": "textfield",
            "required": false,
            "title": "AnkiConnect URL",
            "description": "AnkiConnect server URL (default: http://localhost:8765)",
            "default": "http://localhost:8765",
            "placeholder": "http://localhost:8765"
        },
        {
            "name": "noteType",
            "type": "textfield",
            "required": false,
            "title": "Anki Note Type",
            "description": "The note type to use (default: 'Cloze')",
            "default": "Cloze",
            "placeholder": "Cloze"
        }
    ],
    "dependencies": {
        "@raycast/api": "^1.65.0",
        "@raycast/utils": "^1.12.0",
        "axios": "^1.6.0"
    },
    "devDependencies": {
        "@raycast/eslint-config": "^1.0.8",
        "@types/node": "20.8.10",
        "@types/react": "18.2.27",
        "eslint": "^8.51.0",
        "prettier": "^3.0.3",
        "typescript": "^5.2.2"
    },
    "scripts": {
        "build": "ray build -e dist",
        "dev": "ray develop",
        "fix-lint": "ray lint --fix",
        "lint": "ray lint",
        "publish": "npx @raycast/api@latest publish"
    }
}