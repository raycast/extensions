{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "countdown",
  "title": "Date Countdown",
  "description": "Create date countdowns and see how many days remain.",
  "icon": "icon.png",
  "author": "mati",
  "license": "MIT",
  "categories": [
    "Productivity"
  ],
  "platforms": [
    "macOS"
  ],
  "commands": [
    {
      "name": "manage-countdowns",
      "title": "Countdowns",
      "description": "Create countdowns and see how many days remain.",
      "mode": "view",
      "keywords": [
        "days",
        "date",
        "deadline",
        "event"
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.19"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.1.1",
    "@types/node": "22.19.17",
    "@types/react": "19.0.10",
    "eslint": "^9.39.1",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "dev": "ray develop",
    "build": "ray build -e dist",
    "publish": "npx @raycast/api@latest publish",
    "lint": "ray lint",
    "fix-lint": "ray lint --fix",
    "fix-prettier": "prettier --write src"
  }
}
