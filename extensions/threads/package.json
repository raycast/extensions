{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "threads",
  "title": "Threads",
  "description": "Quickly post to Threads and see recent updates.",
  "icon": "threads-icon.png",
  "author": "chrismessina",
  "contributors": [
    "ridemountainpig"
  ],
  "categories": [
    "Media"
  ],
  "license": "MIT",
  "keywords": [
    "threads",
    "social",
    "posting",
    "messaging",
    "communication"
  ],
  "commands": [
    {
      "name": "feed",
      "title": "My Feeds",
      "subtitle": "Threads",
      "description": "Go To Threads Feed",
      "mode": "no-view",
      "arguments": [
        {
          "name": "feed",
          "placeholder": "-",
          "description": "Show feed",
          "type": "dropdown",
          "data": [
            {
              "title": "For You",
              "value": "for_you"
            },
            {
              "title": "Following",
              "value": "following"
            },
            {
              "title": "Liked",
              "value": "liked"
            },
            {
              "title": "Saved",
              "value": "saved"
            }
          ]
        }
      ]
    },
    {
      "name": "activity",
      "title": "Activity",
      "subtitle": "Threads",
      "description": "View Threads Activity",
      "mode": "no-view",
      "arguments": [
        {
          "name": "page",
          "placeholder": "-",
          "description": "Open Page",
          "type": "dropdown",
          "data": [
            {
              "title": "All",
              "value": "all"
            },
            {
              "title": "Follows",
              "value": "follows"
            },
            {
              "title": "Replies",
              "value": "replies"
            },
            {
              "title": "Mentions",
              "value": "mentions"
            },
            {
              "title": "Quotes",
              "value": "quotes"
            },
            {
              "title": "Reposts",
              "value": "reposts"
            },
            {
              "title": "Verified",
              "value": "verified"
            }
          ]
        }
      ]
    },
    {
      "name": "quick-thread",
      "title": "Quick Post",
      "subtitle": "Threads",
      "description": "Quickly create a new post on Threads.",
      "mode": "no-view",
      "arguments": [
        {
          "name": "text",
          "description": "The text of the post.",
          "type": "text",
          "placeholder": "Start a thread...",
          "required": true
        },
        {
          "name": "attachment",
          "description": "An attachment to the post.",
          "type": "text",
          "placeholder": "Add a link",
          "required": false
        }
      ]
    },
    {
      "name": "search",
      "title": "Search",
      "subtitle": "Threads",
      "description": "Search Threads",
      "mode": "no-view",
      "arguments": [
        {
          "name": "query",
          "description": "The text to search for.",
          "type": "text",
          "placeholder": "Keywords or hashtags",
          "required": true
        },
        {
          "name": "sort",
          "description": "How to sort the results.",
          "placeholder": "Sort by...",
          "type": "dropdown",
          "data": [
            {
              "title": "Top",
              "value": "top"
            },
            {
              "title": "Recent",
              "value": "recent"
            }
          ]
        }
      ]
    },
    {
      "name": "new-thread",
      "title": "Start a New Thread",
      "subtitle": "Threads",
      "description": "Create a new post on Threads.",
      "mode": "view"
    },
    {
      "name": "quick-follow",
      "title": "Quick Follow",
      "subtitle": "Threads",
      "description": "Quickly follow an account on Threads",
      "mode": "no-view",
      "arguments": [
        {
          "name": "username",
          "description": "The account to be followed.",
          "type": "text",
          "placeholder": "@username",
          "required": true
        }
      ]
    },
    {
      "name": "view-profile",
      "title": "View Profile",
      "subtitle": "Threads",
      "description": "View a Threads user profile",
      "mode": "no-view",
      "arguments": [
        {
          "name": "username",
          "description": "The username to view",
          "type": "text",
          "placeholder": "@username",
          "required": true
        }
      ]
    },
    {
      "name": "view-insights",
      "title": "Insights",
      "subtitle": "Threads",
      "description": "View account insights",
      "mode": "no-view",
      "arguments": [
        {
          "name": "period",
          "placeholder": "-",
          "description": "Period to view insights for",
          "type": "dropdown",
          "default": "30",
          "data": [
            {
              "title": "Last 7 days",
              "value": "7"
            },
            {
              "title": "Last 14 days",
              "value": "14"
            },
            {
              "title": "Last 30 days",
              "value": "30"
            },
            {
              "title": "Last 90 days",
              "value": "90"
            }
          ]
        }
      ]
    },
    {
      "name": "download-thread-media",
      "title": "Download Threads Media",
      "description": "Download images, videos, and voice posts from a Threads post URL",
      "mode": "no-view",
      "arguments": [
        {
          "name": "threadsUrl",
          "description": "Link to a Threads post — canonical or share link",
          "type": "text",
          "placeholder": "Threads post or share URL",
          "required": true
        }
      ],
      "preferences": [
        {
          "name": "mediaDownloadPath",
          "title": "Media Download Path",
          "description": "Directory to save downloaded media (defaults to ~/Downloads)",
          "type": "directory",
          "required": false
        },
        {
          "name": "imageFormat",
          "title": "Image Format",
          "description": "Convert downloaded images to your preferred format. macOS only.",
          "type": "dropdown",
          "required": false,
          "default": "original",
          "data": [
            {
              "title": "Original",
              "value": "original"
            },
            {
              "title": "JPEG",
              "value": "jpeg"
            },
            {
              "title": "PNG",
              "value": "png"
            }
          ]
        }
      ]
    }
  ],
  "dependencies": {
    "@chrismessina/raycast-kit": "^0.2.0",
    "@chrismessina/raycast-logger": "^1.5.0",
    "@raycast/api": "^2.2.1"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "^22.18.1",
    "@types/react": "^19.2.18",
    "eslint": "^9.35.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "prepublishOnly": "echo \"\\n\\nIt seems like you are trying to publish the Raycast extension to npm.\\n\\nIf you did intend to publish it to npm, remove the \\`prepublishOnly\\` script and rerun \\`npm publish\\` again.\\nIf you wanted to publish it to the Raycast Store instead, use \\`npm run publish\\` instead.\\n\\n\" && exit 1",
    "publish": "npx @raycast/api@latest publish",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.mts"
  },
  "platforms": [
    "macOS",
    "Windows"
  ],
  "preferences": [
    {
      "name": "verboseLogging",
      "title": "Debug Logging",
      "label": "Enable extra diagnostics in the console",
      "description": "Show detailed logs in the console for debugging.",
      "type": "checkbox",
      "required": false,
      "default": false
    }
  ]
}
