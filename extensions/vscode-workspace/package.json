{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "vscode-workspace",
  "title": "VS Code Workspace",
  "description": "Search and open recent projects from VS Code and compatible editors, even when they're not running. Works offline using cached data.",
  "icon": "icon.png",
  "license": "MIT",
  "commands": [
    {
      "name": "search-workspace",
      "title": "Search Workspace",
      "description": "Search and open recent projects from VS Code and compatible editors",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "build",
      "type": "dropdown",
      "required": false,
      "title": "Build",
      "default": "Code",
      "description": "Select which editor build to use when searching for recent projects",
      "data": [
        {
          "title": "Antigravity",
          "value": "Antigravity"
        },
        {
          "title": "Cursor",
          "value": "Cursor"
        },
        {
          "title": "Kiro",
          "value": "Kiro"
        },
        {
          "title": "Positron",
          "value": "Positron"
        },
        {
          "title": "Trae",
          "value": "Trae"
        },
        {
          "title": "Trae CN",
          "value": "Trae CN"
        },
        {
          "title": "VSCodium",
          "value": "VSCodium"
        },
        {
          "title": "VSCodium - Insiders",
          "value": "VSCodium - Insiders"
        },
        {
          "title": "Visual Studio Code",
          "value": "Code"
        },
        {
          "title": "Visual Studio Code - Insiders",
          "value": "Code - Insiders"
        },
        {
          "title": "Windsurf",
          "value": "Windsurf"
        },
        {
          "title": "Lingma",
          "value": "Lingma"
        }
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.103.0",
    "@raycast/utils": "^2.2.1",
    "better-sqlite3": "^12.8.0",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "@types/sql.js": "^1.4.11",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "dev": "ray develop",
    "lint": "ray lint",
    "fix-lint": "ray lint --fix",
    "build": "ray build",
    "publish": "npx @raycast/api@latest publish",
    "prepublishOnly": "echo \"\\n\\nIt seems like you are trying to publish the Raycast extension to npm.\\n\\nIf you did intend to publish it to npm, remove the \\`prepublishOnly\\` script and rerun \\`npm publish\\` again.\\nIf you wanted to publish it to the Raycast Store instead, use \\`npm run publish\\` instead.\\n\\n\" && exit 1"
  },
  "author": "mikan-megane",
  "platforms": [
    "Windows",
    "macOS"
  ],
  "keywords": [
    "vscode",
    "antigravity",
    "cursor",
    "codium",
    "kiro",
    "positron",
    "windsurf",
    "trae",
    "trae-cn",
    "lingma"
  ],
  "categories": [
    "Developer Tools"
  ]
}
