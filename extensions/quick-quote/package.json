{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "quick-quote",
  "title": "Quick Quote",
  "description": "Quote selected text as a Markdown blockquote. Built for pasting CLI agent output back into a prompt.",
  "type": "module",
  "icon": "extension-icon.png",
  "author": "kumamaki",
  "platforms": [
    "macOS"
  ],
  "license": "MIT",
  "categories": [
    "Productivity",
    "Developer Tools"
  ],
  "keywords": [
    "quote",
    "blockquote",
    "markdown",
    "selection",
    "claude",
    "agent",
    "prompt"
  ],
  "commands": [
    {
      "name": "quick-quote",
      "title": "Quick Quote",
      "description": "Prefix every line of the selection with '> ' and paste it back into the focused app.",
      "mode": "no-view",
      "keywords": [
        "quote",
        "blockquote",
        "markdown",
        "claude",
        "agent",
        "prompt"
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.23",
    "@raycast/utils": "^2.2.7"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "^25.9.5",
    "@types/react": "^19.0.0",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}
