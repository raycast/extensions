{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "version": "1.0.0",
  "name": "linear-project-hub",
  "title": "Linear Project Hub",
  "description": "Search Linear projects and open a project briefing hub with pulses, resources, Slack, and connected PRs.",
  "icon": "extension-icon.png",
  "author": "iarmankhan",
  "access": "public",
  "categories": ["Developer Tools", "Productivity"],
  "license": "MIT",
  "commands": [
    {
      "name": "search-projects",
      "title": "Search Projects",
      "description": "Search Linear projects and open a project briefing hub.",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@linear/sdk": "^59.0.0",
    "@raycast/api": "^1.104.0",
    "@raycast/utils": "^2.2.1",
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.4",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}
