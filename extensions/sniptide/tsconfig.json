{
  "$schema": "https://json.schemastore.org/tsconfig",
  "include": ["src/**/*", "test/**/*", "raycast-env.d.ts"],
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2023",
    "strict": true,
    "types": ["bun", "node"],
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "noEmit": true
  }
}
