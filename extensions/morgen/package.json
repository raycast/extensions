{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "morgen",
  "title": "Morgen",
  "description": "Create Morgen tasks from Raycast",
  "icon": "command-icon.png",
  "author": "ndekross",
  "license": "MIT",
  "platforms": ["macOS"],
  "categories": ["Productivity"],
  "keywords": ["morgen", "task", "todo", "calendar"],
  "commands": [
    {
      "name": "create-task",
      "title": "Create Task",
      "description": "Create a new task in Morgen",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "apiKey",
      "type": "password",
      "required": true,
      "title": "API Key",
      "description": "Your Morgen API key. Create one at https://platform.morgen.so/developers-api.",
      "placeholder": "Morgen API key"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.13",
    "@raycast/utils": "^2.2.4"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.1.1",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.9.2"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint"
  }
}
