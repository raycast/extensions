{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "aztu-lms",
  "title": "AzTU LMS",
  "version": "1.0.0",
  "description": "Log in to the AzTU LMS of Azerbaijan Technical University in one step.",
  "icon": "icon.png",
  "author": "yusifaliyevpro",
  "categories": [
    "Web",
    "Productivity"
  ],
  "license": "MIT",
  "platforms": [
    "macOS",
    "Windows"
  ],
  "commands": [
    {
      "name": "login-account",
      "title": "Login in Browser",
      "description": "Login to your AzTU LMS account in browser",
      "mode": "no-view"
    },
    {
      "name": "delete-session",
      "title": "Delete Session",
      "description": "Delete old session to get a new login link",
      "mode": "no-view"
    }
  ],
  "preferences": [
    {
      "name": "userid",
      "title": "User ID",
      "description": "Enter your AzTU LMS user ID",
      "placeholder": "202501234",
      "type": "textfield",
      "required": true
    },
    {
      "name": "password",
      "title": "Password",
      "description": "Enter your AzTU LMS password",
      "type": "password",
      "required": true
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.18",
    "fetch-cookie": "3.2.0",
    "tough-cookie": "^6.0.1"
  },
  "devDependencies": {
    "@raycast/eslint-config": "2.1.1",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.15",
    "eslint": "^9.39.4",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}
