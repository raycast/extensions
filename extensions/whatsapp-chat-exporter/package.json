{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "whatsapp-chat-exporter",
  "title": "WhatsApp Chat Exporter",
  "description": "Export WhatsApp chats to JSON or Markdown with media files. Supports individual or bulk export with proper sender identification.",
  "icon": "icon.png",
  "author": "IamMohitM",
  "categories": [
    "Productivity",
    "Data"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "export-chats",
      "title": "Export WhatsApp Chats",
      "description": "Export specific or all WhatsApp chats to a local folder",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.93.0",
    "@raycast/utils": "^1.19.0",
    "fs-extra": "^11.3.0",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.11",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "20.8.10",
    "@types/react": "18.2.27",
    "@types/react-dom": "18.2.14",
    "@types/sql.js": "^1.4.9",
    "@types/sqlite3": "^3.1.11",
    "eslint": "^8.57.0",
    "prettier": "^3.5.3",
    "typescript": "^5.4.5"
  },
  "overrides": {
    "@types/react": "18.2.27",
    "@types/react-dom": "18.2.14"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}