{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "bcassessment",
  "title": "BC Assessment",
  "description": "Search BC Assessment properties by address.",
  "icon": "extension-icon.png",
  "author": "martins",
  "categories": [
    "Productivity"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "search-address",
      "title": "Search Address",
      "description": "Find matching BC Assessment addresses.",
      "icon": "extension-icon.png",
      "mode": "view",
      "keywords": [
        "bcass",
        "bca",
        "bcassessment"
      ],
      "arguments": [
        {
          "name": "address",
          "placeholder": "Address",
          "type": "text",
          "required": false
        }
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.83.2"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.11",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "eslint": "^8.57.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "ray publish"
  }
}
