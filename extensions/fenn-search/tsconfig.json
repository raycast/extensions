{
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "types": ["node", "react"],
    "module": "Node16",
    "target": "ES2022",
    "moduleResolution": "Node16",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["src/**/*", "tests/**/*", "scripts/**/*", "raycast-env.d.ts"]
}
