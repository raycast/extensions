# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# secrets: this extension is driven by BUZZ_PRIVATE_KEY, so never let an env
# file reach the public repo
.env
.env.*
!.env.example

# dependencies
/node_modules

# Raycast specific files
raycast-env.d.ts
.raycast-swift-build
.swiftpm
compiled_raycast_swift
compiled_raycast_rust

# test output
coverage/

# internal working docs: kept on disk, never published to the public repo
docs/
PROJECT_BRIEF.md
CLAUDE.md
context.md

# build output
dist/
build/
*.tsbuildinfo

# logs
*.log
npm-debug.log*
yarn-error.log*

# editor
.vscode/
.idea/

# misc
.DS_Store

# tooling / generated (graphify code-graph, python-based helpers)
node_modules
graphify-out/
.superpowers/
__pycache__/
*.pyc
.venv/
.pytest_cache/
*.egg-info/
