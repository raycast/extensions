{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "bart-departures",
  "version": "1.0.0",
  "title": "BART Departures",
  "description": "View real-time BART departures for a selected station",
  "icon": "bart.png",
  "author": "drewkiimon",
  "access": "public",
  "categories": [
    "Productivity"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "index",
      "title": "BART Departures",
      "description": "View real-time departures for a BART station",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.103.0",
    "lodash": "^4.18.1"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.11",
    "@types/lodash": "^4.17.24",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "eslint": "^8.51.0",
    "prettier": "^3.0.3",
    "react": "^18.2.0",
    "typescript": "^5.2.2"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "ray publish"
  },
  "platforms": [
    "macOS"
  ]
}
