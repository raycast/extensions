{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "android-weekly",
  "title": "Android Weekly",
  "description": "Browse Android Weekly issues and read the latest articles",
  "icon": "extension-icon.png",
  "author": "mibrahimdev",
  "categories": ["News"],
  "license": "MIT",
  "platforms": ["macOS"],
  "commands": [
    {
      "name": "browse-issues",
      "title": "Browse Issues",
      "description": "Browse Android Weekly issues and read articles",
      "icon": "extension-icon.png",
      "mode": "view",
      "keywords": ["android", "weekly", "kotlin", "newsletter"]
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.103.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.11",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish",
    "test": "vitest run"
  }
}
