{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "opencode-launcher",
  "title": "OpenCode Launcher",
  "description": "Browse, resume, and launch OpenCode sessions in your preferred terminal.",
  "icon": "icon.png",
  "author": "safar_Safarov",
  "categories": ["Developer Tools", "Productivity"],
  "license": "MIT",
  "version": "1.0.0",
  "platforms": ["macOS"],
  "commands": [
    {
      "name": "sessions",
      "title": "OpenCode Sessions",
      "subtitle": "OpenCode",
      "description": "Browse and resume OpenCode sessions or start a new one",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "terminalApp",
      "title": "Terminal Application",
      "description": "Choose your preferred terminal application",
      "type": "dropdown",
      "required": false,
      "default": "Terminal",
      "data": [
        {
          "title": "Terminal",
          "value": "Terminal"
        },
        {
          "title": "iTerm2",
          "value": "iTerm2"
        },
        {
          "title": "Warp",
          "value": "Warp"
        },
        {
          "title": "Ghostty",
          "value": "Ghostty"
        },
        {
          "title": "Alacritty",
          "value": "Alacritty"
        }
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.102.3",
    "@raycast/utils": "^1.17.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.4",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}
