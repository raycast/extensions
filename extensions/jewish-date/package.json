{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "jewish-date",
  "title": "Jewish Date",
  "description": "Get today's Hebrew date in Hebrew.",
  "icon": "icon.png",
  "author": "jberrebi",
  "type": "module",
  "license": "MIT",
  "categories": [
    "Productivity"
  ],
  "platforms": [
    "macOS"
  ],
  "commands": [
    {
      "name": "jewish-date",
      "title": "Jewish Date",
      "description": "Show today's Jewish date in Hebrew and copy it to the clipboard.",
      "mode": "view",
      "keywords": [
        "jewish",
        "hebrew",
        "date",
        "calendar"
      ]
    }
  ],
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "publish": "npx @raycast/api@latest publish",
    "lint": "ray lint",
    "fix-lint": "ray lint --fix"
  },
  "dependencies": {
    "@raycast/api": "^1.104.19"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.4",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  }
}
