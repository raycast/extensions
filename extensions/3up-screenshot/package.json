{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "3up-screenshot",
  "title": "3Up Screenshot",
  "description": "Capture a screen area and instantly extract text using macOS Vision OCR.",
  "categories": [
    "Productivity",
    "System"
  ],
  "keywords": [
    "ocr",
    "screenshot",
    "text",
    "recognition"
  ],
  "icon": "extension-icon.png",
  "author": "melman_kk",
  "license": "MIT",
  "commands": [
    {
      "name": "index",
      "title": "3Up Screenshot",
      "description": "Capture screen area and extract text",
      "mode": "no-view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.92.1",
    "@raycast/utils": "^1.19.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.11",
    "@types/node": "20.8.10",
    "@types/react": "18.3.3",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "typescript": "^5.4.5"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}