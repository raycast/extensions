{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "wandb",
  "title": "Weights & Biases",
  "description": "Browse your W&B entities, projects, and runs, and jump into them.",
  "icon": "extension-icon.png",
  "author": "scomble13",
  "categories": ["Developer Tools", "Data"],
  "license": "MIT",
  "commands": [
    {
      "name": "search-wandb",
      "title": "Search Projects",
      "subtitle": "Weights & Biases",
      "description": "Browse W&B entities, projects, and runs",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.100.3",
    "@raycast/utils": "^1.19.1"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.4",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "test": "vitest run",
    "publish": "npx @raycast/api@latest publish"
  }
}
