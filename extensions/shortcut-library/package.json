{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "shortcut-library",
  "title": "Shortcut Library",
  "description": "Your own custom keyboard shortcuts, grouped and fuzzy-searchable",
  "keywords": [
    "shortcuts",
    "keyboard",
    "keybindings",
    "productivity"
  ],
  "icon": "icon.png",
  "author": "rhrabun",
  "categories": [
    "Productivity"
  ],
  "license": "MIT",
  "platforms": [
    "macOS",
    "Windows"
  ],
  "commands": [
    {
      "name": "index",
      "title": "Browse Shortcuts",
      "description": "Browse and fuzzy-search your custom keyboard shortcuts",
      "mode": "view"
    },
    {
      "name": "discover-shortcuts",
      "title": "Discover Shortcuts",
      "description": "Scan macOS app menu shortcut customizations and import them",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^2.0.4",
    "@raycast/utils": "^2.3.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "eslint": "^10.6.0",
    "prettier": "^3.9.4",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish",
    "test": "tsx --test tests/schema.test.ts tests/discover.test.ts tests/scanner.test.ts"
  }
}
