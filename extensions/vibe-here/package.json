{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "vibe-here",
  "title": "Vibe Here",
  "description": "Open Mistral Vibe in Warp or Ghostty in the selected folder — like Open in Warp.",
  "icon": "vibe-icon.png",
  "author": "sierakk",
  "categories": ["Developer Tools"],
  "license": "MIT",
  "commands": [
    {
      "name": "vibe-here",
      "title": "Vibe Here",
      "description": "Open Warp or Ghostty in the current/selected folder and start vibe",
      "mode": "no-view",
      "icon": "vibe-icon.png"
    }
  ],
  "preferences": [
    {
      "name": "terminal",
      "type": "dropdown",
      "required": false,
      "title": "Terminal",
      "description": "Which terminal should launch vibe",
      "default": "warp",
      "data": [
        { "title": "Warp", "value": "warp" },
        { "title": "Ghostty", "value": "ghostty" }
      ]
    },
    {
      "name": "vibePath",
      "type": "textfield",
      "required": false,
      "title": "vibe binary",
      "description": "Path to the vibe CLI (Homebrew default is fine)",
      "default": "/opt/homebrew/bin/vibe",
      "placeholder": "/opt/homebrew/bin/vibe"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.98.5"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.4",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint"
  }
}
