{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "kokoro-tts",
  "title": "Kokoro TTS",
  "description": "Read selected English text aloud using Kokoro, a fast open-source TTS model running locally on Apple Silicon via MLX.",
  "icon": "extension-icon.png",
  "author": "adrian_antosiak",
  "categories": ["Productivity"],
  "platforms": ["macOS"],
  "license": "MIT",
  "commands": [
    {
      "name": "speak-english",
      "title": "Speak English",
      "description": "Read the selected text aloud in English",
      "mode": "no-view",
      "preferences": [
        {
          "name": "voice",
          "title": "Voice",
          "description": "English voice to use",
          "type": "dropdown",
          "required": false,
          "default": "af_bella",
          "data": [
            { "title": "Alloy (Female)", "value": "af_alloy" },
            { "title": "Aoede (Female)", "value": "af_aoede" },
            { "title": "Bella (Female)", "value": "af_bella" },
            { "title": "Heart (Female)", "value": "af_heart" },
            { "title": "Jessica (Female)", "value": "af_jessica" },
            { "title": "Kore (Female)", "value": "af_kore" },
            { "title": "Nicole (Female)", "value": "af_nicole" },
            { "title": "Nova (Female)", "value": "af_nova" },
            { "title": "River (Female)", "value": "af_river" },
            { "title": "Sarah (Female)", "value": "af_sarah" },
            { "title": "Sky (Female)", "value": "af_sky" },
            { "title": "Adam (Male)", "value": "am_adam" },
            { "title": "Echo (Male)", "value": "am_echo" },
            { "title": "Eric (Male)", "value": "am_eric" },
            { "title": "Fenrir (Male)", "value": "am_fenrir" },
            { "title": "Liam (Male)", "value": "am_liam" },
            { "title": "Michael (Male)", "value": "am_michael" },
            { "title": "Onyx (Male)", "value": "am_onyx" },
            { "title": "Puck (Male)", "value": "am_puck" },
            { "title": "Santa (Male)", "value": "am_santa" }
          ]
        },
        {
          "name": "speed",
          "title": "Speed",
          "description": "Speech speed multiplier (e.g. 1.0 = normal, 1.5 = faster)",
          "type": "textfield",
          "required": false,
          "default": "1.0"
        }
      ]
    },
    {
      "name": "stop-speaking",
      "title": "Stop Speaking",
      "description": "Stop the currently playing TTS audio",
      "mode": "no-view"
    }
  ],
  "preferences": [
    {
      "name": "pythonPath",
      "title": "Python Path",
      "description": "Path to a Python 3 (3.10–3.12) with the mlx-audio packages installed. Use \"python3\" for system Python, or the full path to a virtualenv's interpreter (e.g. ~/kokoro-tts-venv/bin/python3).",
      "type": "textfield",
      "required": false,
      "default": "python3"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.18",
    "@raycast/utils": "^2.2.5"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.11",
    "@types/node": "^22.18.8",
    "@types/react": "^19.2.15",
    "eslint": "^8.57.1",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "prepublishOnly": "echo \"Error: no publish\" && exit 1",
    "publish": "npx @raycast/api@latest publish"
  }
}
