{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "go-package-explorer",
  "title": "Go Package Explorer",
  "description": "Browse and search Go packages from pkg.go.dev with filtering and examples",
  "icon": "go-icon.png",
  "author": "knight_deve",
  "categories": [
    "Developer Tools",
    "Documentation"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "browse-standard-library",
      "title": "Browse Standard Library",
      "description": "Browse Go standard library packages",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.65.0",
    "@raycast/utils": "^1.12.0",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.8",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.45",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}