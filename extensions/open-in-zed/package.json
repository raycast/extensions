{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "open-in-zed",
  "title": "Open in Zed",
  "description": "Open current File Manager directory, selected folder or file in Zed.",
  "icon": "icon.png",
  "author": "amankumar_verma",
  "categories": [
    "Developer Tools",
    "Productivity"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "index",
      "title": "Open in Zed",
      "description": "Open current File Manager directory, selected folder or file in Zed.",
      "mode": "no-view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.103.10",
    "@raycast/utils": "^2.2.2"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.1.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.7.4",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "ray publish"
  },
  "platforms": [
    "macOS"
  ]
}
