{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "bring-your-own-translator",
  "title": "BYOK Translator",
  "description": "Translate with your own provider, endpoint, API key and prompt.",
  "icon": "byok-logo.png",
  "author": "damien_wong",
  "license": "MIT",
  "platforms": [
    "macOS"
  ],
  "categories": [
    "Productivity"
  ],
  "commands": [
    {
      "name": "translate",
      "title": "Translate Text",
      "description": "Translate text using your configured provider",
      "mode": "no-view"
    },
    {
      "name": "translation-view",
      "title": "Translation View",
      "description": "Translation result and manual input; use Translate Text for your hotkey",
      "mode": "view"
    },
    {
      "name": "edit-prompt",
      "title": "Edit System Prompt",
      "description": "View, edit and save the default translation prompt in a multiline editor",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "provider",
      "title": "Provider",
      "description": "API protocol used by your endpoint",
      "type": "dropdown",
      "required": true,
      "default": "openai",
      "data": [
        {
          "title": "OpenAI / OpenAI Compatible",
          "value": "openai"
        },
        {
          "title": "Anthropic / Anthropic Compatible",
          "value": "anthropic"
        }
      ]
    },
    {
      "name": "url",
      "title": "API URL",
      "description": "Full endpoint, including /chat/completions or /messages",
      "type": "textfield",
      "required": true,
      "default": "https://api.openai.com/v1/chat/completions"
    },
    {
      "name": "apiKey",
      "title": "API Key",
      "description": "API key for your endpoint; optional for local services",
      "type": "password",
      "required": false
    },
    {
      "name": "model",
      "title": "Model",
      "description": "Exact model ID supplied by your provider",
      "type": "textfield",
      "required": true
    },
    {
      "name": "target",
      "title": "Target Language",
      "description": "Default translation language",
      "type": "dropdown",
      "required": true,
      "default": "简体中文",
