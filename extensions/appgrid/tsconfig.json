{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Node 20 + Raycast",
  "compilerOptions": {
    "lib": ["es2023"],
    "module": "commonjs",
    "target": "es2023",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "noImplicitAny": false
  },
  "exclude": ["node_modules"],
  "include": ["src/**/*"]
}