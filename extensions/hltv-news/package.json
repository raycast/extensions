{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "hltv-news",
  "title": "HLTV News",
  "description": "Browse the latest Counter-Strike news from HLTV",
  "icon": "logo.png",
  "author": "jamie_rees",
  "categories": [
    "News",
    "Other"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "index",
      "title": "Browse HLTV News",
      "subtitle": "HLTV",
      "description": "View latest Counter-Strike news from HLTV RSS feed",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.86.2",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.11",
    "@types/node": "^20.8.10",
    "@types/react": "^18.3.3",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}
