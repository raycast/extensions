{
	"$schema": "https://www.raycast.com/schemas/extension.json",
	"name": "welk-lidwoord",
	"title": "Welk Lidwoord",
	"description": "Quickly find the correct article for a noun.",
	"icon": "icon.png",
	"author": "nerkarso",
	"platforms": [
		"Windows",
		"macOS"
	],
	"categories": [
		"Web"
	],
	"license": "MIT",
	"preferences": [
		{
			"name": "apiUrl",
			"title": "API URL",
			"description": "Base URL of the Welk Lidwoord API.",
			"type": "textfield",
			"default": "http://localhost:8806",
			"required": false
		}
	],
	"commands": [
		{
			"name": "lidwoord",
			"title": "Lidwoord",
			"subtitle": "De of het woord",
			"description": "Search for the correct article.",
			"mode": "view",
			"arguments": [
				{
					"name": "word",
					"placeholder": "word",
					"type": "text",
					"required": true
				}
			]
		},
		{
			"name": "history",
			"title": "Geschiedenis",
			"subtitle": "Lidwoord geschiedenis",
			"description": "View your searched articles.",
			"mode": "view"
		}
	],
	"tools": [],
	"dependencies": {
		"@hey-api/client-fetch": "^0.13.1",
		"@raycast/api": "^1.104.20",
		"@raycast/utils": "^2.2.7"
	},
	"devDependencies": {
		"@hey-api/openapi-ts": "^0.99.0",
		"@raycast/eslint-config": "^2.2.0",
		"@types/node": "22.19.17",
		"@types/react": "19.0.10",
		"eslint": "^10.5.0",
		"prettier": "^3.9.6",
		"typescript": "^6.0.3"
	},
	"scripts": {
		"build": "ray build",
		"dev": "ray develop",
		"fix-lint": "ray lint --fix",
		"lint": "ray lint",
		"generate:api": "openapi-ts",
		"publish": "npx @raycast/api@latest publish",
		"check": "biome lint && biome check --write && biome format --write"
	}
}
