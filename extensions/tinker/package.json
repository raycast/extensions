{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "tinker",
  "title": "Tinker",
  "description": "Control Tinker from Raycast.",
  "icon": "icon.png",
  "author": "jrl",
  "platforms": ["macOS"],
  "categories": ["Applications", "Design Tools", "Productivity"],
  "license": "MIT",
  "keywords": ["screen recording", "capture", "video", "designer", "animation"],
  "commands": [
    {
      "name": "record-area",
      "title": "Capture Area",
      "description": "Choose an area, then start recording it with Tinker.",
      "mode": "no-view",
      "keywords": ["capture", "select", "region"]
    },
    {
      "name": "record-last-area",
      "title": "Record Last Area",
      "description": "Start recording the most recently selected area with Tinker.",
      "mode": "no-view",
      "keywords": ["repeat", "again", "region"]
    },
    {
      "name": "copy-latest-recording",
      "title": "Copy Latest Recording",
      "description": "Copy the most recent Tinker recording to the clipboard.",
      "mode": "no-view",
      "keywords": ["clipboard", "recent", "video", "paste"]
    }
  ],
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "lint": "ray lint",
    "fix-lint": "ray lint --fix",
    "publish": "npx @raycast/api@latest publish"
  },
  "dependencies": {
    "@raycast/api": "^1.104.19"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.1.1",
    "@types/node": "22.19.17",
    "@types/react": "19.0.10",
    "eslint": "^9.36.0",
    "prettier": "^3.8.4",
    "typescript": "^5.9.3"
  }
}
