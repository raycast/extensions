{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "downdetector",
  "title": "Downdetector",
  "description": "Instantly check if any service is down, see 24h report charts, and report problems — powered by Downdetector.",
  "icon": "extension-icon.png",
  "author": "camille_maurel",
  "categories": [
    "Web",
    "Developer Tools"
  ],
  "license": "MIT",
  "version": "1.0.0",
  "keywords": [
    "downdetector",
    "status",
    "outage",
    "uptime",
    "monitoring",
    "incident"
  ],
  "commands": [
    {
      "name": "search-service",
      "title": "Check Service Status",
      "subtitle": "Downdetector",
      "description": "Search for any service and check its current status, view the 24h report chart, or submit a problem report.",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "locale",
      "title": "Region",
      "description": "Downdetector region to query",
      "type": "dropdown",
      "required": false,
      "default": "com",
      "data": [
        {
          "title": "Global (downdetector.com)",
          "value": "com"
        },
        {
          "title": "France (downdetector.fr)",
          "value": "fr"
        },
        {
          "title": "UK (downdetector.co.uk)",
          "value": "co.uk"
        },
        {
          "title": "Germany (downdetector.de)",
          "value": "de"
        },
        {
          "title": "Spain (downdetector.es)",
          "value": "es"
        }
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.23",
    "@raycast/utils": "^2.2.7"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  },
  "screenshots": [
    {
      "title": "Search",
      "path": "metadata/search.png"
    },
    {
      "title": "Status Detail",
      "path": "metadata/detail.png"
    }
  ],
  "platforms": [
    "macOS",
    "Windows"
  ]
}
