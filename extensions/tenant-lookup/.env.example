# Copy this file to `.env` and fill in the values, then run:
#   ./scripts/dump-tenants.sh              # Mongo -> tenants.json
#   ./scripts/upload-tenants.sh tenants.json   # tenants.json -> S3
#
# `.env` is git-ignored — NEVER commit real credentials.
# In the shell, the scripts source this automatically; values with special
# characters (?, &, @) are fine because everything is quoted below.
#
# Precedence: inline/environment values > .env > script defaults. A one-off
#   MONGO_URI='…' DB='…' ./scripts/dump-tenants.sh
# always wins over what's in this file.

# ── Required: MongoDB source (used by dump-tenants.sh) ────────────────────────

# Full connection string. Two common shapes:
#   Atlas:      mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&authSource=admin
#   DocumentDB: mongodb://<user>:<password>@<host>:27017/?tls=true&replicaSet=rs0&retryWrites=false
# Prefer a READ-ONLY user — the dump only needs `find` on the customers collection.
# URL-encode special chars in the password (@ -> %40, : -> %3A, / -> %2F).
MONGO_URI="mongodb+srv://tenant_ro:REPLACE_ME@your-cluster.abcde.mongodb.net/?retryWrites=true&authSource=admin"

# Database that contains the `customers` collection.
DB="REPLACE_ME"

# Collection to read (default: customers). Uncomment only to override.
# COLL="customers"

# ── Optional: S3 destination (used by upload-tenants.sh) ──────────────────────
# Defaults are already correct for the shared copy; override only if needed.
# BUCKET="orion-internal-tenant-lookup"
# KEY="tenants.json"
# PROFILE="prod-admin"
