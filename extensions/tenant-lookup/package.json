{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "tenant-lookup",
  "title": "Tenant Lookup",
  "description": "Convert Orion tenant UUID <-> name from a private S3 file or a local JSON file.",
  "icon": "extension-icon.png",
  "author": "netayg",
  "categories": ["Developer Tools"],
  "platforms": ["macOS", "Windows"],
  "license": "MIT",
  "commands": [
    {
      "name": "tenant-lookup",
      "title": "Tenant Lookup",
      "subtitle": "UUID <-> Name",
      "description": "Search tenants by name or UUID and copy the other value.",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "source",
      "title": "Data Source",
      "description": "Where to read tenants.json from.",
      "type": "dropdown",
      "required": false,
      "default": "auto",
      "data": [
        { "title": "Local file, fall back to S3", "value": "auto" },
        { "title": "Local file only", "value": "local" },
        { "title": "S3 only", "value": "s3" }
      ]
    },
    {
      "name": "localPath",
      "title": "Local File Path",
      "description": "Path to tenants.json on disk (used for Local / Auto).",
      "type": "textfield",
      "required": false,
      "placeholder": "~/tenants.json"
    },
    {
      "name": "bucket",
      "title": "S3 Bucket",
      "description": "Bucket holding tenants.json.",
      "type": "textfield",
      "required": false,
      "default": "orion-internal-tenant-lookup"
    },
    {
      "name": "key",
      "title": "S3 Key",
      "description": "Object key of the JSON file.",
      "type": "textfield",
      "required": false,
      "default": "tenants.json"
    },
    {
      "name": "region",
      "title": "AWS Region",
      "description": "Region of the S3 bucket.",
      "type": "textfield",
      "required": false,
      "default": "us-east-1"
    },
    {
      "name": "profile",
      "title": "AWS Profile",
      "description": "AWS profile / SSO profile to authenticate with.",
      "type": "textfield",
      "required": false,
      "default": "prod-readonly"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.99.0",
    "@raycast/utils": "^1.19.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/credential-providers": "^3.700.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.4",
    "@types/node": "^22.19.17",
    "@types/react": "19.0.10",
    "eslint": "^9.0.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "lint": "ray lint",
    "fix-lint": "ray lint --fix"
  }
}
