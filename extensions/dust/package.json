{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "dust",
  "title": "Dust",
  "description": "Query dust.tt AI agents",
  "icon": "dust.png",
  "author": "albandum",
  "contributors": [
    "vineus",
    "henry_fontanier",
    "stang",
    "sebastien_flory",
    "adrien_simon",
    "ikupenov"
  ],
  "categories": [
    "Productivity"
  ],
  "license": "MIT",
  "preferences": [],
  "commands": [
    {
      "name": "ask",
      "title": "Ask Dust",
      "description": "Query @Dust on dust.tt",
      "mode": "view",
      "arguments": [
        {
          "name": "search",
          "placeholder": "Ask a question",
          "type": "text",
          "required": false
        }
      ]
    },
    {
      "name": "askClaude",
      "title": "Ask Claude-4",
      "description": "Query @claude-4 on Dust.tt",
      "mode": "view",
      "arguments": [
        {
          "name": "search",
          "placeholder": "Ask a question",
          "type": "text",
          "required": false
        }
      ]
    },
    {
      "name": "askGpt",
      "title": "Ask GPT-5",
      "description": "Query @gpt-5 on Dust.tt",
      "mode": "view",
      "arguments": [
        {
          "name": "search",
          "placeholder": "Ask a question",
          "type": "text",
          "required": false
        }
      ]
    },
    {
      "name": "history",
      "title": "Questions History",
      "subtitle": "Show the questions and answers of the last 30 days",
      "description": "Show the questions and answers of the last 30 days",
      "mode": "view"
    },
    {
      "name": "askAgent",
      "title": "Ask ...",
      "subtitle": "Select one of your assistants to ask a question",
      "description": "Select one of your assistants to ask a question",
      "mode": "view"
    },
    {
      "name": "pickWorkspace",
      "title": "Select Workspace",
      "subtitle": "Select a workspace to use",
      "description": "Select a workspace to use",
      "mode": "view"
    }
  ],
  "tools": [
    {
      "name": "ask-dust",
      "title": "Ask Dust",
      "description": "Ask Dust assistants a question in your selected workspace",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "The user's question to ask Dust."
          },
          "agent": {
            "type": "string",
            "enum": [
              "dust",
              "gpt-5",
              "claude-4-sonnet"
            ],
            "description": "Optional target assistant."
          }
        },
        "required": [
          "query"
        ]
      }
    }
  ],
  "ai": {
    "instructions": "When this extension is tagged, always call the ask-dust tool for any user request that asks a question, requests an answer, summary, explanation, draft, or analysis using Dust. Do not answer from your own knowledge when ask-dust is available. Pass the full user prompt in the required `query` parameter. Set `agent` only when the user explicitly asks for GPT-5 or Claude 4; otherwise use the default Dust agent.",
    "evals": [
      {
        "input": "Use Dust to answer this: summarize the main risks in this launch plan.",
        "callsTool": "ask-dust"
      },
      {
        "input": "Ask Claude 4 in Dust: draft a concise status update from these notes.",
        "callsTool": "ask-dust"
      },
      {
        "input": "Ask GPT-5 in Dust: propose 3 alternatives and tradeoffs.",
        "callsTool": "ask-dust"
      }
    ]
  },
  "dependencies": {
    "@dust-tt/client": "^1.1.16",
    "@emoji-mart/data": "^1.1.2",
    "@raycast/api": "^1.70.3",
    "@raycast/utils": "^1.18.0",
    "date-fns": "^3.0.0-alpha.2",
    "eventsource-parser": "^1.1.1",
    "jwt-decode": "^4.0.0",
    "undici": "^6.20.1"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.6",
    "@types/node": "22.14.0",
    "@types/react": "19.0.10",
    "eslint": "^8.51.0",
    "prettier": "^3.0.3",
    "typescript": "^5.2.2"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  },
  "platforms": [
    "macOS"
  ]
}
