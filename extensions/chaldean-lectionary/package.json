{
  "name": "chaldean-lectionary",
  "title": "Chaldean Lectionary",
  "description": "Daily readings for the Chaldean Catholic Church",
  "icon": "icon.png",
  "author": "peter_patros",
  "platforms": [
    "macOS"
  ],
  "categories": [
    "Other"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "today",
      "title": "Today's Readings",
      "description": "View the readings for today",
      "mode": "view"
    },
    {
      "name": "lookup",
      "title": "Look up Readings",
      "description": "View readings for any day",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "calendarId",
      "title": "Google Calendar ID",
      "description": "The ID of your liturgical calendar",
      "type": "textfield",
      "required": true
    },
    {
      "name": "googleApiKey",
      "title": "Google API Key",
      "description": "Your Google API key for calendar access",
      "type": "password",
      "required": true
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.12"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.1.1",
    "typescript": "^6.0.2"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "lint": "ray lint",
    "fix-lint": "ray lint --fix",
    "publish": "npx @raycast/api@latest publish"
  }
}
