{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "google-finance",
  "title": "Google Finance",
  "description": "Track stock prices powered by Google Finance",
  "icon": "extension-icon.png",
  "author": "kyle_samani",
  "categories": ["Finance"],
  "license": "MIT",
  "commands": [
    {
      "name": "index",
      "title": "View Stocks",
      "description": "Look up stocks by symbol",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.47.3",
    "cross-fetch": "^3.1.5"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@raycast/eslint-config": "^1.0.5",
    "@types/node": "^20.0.0"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "ray publish"
  }
}