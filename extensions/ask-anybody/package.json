{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "ask-anybody",
  "title": "Ask Anybody",
  "description": "Open a new chat in your favorite AI assistant with a query",
  "icon": "command-icon.png",
  "author": "korchasa",
  "license": "MIT",
  "categories": [
    "Productivity"
  ],
  "commands": [
    {
      "name": "ask-chatgpt",
      "title": "Ask ChatGPT",
      "icon": "chatgpt-icon.png",
      "description": "Open a new ChatGPT chat in browser",
      "mode": "no-view",
      "arguments": [
        {
          "name": "query",
          "placeholder": "Ask ChatGPT...",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "name": "ask-claude",
      "title": "Ask Claude",
      "icon": "claude-icon.png",
      "description": "Open a new Claude chat in browser",
      "mode": "no-view",
      "arguments": [
        {
          "name": "query",
          "placeholder": "Ask Claude...",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "name": "ask-claude-desktop",
      "title": "Ask Claude (Desktop)",
      "icon": "claude-icon.png",
      "description": "Open a new Claude chat in the desktop app",
      "mode": "no-view",
      "arguments": [
        {
          "name": "query",
          "placeholder": "Ask Claude...",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "name": "ask-gemini",
      "title": "Ask Gemini",
      "icon": "gemini-icon.png",
      "description": "Open a new Gemini chat in browser",
      "mode": "no-view",
      "arguments": [
        {
          "name": "query",
          "placeholder": "Ask Gemini...",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "name": "ask-grok",
      "title": "Ask Grok",
      "icon": "grok-icon.png",
      "description": "Open a new Grok chat in browser",
      "mode": "no-view",
      "arguments": [
        {
          "name": "query",
          "placeholder": "Ask Grok...",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "name": "ask-mistral",
      "title": "Ask Mistral",
      "icon": "mistral-icon.png",
      "description": "Open a new Mistral chat in browser",
      "mode": "no-view",
      "arguments": [
        {
          "name": "query",
          "placeholder": "Ask Mistral...",
          "type": "text",
          "required": true
        }
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "1.104.11"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.1.1",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "eslint": "^9.39.4",
    "prettier": "^3.8.1",
    "typescript": "5.8.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "lint": "ray lint",
    "fix-lint": "ray lint --fix",
    "publish": "npx @raycast/api@latest publish"
  }
}
