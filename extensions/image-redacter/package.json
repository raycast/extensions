{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "image-redacter",
  "title": "Cloakshot",
  "description": "Redact sensitive text and regions in images and PDFs without changing the original",
  "icon": "icon.png",
  "author": "byronrode",
  "platforms": [
    "macOS",
    "Windows"
  ],
  "categories": [
    "Design Tools",
    "Security"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "redact-image",
      "title": "Redact Image or PDF",
      "description": "Redact a selected image or PDF in a private canvas editor",
      "mode": "view"
    },
    {
      "name": "manage-license",
      "title": "Manage License",
      "description": "View your Cloakshot plan, upgrade to Pro, or enter a license key",
      "mode": "view"
    }
  ],
  "scripts": {
    "build": "ray build -e dist -o dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "vendor": "node scripts/vendor.mjs"
  },
  "dependencies": {
    "@raycast/api": "^2.0.5",
    "@raycast/utils": "^2.3.0",
    "pdf-lib": "^1.17.1",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.0.9",
    "@raycast/eslint-config": "^2.2.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@types/node": "^24.3.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.1.11",
    "eslint": "^9.34.0",
    "pdfjs-dist": "^6.3.289",
    "prettier": "^3.6.2",
    "react": "^19.1.1",
    "tesseract.js": "5.1.1",
    "tesseract.js-core": "5.1.1",
    "tsx": "^4.20.5",
    "typescript": "^6.0.3"
  }
}
