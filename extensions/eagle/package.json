{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "eagle",
  "title": "Eagle",
  "description": "Eagle Extension for Raycast",
  "icon": "command-icon.png",
  "author": "Yukai",
  "categories": [
    "Productivity"
  ],
  "license": "MIT",
  "preferences": [
    {
      "name": "layout",
      "type": "dropdown",
      "required": false,
      "title": "Layout",
      "description": "Choose between list view and grid view",
      "default": "list",
      "data": [
        {
          "value": "list",
          "title": "List"
        },
        {
          "value": "grid",
          "title": "Grid"
        }
      ]
    }
  ],
  "commands": [
    {
      "name": "index",
      "title": "Search Item",
      "subtitle": "Eagle",
      "description": "Search Item from Library",
      "mode": "view"
    },
    {
      "name": "folder",
      "title": "Navigate Folder",
      "subtitle": "Eagle",
      "description": "Navigate Folder",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.103.0",
    "@raycast/utils": "^2.2.2",
    "axios": "^0.26.1",
    "file-url": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.2.2",
    "eslint": "^7.32.0",
    "prettier": "^2.5.1",
    "react": "^19.2.0",
    "typescript": "^4.4.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint"
  },
  "platforms": [
    "macOS"
  ]
}
