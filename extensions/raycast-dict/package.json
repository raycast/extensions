{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "raycast-dict",
  "title": "Dictionary",
  "description": "Look up word definitions using macOS system dictionaries",
  "icon": "extension-icon.png",
  "author": "fenelon",
  "categories": ["Productivity"],
  "license": "MIT",
  "commands": [
    {
      "name": "index",
      "title": "Define",
      "description": "Search for word definitions in system dictionaries",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.37.0",
    "@raycast/utils": "^1.17.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.4",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "dev": "ray develop",
    "lint": "ray lint",
    "fix-lint": "ray lint --fix",
    "build": "ray build",
    "build-swift": "swiftc -O -o assets/dict-helper swift/DictHelper.swift",
    "prebuild": "npm run build-swift",
    "predev": "npm run build-swift"
  }
}
